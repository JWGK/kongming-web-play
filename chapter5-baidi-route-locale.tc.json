control","value":1},{"kind":"text","text":"和"},{"kind":"control","value":2},{"kind":"text","text":"顧雍"},{"kind":"control","value":1},{"kind":"text","text":"……"}],"「陛下、\n　お叱りを承知の上で\n　申し上げます":[{"kind":"text","text":"「陛下，\n　即使會受到責罰，\n　臣也必須進言。"}],"「どうか蜀と戦うのは\n　お止め下さい":[{"kind":"text","text":"「請陛下\n　停止與蜀國交戰。"}],"「諸葛瑾殿の言われる\n　通りです\n　":[{"kind":"text","text":"「正如"},{"kind":"control","value":2},{"kind":"text","text":"諸葛瑾"},{"kind":"control","value":1},{"kind":"text","text":"大人\n　所言。"}],"「呉と蜀が争っては、\n　夷陵の戦いの二の舞\n　でございます":[{"kind":"control","value":1},{"kind":"text","text":"「吳蜀相爭，\n　只會重蹈\n　"},{"kind":"control","value":3},{"kind":"text","text":"夷陵"},{"kind":"control","value":1},{"kind":"text","text":"之戰的覆轍。"}],"「まして、\n　今回もまた呉が勝つ\n　という保証は":[{"kind":"text","text":"「更何況，\n　這一次吳軍\n　仍能取勝……"}],"「どこにも\n　ありませぬ\n　":[{"kind":"text","text":"「根本無人\n　能夠保證。"}],"「ここは、蜀と\n　いま一度和睦を\n　図りましょう":[{"kind":"text","text":"「此時應當\n　再與蜀國\n　謀求和睦。"}],"「諸葛瑾、歩、顧雍\n　そなたらの気持ちは\n　痛いほど分かる":[{"kind":"text","text":"「"},{"kind":"control","value":2},{"kind":"text","text":"諸葛瑾"},{"kind":"control","value":1},{"kind":"text","text":"、"},{"kind":"control","value":2},{"kind":"text","text":"步騭"},{"kind":"control","value":1},{"kind":"text","text":"、"},{"kind":"control","value":2},{"kind":"text","text":"顧雍"},{"kind":"control","value":1},{"kind":"text","text":"，\n　朕何嘗不明白\n　你們的心意。"}],"「しかし、\n　もう戦いを止める\n　ことはできぬ":[{"kind":"control","value":1},{"kind":"text","text":"「然而，\n　戰事已經\n　無法停止了。"}],"「陛下……":[{"kind":"text","text":"「陛下……"}],"「諸葛瑾、\n　そなたも出陣の\n　準備をいたせ":[{"kind":"text","text":"「"},{"kind":"control","value":2},{"kind":"text","text":"諸葛瑾"},{"kind":"control","value":1},{"kind":"text","text":"，\n　你也去\n　準備出征吧。"}],"「……はい\n　陛下のご命令と\n　あらば……":[{"kind":"text","text":"「……是。\n　既然是\n　陛下的命令……"}],"「父上\n　私も江陵に\n　お連れ下さい":[{"kind":"text","text":"「父親，\n　請帶我一起\n　前往"},{"kind":"control","value":3},{"kind":"text","text":"江陵"},{"kind":"control","value":1},{"kind":"text","text":"。"}],"「むっ？":[{"kind":"text","text":"「嗯？"}],"「我が従弟諸葛瞻が\n　蜀軍で活躍している\n　と聞いて