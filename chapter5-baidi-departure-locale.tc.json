1:2:1":[{"kind":"text","text":"「我認為從南面進攻\n　較為妥當。"}],"5:1:12241:3:0":[{"kind":"text","text":"「不過，城內也可能\n　陷入混戰。因此，"}],"5:1:12241:3:1":[{"kind":"text","text":"「從南北兩面進攻，\n　也不失為良策。"}],"5:1:12241:4:0":[{"kind":"text","text":"「那麼，\n　等您決定作戰方針後，"}],"5:1:12241:4:1":[{"kind":"text","text":"「請告訴我。"}],"5:1:12706:0:0":[{"kind":"control","value":2},{"kind":"control","value":1},{"kind":"text","text":"「瞻，你有何看法？"}],"5:1:12706:1:0":[{"kind":"text","text":"「分兵兩路，\n　需要時間準備。"}],"5:1:12706:1:1":[{"kind":"text","text":"「據報吳國援軍\n　將從"},{"kind":"control","value":3},{"kind":"text","text":"江陵"},{"kind":"control","value":1},{"kind":"text","text":"趕來。"}],"5:1:12706:1:2":[{"kind":"control","value":1},{"kind":"text","text":"「趁吳國援軍\n　尚未抵達之前，"}],"5:1:12706:1:3":[{"kind":"control","value":1},{"kind":"text","text":"「全軍從南面進攻，\n　應該較為妥當。"}],"5:1:12863:0:0":[{"kind":"text","text":"「我認為分兵南北\n　兩路進攻較好。"}],"5:1:12907:0:0":[{"kind":"text","text":"「若只從一面進攻，\n　可能會被敵軍阻擋，"}],"5:1:12907:0:1":[{"kind":"text","text":"「陷入進退兩難\n　的境地。"}],"5:1:12907:0:2":[{"kind":"text","text":"「還是分兵兩路\n　較好吧。"}],"5:1:12992:0:0":[{"kind":"text","text":"「丞相，\n　作戰方針決定了嗎？"}],"5:1:13068:0:0":[{"kind":"text","text":"「明白了。\n　分兵南北兩路進攻。"}],"5:1:13068:1:0":[{"kind":"text","text":"「嗯，\n　對手可是"},{"kind":"control","value":2},{"kind":"text","text":"陸遜"},{"kind":"control","value":1},{"kind":"text","text":"。"}],"5:1:13068:1:1":[{"kind":"control","value":1},{"kind":"text","text":"「不可大意。\n　那麼，出陣！"}],"5:1:13161:0:0":[{"kind":"text","text":"「明白了。\n　全軍從南面進攻。"}],"5:1:13161:1:0":[{"kind":"text","text":"「嗯，\n　對手可是"},{"kind":"control","value":2},{"kind":"text","text":"陸遜"},{"kind":"control","value":1},{"kind":"text","text":"。"}],"5:1:13161:1:1":[{"kind":"control","value":1},{"kind":"text","text":"「不可大意。\n　那麼，出陣！"}],"5:1:13250:0:0":[{"kind":"text","text":"「全軍向"},{"kind":"control","value":3},{"kind":"text","text":"白帝城"},{"kind":"control","value":1},{"kind":"text","text":"進軍！"}],"5:1:13250:0:1":[{"kind":"control","value":1},{"kind":"text","text":"「奪回先帝駕崩之地！"}],"5:1:13308:0:0":[{"kind":"text","text":"「全軍向"},{"kind":"control","value":3},{"kind":"text","text":"白帝城"},{"kind":"control","value":1},{"kind":"text","text":"進軍！"}]},"bySystemId":{"5:1:11072":"巴西","5:1:11077":"前往巴西議事廳","5:1:11093":"巴西　議事廳","5:1:12663":"姜維","5:1:12668":"選擇分兵南北夾攻，或全軍從南面進攻","5:1:13028":"①分兵南北兩路進攻\n②全軍從南面進攻"},"characterNames":{"0":"孔明","4":"姜維","17":"諸葛瞻","44":"趙統","45":"趙廣","149":"孫權","182":"孟獲","188":"祝融"},"system":{"yes":"是","no":"否","manual":"要記錄進度嗎？","readiness":"作戰方針決定了嗎？","saveUnavailable":"尚未接上原作記錄銀行。","preparationHeld":"已按原作出征，白帝城戰鬥尚未開放。"},"bySource":{"「この戦、\n　呉の命運が\n　かかっている！":"「這一戰，\n　關乎吳國的命運！","「負けるわけには\n　いかぬのだ！":"「絕不能輸！","「父上ッ！":"「父親！","「瞻……。よく、\n　私が来るまで巴西を\n　守りきったな":"「瞻……你竟能守住巴西，\n　直到我趕來。","「漢の丞相として、\n　父として…これほど\n　嬉しいことはない":"「身為漢朝丞相，\n　也身為你的父親，\n　沒有比這更欣慰的事了。","「ありがとう\n　ございます\n　":"「謝謝父親。","「しかし、\n　私一人では\n　":"「但是，\n　只靠我一個人……","「巴西を守りきること\n　はできなかった\n　でしょう":"「恐怕無法\n　守住巴西。","「ここにいる\n　趙統殿と趙広殿が\n　いたからこそ、":"「正因有在場的\n　趙統與趙廣相助，","「巴西を\n　守り切ることが\n　できたのです":"「才能守住巴西。","「そうだな\n　趙統、趙広\n　":"「說得對。\n　趙統、趙廣。","「そなたらも偉大な\n　趙雲殿の名に恥じぬ\n　戦いであった":"「你們的奮戰，\n　也無愧於偉大的\n　趙雲將軍之名。","「見事だったぞ":"「做得很好！","「はっ。丞相に\n　そう言って\n　いただけると":"「是！能得到丞相\n　這樣的讚許，","「我らも嬉しゅう\n　ございます":"「我們也十分高興。","「父の名を\n　汚さぬように精一杯\n　戦っただけです":"「我們只是盡力奮戰，\n　不願辱沒父親之名。","「丞相ーっ！\n　お久しぶりで\n　ございます！":"「丞相！\n　好久不見了！","「またお会いできて\n　この孟獲、\n　":"「能再次與您相見，\n　我孟獲……","「大変嬉しゅう\n　ございます！":"「實在太高興了！","「……私も嬉しいぞ\n　\n　":"「……我也很高興。","「この漢朝危急のとき\n　によく駆けつけてく\n　れた":"「漢朝危急之際，\n　多虧你們及時趕來。","「孟獲よ、\n　礼を言うぞ":"「孟獲，\n　多謝你了。","「い、いえ。礼など\n　めっそうもない\n　":"「不、不敢。\n　您言重了！","「孔明様のためなら\n　これしきのこと！":"「為了孔明大人，\n　這點小事算甚麼！","「そうですわ。私たち\n　南蛮の者は……\n　南蛮の恩人である":"「正是如此。\n　我們南蠻人……","「孔明様の少しでも\n　お役に立ちたいと\n　思っているのです":"「都想為南蠻的恩人\n　孔明大人，\n　盡一分心力。","「そうか、\n　ありがとう\n　ご苦労だった":"「是嗎，謝謝你們。\n　辛苦了。","「ゆっくり\n　休んでくれ":"「好好休息吧。","「はい！\n　では、\n　失礼いたします！":"「是！\n　那麼，我們告退了！","「丞相、\n　呉軍は白帝城に\n　退却しました":"「丞相，\n　吳軍已退往白帝城。","「……白帝城か\n　白帝城と\n　いえば……":"「……白帝城嗎。\n　說到白帝城……","「そうです。かの地は\n　先帝終焉の地\n　":"「是的。\n　那裡是先帝駕崩之地。","「必ず取り返さねば\n　なりません":"「我們必須奪回來。","「……白帝城か":"「……白帝城嗎。","「かの地は\n　荊州と益州の境に\n　位置する要害の地":"「那裡位於荊州與益州\n　交界，是險要之地。","「うむ、\n　その通りだ\n　":"「嗯，正是如此。","「呉の援軍が到着する\n　前に白帝城を奪い返\n　すことにする":"「趁吳國援軍抵達之前，\n　奪回白帝城。","「私が思いますに、\n　陸遜は前回の\n　敗戦もあり":"「依我之見，\n　陸遜上次吃了敗仗，","「城外には出てこない\n　でしょう\n　":"「應該不會出城迎戰。","「城内で我らを\n　待ち受けていると\n　思われます":"「想必會在城內\n　等候我軍。","「白帝城は、城の南北\n　から攻めることがで\n　きます":"「白帝城可以從\n　南北兩面進攻。","「……いかが\n　いたしますか？":"「……您意下如何？","「南北二手に分かれて\n　攻めるか\n　":"「是分兵南北夾攻，","「それとも、\n　どちらか一方から\n　攻めるか……":"「還是集中兵力，\n　從一面進攻呢……","「全軍で攻めるのでし\n　たら、万が一の撤退\n　時のことも考えて":"「若全軍一同進攻，\n　也須考慮萬一撤退時\n　的情況。","「南から攻める\n　のがよいかと":"「我認為從南面進攻\n　較為妥當。","「ただ、城内では\n　乱戦になる可能性も\n　あります。それゆえ":"「不過，城內也可能\n　陷入混戰。因此，","「南北から攻めこむと\n　いうのも悪い策では\n　ないと思いますが":"「從南北兩面進攻，\n　也不失為良策。","「では、作戦が\n　お決まりに\n　なりましたら":"「那麼，\n　等您決定作戰方針後，","「私にお告げ下さい":"「請告訴我。","「瞻、どう思うか？":"「瞻，你有何看法？","「二手に分かれるには\n　準備に時間がかかり\n　ます":"「分兵兩路，\n　需要時間準備。","「江陵から呉の援軍が\n　来るという情報もあ\n　ります":"「據報吳國援軍\n　將從江陵趕來。","「呉の援軍が\n　来ないうちに\n　":"「趁吳國援軍\n　尚未抵達之前，","「南側から\n　全軍で攻めるのが\n　よいでしょう":"「全軍從南面進攻，\n　應該較為妥當。","「私は、南北二手に分\n　かれた方がよろしい\n　と存じます":"「我認為分兵南北\n　兩路進攻較好。","「一方からだけだと、\n　敵部隊にはばまれて\n　":"「若只從一面進攻，\n　可能會被敵軍阻擋，","「立ち往生するやも\n　しれませぬ\n　":"「陷入進退兩難\n　的境地。","「二手に分かれた方が\n　よいのでは":"「還是分兵兩路\n　較好吧。","「丞相、作戦は\n　お決まりに\n　なりましたか？":"「丞相，\n　作戰方針決定了嗎？","「わかりました\n　南北二手に分かれて\n　攻めるのですね":"「明白了。\n　分兵南北兩路進攻。","「うむ\n　相手は陸遜だ\n　":"「嗯，\n　對手可是陸遜。","「油断せぬように\n　では、出陣する！":"「不可大意。\n　那麼，出陣！","「わかりました\n　全軍南側から攻める\n　のですね":"「明白了。\n　全軍從南面進攻。","「全軍、\n　白帝城に進軍\n　":"「全軍向白帝城進軍！","「先帝終焉の地を\n　取り返せ！":"「奪回先帝駕崩之地！","「全軍、\n　白帝城に進軍！":"「全軍向白帝城進軍！","巴西":"巴西","巴西の会議場に行く":"前往巴西議事廳","巴西　会議場":"巴西　議事廳","姜維":"姜維","南北に分かれて攻めるか、\r\n全軍南から攻めるか選択する":"選擇分兵南北夾攻，或全軍從南面進攻","①南北二手に分かれて攻める\r\n②全軍で南側から攻める":"①分兵南北兩路進攻\n②全軍從南面進攻"},"bySourceRuns":{"「この戦、\n　呉の命運が\n　かかっている！":[{"kind":"text","text":"「這一戰，\n　關乎吳國的命運！"}],"「負けるわけには\n　いかぬのだ！":[{"kind":"text","text":"「絕不能輸！"}],"「父上ッ！":[{"kind":"text","text":"「父親！"}],"「瞻……。よく、\n　私が来るまで巴西を\n　守りきったな":[{"kind":"control","value":2},{"kind":"control","value":1},{"kind":"text","text":"「瞻……你竟能守住"},{"kind":"control","value":3},{"kind":"text","text":"巴西"},{"kind":"control","value":1},{"kind":"text","text":"，\n　直到我趕來。"}],"「漢の丞相として、\n　父として…これほど\n　嬉しいことはない":[{"kind":"control","value":1},{"kind":"text","text":"「身為漢朝丞相，\n　也身為你的父親，\n　沒有比這更欣慰的事了。"}],"「ありがとう\n　ございます\n　":[{"kind":"text","text":"「謝謝父親。"}],"「しかし、\n　私一人では\n　":[{"kind":"text","text":"「但是，\n　只靠我一個人……"}],"「巴西を守りきること\n　はできなかった\n　でしょう":[{"kind":"text","text":"「恐怕無法\n　守住"},{"kind":"control","value":3},{"kind":"text","text":"巴西"},{"kind":"control","value":1},{"kind":"text","text":"。"}],"「ここにいる\n　趙統殿と趙広殿が\n　いたからこそ、":[{"kind":"control","value":1},{"kind":"text","text":"「正因有在場的\n　"},{"kind":"control","value":2},{"kind":"text","text":"趙統"},{"kind":"control","value":1},{"kind":"text","text":"與"},{"kind":"control","value":2},{"kind":"text","text":"趙廣"},{"kind":"control","value":1},{"kind":"text","text":"相助，"}],"「巴西を\n　守り切ることが\n　できたのです":[{"kind":"control","value":1},{"kind":"text","text":"「才能守住"},{"kind":"control","value":3},{"kind":"text","text":"巴西"},{"kind":"control","value":1},{"kind":"text","text":"。"}],"「そうだな\n　趙統、趙広\n　":[{"kind":"text","text":"「說得對。\n　"},{"kind":"control","value":2},{"kind":"text","text":"趙統"},{"kind":"control","value":1},{"kind":"text","text":"、"},{"kind":"control","value":2},{"kind":"text","text":"趙廣"},{"kind":"control","value":1},{"kind":"text","text":"。"}],"「そなたらも偉大な\n　趙雲殿の名に恥じぬ\n　戦いであった":[{"kind":"control","value":1},{"kind":"text","text":"「你們的奮戰，\n　也無愧於偉大的\n　"},{"kind":"control","value":2},{"kind":"text","text":"趙雲"},{"kind":"control","value":1},{"kind":"text","text":"將軍之名。"}],"「見事だったぞ":[{"kind":"control","value":1},{"kind":"text","text":"「做得很好！"}],"「はっ。丞相に\n　そう言って\n　いただけると":[{"kind":"text","text":"「是！能得到丞相\n　這樣的讚許，"}],"「我らも嬉しゅう\n　ございます":[{"kind":"text","text":"「我們也十分高興。"}],"「父の名を\n　汚さぬように精一杯\n　戦っただけです":[{"kind":"text","text":"「我們只是盡力奮戰，\n　不願辱沒父親之名。"}],"「丞相ーっ！\n　お久しぶりで\n　ございます！":[{"kind":"text","text":"「丞相！\n　好久不見了！"}],"「またお会いできて\n　この孟獲、\n　":[{"kind":"text","text":"「能再次與您相見，\n　我"},{"kind":"control","value":2},{"kind":"text","text":"孟獲"},{"kind":"control","value":1},{"kind":"text","text":"……"}],"「大変嬉しゅう\n　ございます！":[{"kind":"control","value":1},{"kind":"text","text":"「實在太高興了！"}],"「……私も嬉しいぞ\n　\n　":[{"kind":"text","text":"「……我也很高興。"}],"「この漢朝危急のとき\n　によく駆けつけてく\n　れた":[{"kind":"text","text":"「漢朝危急之際，\n　多虧你們及時趕來。"}],"「孟獲よ、\n　礼を言うぞ":[{"kind":"text","text":"「"},{"kind":"control","value":2},{"kind":"text","text":"孟獲"},{"kind":"control","value":1},{"kind":"text","text":"，\n　多謝你了。"}],"「い、いえ。礼など\n　めっそうもない\n　":[{"kind":"text","text":"「不、不敢。\n　您言重了！"}],"「孔明様のためなら\n　これしきのこと！":[{"kind":"text","text":"「為了"},{"kind":"control","value":2},{"kind":"text","text":"孔明"},{"kind":"control","value":1},{"kind":"text","text":"大人，\n　這點小事算甚麼！"}],"「そうですわ。私たち\n　南蛮の者は……\n　南蛮の恩人である":[{"kind":"control","value":3},{"kind":"control","value":1},{"kind":"control","value":3},{"kind":"control","value":1},{"kind":"text","text":"「正是如此。\n　我們南蠻人……"}],"「孔明様の少しでも\n　お役に立ちたいと\n　思っているのです":[{"kind":"control","value":1},{"kind":"text","text":"「都想為南蠻的恩人\n　"},{"kind":"control","value":2},{"kind":"text","text":"孔明"},{"kind":"control","value":1},{"kind":"text","text":"大人，\n　盡一分心力。"}],"「そうか、\n　ありがとう\n　ご苦労だった":[{"kind":"text","text":"「是嗎，謝謝你們。\n　辛苦了。"}],"「ゆっくり\n　休んでくれ":[{"kind":"text","text":"「好好休息吧。"}],"「はい！\n　では、\n　失礼いたします！":[{"kind":"text","text":"「是！\n　那麼，我們告退了！"}],"「丞相、\n　呉軍は白帝城に\n　退却しました":[{"kind":"text","text":"「丞相，\n　吳軍已退往"},{"kind":"control","value":3},{"kind":"text","text":"白帝城"},{"kind":"control","value":1},{"kind":"text","text":"。"}],"「……白帝城か\n　白帝城と\n　いえば……":[{"kind":"text","text":"「……"},{"kind":"control","value":3},{"kind":"text","text":"白帝城"},{"kind":"control","value":1},{"kind":"text","text":"嗎。\n　說到"},{"kind":"control","value":3},{"kind":"text","text":"白帝城"},{"kind":"control","value":1},{"kind":"text","text":"……"}],"「そうです。かの地は\n　先帝終焉の地\n　":[{"kind":"text","text":"「是的。\n　那裡是先帝駕崩之地。"}],"「必ず取り返さねば\n　なりません":[{"kind":"control","value":1},{"kind":"text","text":"「我們必須奪回來。"}],"「……白帝城か":[{"kind":"text","text":"「……"},{"kind":"control","value":3},{"kind":"text","text":"白帝城"},{"kind":"control","value":1},{"kind":"text","text":"嗎。"}],"「かの地は\n　荊州と益州の境に\n　位置する要害の地":[{"kind":"text","text":"「那裡位於"},{"kind":"control","value":3},{"kind":"text","text":"荊州"},{"kind":"control","value":1},{"kind":"text","text":"與"},{"kind":"control","value":3},{"kind":"text","text":"益州"},{"kind":"control","value":1},{"kind":"text","text":"\n　交界，是險要之地。"}],"「うむ、\n　その通りだ\n　":[{"kind":"text","text":"「嗯，正是如此。"}],"「呉の援軍が到着する\n　前に白帝城を奪い返\n　すことにする":[{"kind":"text","text":"「趁吳國援軍抵達之前，\n　奪回"},{"kind":"control","value":3},{"kind":"text","text":"白帝城"},{"kind":"control","value":1},{"kind":"text","text":"。"}],"「私が思いますに、\n　陸遜は前回の\n　敗戦もあり":[{"kind":"text","text":"「依我之見，\n　"},{"kind":"control","value":2},{"kind":"text","text":"陸遜"},{"kind":"control","value":1},{"kind":"text","text":"上次吃了敗仗，"}],"「城外には出てこない\n　でしょう\n　":[{"kind":"control","value":1},{"kind":"text","text":"「應該不會出城迎戰。"}],"「城内で我らを\n　待ち受けていると\n　思われます":[{"kind":"control","value":1},{"kind":"text","text":"「想必會在城內\n　等候我軍。"}],"「白帝城は、城の南北\n　から攻めることがで\n　きます":[{"kind":"control","value":1},{"kind":"text","text":"「"},{"kind":"control","value":3},{"kind":"text","text":"白帝城"},{"kind":"control","value":1},{"kind":"text","text":"可以從\n　南北兩面進攻。"}],"「……いかが\n　いたしますか？":[{"kind":"control","value":1},{"kind":"text","text":"「……您意下如何？"}],"「南北二手に分かれて\n　攻めるか\n　":[{"kind":"text","text":"「是分兵南北夾攻，"}],"「それとも、\n　どちらか一方から\n　攻めるか……":[{"kind":"text","text":"「還是集中兵力，\n　從一面進攻呢……"}],"「全軍で攻めるのでし\n　たら、万が一の撤退\n　時のことも考えて":[{"kind":"text","text":"「若全軍一同進攻，\n　也須考慮萬一撤退時\n　的情況。"}],"「南から攻める\n　のがよいかと":[{"kind":"text","text":"「我認為從南面進攻\n　較為妥當。"}],"「ただ、城内では\n　乱戦になる可能性も\n　あります。それゆえ":[{"kind":"text","text":"「不過，城內也可能\n　陷入混戰。因此，"}],"「南北から攻めこむと\n　いうのも悪い策では\n　ないと思いますが":[{"kind":"text","text":"「從南北兩面進攻，\n　也不失為良策。"}],"「では、作戦が\n　お決まりに\n　なりましたら":[{"kind":"text","text":"「那麼，\n　等您決定作戰方針後，"}],"「私にお告げ下さい":[{"kind":"text","text":"「請告訴我。"}],"「瞻、どう思うか？":[{"kind":"control","value":2},{"kind":"control","value":1},{"kind":"text","text":"「瞻，你有何看法？"}],"「二手に分かれるには\n　準備に時間がかかり\n　ます":[{"kind":"text","text":"「分兵兩路，\n　需要時間準備。"}],"「江陵から呉の援軍が\n　来るという情報もあ\n　ります":[{"kind":"text","text":"「據報吳國援軍\n　將從"},{"kind":"control","value":3},{"kind":"text","text":"江陵"},{"kind":"control","value":1},{"kind":"text","text":"趕來。"}],"「呉の援軍が\n　来ないうちに\n　":[{"kind":"control","value":1},{"kind":"text","text":"「趁吳國援軍\n　尚未抵達之前，"}],"「南側から\n　全軍で攻めるのが\n　よいでしょう":[{"kind":"control","value":1},{"kind":"text","text":"「全軍從南面進攻，\n　應該較為妥當。"}],"「私は、南北二手に分\n　かれた方がよろしい\n　と存じます":[{"kind":"text","text":"「我認為分兵南北\n　兩路進攻較好。"}],"「一方からだけだと、\n　敵部隊にはばまれて\n　":[{"kind":"text","text":"「若只從一面進攻，\n　可能會被敵軍阻擋，"}],"「立ち往生するやも\n　しれませぬ\n　":[{"kind":"text","text":"「陷入進退兩難\n　的境地。"}],"「二手に分かれた方が\n　よいのでは":[{"kind":"text","text":"「還是分兵兩路\n　較好吧。"}],"「丞相、作戦は\n　お決まりに\n　なりましたか？":[{"kind":"text","text":"「丞相，\n　作戰方針決定了嗎？"}],"「わかりました\n　南北二手に分かれて\n　攻めるのですね":[{"kind":"text","text":"「明白了。\n　分兵南北兩路進攻。"}],"「うむ\n　相手は陸遜だ\n　":[{"kind":"text","text":"「嗯，\n　對手可是"},{"kind":"control","value":2},{"kind":"text","text":"陸遜"},{"kind":"control","value":1},{"kind":"text","text":"。"}],"「油断せぬように\n　では、出陣する！":[{"kind":"control","value":1},{"kind":"text","text":"「不可大意。\n　那麼，出陣！"}],"「わかりました\n　全軍南側から攻める\n　のですね":[{"kind":"text","text":"「明白了。\n　全軍從南面進攻。"}],"「全軍、\n　白帝城に進軍\n　":[{"kind":"text","text":"「全軍向"},{"kind":"control","value":3},{"kind":"text","text":"白帝城"},{"kind":"control","value":1},{"kind":"text","text":"進軍！"}],"「先帝終焉の地を\n　取り返せ！":[{"kind":"control","value":1},{"kind":"text","text":"「奪回先帝駕崩之地！"}],"「全軍、\n　白帝城に進軍！":[{"kind":"text","text":"「全軍向"},{"kind":"control","value":3},{"kind":"text","text":"白帝城"},{"kind":"control","value":1},{"kind":"text","text":"進軍！"}]},"runVariants":{"[{\"kind\":\"text\",\"text\":\"「この戦、\\n　呉の命運が\\n　かかっている！\"}]":[{"kind":"text","text":"「這一戰，\n　關乎吳國的命運！"}],"[{\"kind\":\"text\",\"text\":\"「負けるわけには\\n　いかぬのだ！\"}]":[{"kind":"text","text":"「絕不能輸！"}],"[{\"kind\":\"text\",\"text\":\"「父上ッ！\"}]":[{"kind":"text","text":"「父親！"}],"[{\"kind\":\"text\",\"text\":\"「\"},{\"kind\":\"control\",\"value\":2},{\"kind\":\"text\",\"text\":\"瞻\"},{\"kind\":\"control\",\"value\":1},{\