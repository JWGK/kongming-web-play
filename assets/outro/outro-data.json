{"schemaVersion":"1.0.0","contentVersion":"rom-acf30794-outro-v1","storyId":"bowangpo-common-victory-outro","language":"ja","nodes":[{"id":"outro-000","kind":"dialogue","screen":{"asset":"assets/story-clean/scenes/outro-000.png","cleanScene":true,"staticCheckpoint":true},"bgmId":13,"textJa":"「まさか、\n　この大軍が\n　敗れるとは…","runs":[{"kind":"text","text":"「まさか、\n　この大軍が\n　敗れるとは…"}],"speakerDefinition":66,"speakerNameJa":null,"textId":"1:20580:0","messageIndex":0,"lineStart":0,"textLayout":"dialogue"},{"id":"outro-001","kind":"dialogue","screen":{"asset":"assets/story-clean/scenes/outro-001.png","cleanScene":true,"staticCheckpoint":true},"bgmId":13,"textJa":"「曹丞相に会わせる\n　顔がない","runs":[{"kind":"text","text":"「"},{"kind":"control","value":2},{"kind":"text","text":"曹丞相"},{"kind":"control","value":1},{"kind":"text","text":"に会わせる\n　顔がない"}],"speakerDefinition":66,"speakerNameJa":null,"textId":"1:20580:0","messageIndex":0,"lineStart":3,"textLayout":"dialogue"},{"id":"outro-002","kind":"dialogue","screen":{"asset":"assets/story-clean/scenes/outro-002.png","cleanScene":true,"staticCheckpoint":true},"bgmId":13,"textJa":"「徐庶の言葉に嘘は\n　なかった。見事な\n　采配と言わざるを","runs":[{"kind":"text","text":"「"},{"kind":"control","value":2},{"kind":"text","text":"徐庶"},{"kind":"control","value":1},{"kind":"text","text":"の言葉に嘘は\n　なかった。見事な\n　采配と言わざるを"}],"speakerDefinition":79,"speakerNameJa":null,"textId":"1:20580:0","messageIndex":1,"lineStart":0,"textLayout":"dialogue"},{"id":"outro-003","kind":"dialogue","screen":{"asset":"assets/story-clean/scenes/outro-003.png","cleanScene":true,"staticCheckpoint":true},"bgmId":13,"textJa":"「得ませんな","runs":[{"kind":"control","value":1},{"kind":"text","text":"「得ませんな"}],"speakerDefinition":79,"speakerNameJa":null,"textId":"1:20580:0","messageIndex":1,"lineStart":3,"textLayout":"dialogue"},{"id":"outro-004","kind":"dialogue","screen":{"asset":"assets/story-clean/scenes/outro-004.png","cleanScene":true,"staticCheckpoint":true},"bgmId":13,"textJa":"「諸葛亮め……\n　覚えておれよ！！","runs":[{"kind":"text","text":"「"},{"kind":"control","value":2},{"kind":"text","text":"諸葛亮"},{"kind":"control","value":1},{"kind":"text","text":"め……\n　覚えておれよ！！"}],"speakerDefinition":66,"speakerNameJa":null,"textId":"1:20580:0","messageIndex":2,"lineStart":0,"textLayout":"dialogue"},{"id":"outro-005","kind":"dialogue","screen":{"asset":"assets/story-clean/scenes/outro-005.png","cleanScene":true,"staticCheckpoint":true,"animationAsset":"assets/story-clean-motion/outro-005.apng","animationDurationMs":1205},"bgmId":13,"textJa":"「夏侯惇らは\n　退却したようです\n　","runs":[{"kind":"text","text":"「"},{"kind":"control","value":2},{"kind":"text","text":"夏侯惇"},{"kind":"control","value":1},{"kind":"text","text":"らは\n　退却したようです\n　"}],"speakerDefinition":0,"speakerNameJa":null,"textId":"1:20729:0","messageIndex":0,"lineStart":0,"textLayout":"dialogue"},{"id":"outro-006","kind":"dialogue","screen":{"asset":"assets/story-clean/scenes/outro-006.png","cleanScene":true,"staticCheckpoint":true},"bgmId":13,"textJa":"「我らも新野に\n　戻りましょう","runs":[{"kind":"control","value":1},{"kind":"text","text":"「我らも"},{"kind":"control","value":3},{"kind":"text","text":"新野"},{"kind":"control","value":1},{"kind":"text","text":"に\n　戻りましょう"}],"speakerDefinition":0,"speakerNameJa":null,"textId":"1:20729:0","messageIndex":0,"lineStart":3,"textLayout":"dialogue"},{"id":"outro-007","kind":"dialogue","screen":{"asset":"assets/story-clean/scenes/outro-007.png","cleanScene":true,"staticCheckpoint":true},"bgmId":13,"textJa":"「そうだな\n　引き上げるぞ！","runs":[{"kind":"text","text":"「そうだな\n　引き上げるぞ！"}],"speakerDefinition":1,"speakerNameJa":null,"textId":"1:20729:0","messageIndex":1,"lineStart":0,"textLayout":"dialogue"},{"id":"outro-save-1","kind":"save_prompt","screen":{"asset":"assets/story-clean/scenes/outro-save-1.png","cleanScene":true,"staticCheckpoint":true,"animationAsset":"assets/story-clean-motion/outro-save-1.apng","animationDurationMs":2913},"bgmId":13,"textJa":"ここでセーブしますか？"},{"id":"outro-008","kind":"dialogue","screen":{"asset":"assets/story-clean/scenes/outro-008.png","cleanScene":true,"staticCheckpoint":true,"animationAsset":"assets/story-clean-motion/outro-008.apng","animationDurationMs":50},"bgmId":13,"textJa":"「皆、今日はごくろう\n　だった。曹操の大軍\n　を退けられたのも","runs":[{"kind":"text","text":"「皆、今日はごくろう\n　だった。"},{"kind":"control","value":2},{"kind":"text","text":"曹操"},{"kind":"control","value":1},{"kind":"text","text":"の大軍\n　を退けられたのも"}],"speakerDefinition":1,"speakerNameJa":null,"textId":"1:20824:0","messageIndex":0,"lineStart":0,"textLayout":"dialogue"},{"id":"outro-009","kind":"dialogue","screen":{"asset":"assets/story-clean/scenes/outro-009.png","cleanScene":true,"staticCheckpoint":true},"bgmId":13,"textJa":"「すべて皆の働きの\n　おかげだ","runs":[{"kind":"control","value":1},{"kind":"text","text":"「すべて皆の働きの\n　おかげだ"}],"speakerDefinition":1,"speakerNameJa":null,"textId":"1:20824:0","messageIndex":0,"lineStart":3,"textLayout":"dialogue"},{"id":"outro-010","kind":"dialogue","screen":{"asset":"assets/story-clean/scenes/outro-010.png","cleanScene":true,"staticCheckpoint":true},"bgmId":13,"textJa":"「我らの働きばかり\n　ではありません\n　兄者の人徳と","runs":[{"kind":"text","text":"「我らの働きばかり\n　ではありません\n　兄者の人徳と"}],"speakerDefinition":2,"speakerNameJa":null,"textId":"1:20824:0","messageIndex":1,"lineStart":0,"textLayout":"dialogue"},{"id":"outro-011","kind":"dialogue","screen":{"asset":"assets/story-clean/scenes/outro-011.png","cleanScene":true,"staticCheckpoint":true},"bgmId":13,"textJa":"「新たに加わった\n　軍師の采配による\n　ものでしょう","runs":[{"kind":"text","text":"「新たに加わった\n　軍師の采配による\n　ものでしょう"}],"speakerDefinition":2,"speakerNameJa":null,"textId":"1:20824:0","messageIndex":1,"lineStart":3,"textLayout":"dialogue"},{"id":"outro-012","kind":"dialogue","screen":{"asset":"assets/story-clean/scenes/outro-012.png","cleanScene":true,"staticCheckpoint":true},"bgmId":13,"textJa":"「うむ。では、戦勝の\n　祝いと孔明の\n　歓迎をかねて、","runs":[{"kind":"text","text":"「うむ。では、戦勝の\n　祝いと"},{"kind":"control","value":2},{"kind":"text","text":"孔明"},{"kind":"control","value":1},{"kind":"text","text":"の\n　歓迎をかねて、"}],"speakerDefinition":1,"speakerNameJa":null,"textId":"1:20824:0","messageIndex":2,"lineStart":0,"textLayout":"dialogue"},{"id":"outro-013","kind":"dialogue","screen":{"asset":"assets/story-clean/scenes/outro-013.png","cleanScene":true,"staticCheckpoint":true},"bgmId":13,"textJa":"「酒盛りということに\n　しよう\n　","runs":[{"kind":"control","value":1},{"kind":"text","text":"「酒盛りということに\n　しよう\n　"}],"speakerDefinition":1,"speakerNameJa":null,"textId":"1:20824:0","messageIndex":2,"lineStart":3,"textLayout":"dialogue"},{"id":"outro-014","kind":"dialogue","screen":{"asset":"assets/story-clean/scenes/outro-014.png","cleanScene":true,"staticCheckpoint":true},"bgmId":13,"textJa":"「戦いの疲れを\n　いやしてくれ","runs":[{"kind":"control","value":1},{"kind":"text","text":"「戦いの疲れを\n　いやしてくれ"}],"speakerDefinition":1,"speakerNameJa":null,"textId":"1:20824:0","messageIndex":2,"lineStart":6,"textLayout":"dialogue"},{"id":"outro-015","kind":"dialogue","screen":{"asset":"assets/story-clean/scenes/outro-015.png","cleanScene":true,"staticCheckpoint":true,"animationAsset":"assets/story-clean-motion/outro-015.apng","animationDurationMs":352},"bgmId":13,"textJa":"「やったぜー！\n　酒盛り、酒盛り！","runs":[{"kind":"text","text":"「やったぜー！\n　酒盛り、酒盛り！"}],"speakerDefinition":3,"speakerNameJa":null,"textId":"1:21056:0","messageIndex":0,"lineStart":0,"textLayout":"dialogue"},{"id":"outro-016","kind":"dialogue","screen":{"asset":"assets/story-clean/scenes/outro-016.png","cleanScene":true,"staticCheckpoint":true,"animationAsset":"assets/story-clean-motion/outro-016.apng","animationDurationMs":2059},"bgmId":18,"textJa":"「丞相から大軍を\n　あずかりながら\n　配下の将の諫言も","runs":[{"kind":"text","text":"「丞相から大軍を\n　あずかりながら\n　配下の将の諫言も"}],"speakerDefinition":66,"speakerNameJa":null,"textId":"1:21098:0","messageIndex":0,"lineStart":0,"textLayout":"dialogue"},{"id":"outro-017","kind":"dialogue","screen":{"asset":"assets/story-clean/scenes/outro-017.png","cleanScene":true,"staticCheckpoint":true},"bgmId":18,"textJa":"「聞かずに、大敗を\n　こうむりました\n　","runs":[{"kind":"text","text":"「聞かずに、大敗を\n　こうむりました\n　"}],"speakerDefinition":66,"speakerNameJa":null,"textId":"1:21098:0","messageIndex":0,"lineStart":3,"textLayout":"dialogue"},{"id":"outro-018","kind":"dialogue","screen":{"asset":"assets/story-clean/scenes/outro-018.png","cleanScene":true,"staticCheckpoint":true},"bgmId":18,"textJa":"「面目ありません\n　いかようにも\n　ご処分を……","runs":[{"kind":"text","text":"「面目ありません\n　いかようにも\n　ご処分を……"}],"speakerDefinition":66,"speakerNameJa":null,"textId":"1:21098:0","messageIndex":0,"lineStart":6,"textLayout":"dialogue"},{"id":"outro-019","kind":"dialogue","screen":{"asset":"assets/story-clean/scenes/outro-019.png","cleanScene":true,"staticCheckpoint":true},"bgmId":18,"textJa":"「いや、勝敗は兵家の\n　常だ。過ぎたことを\n　言っても始まらぬ","runs":[{"kind":"text","text":"「いや、勝敗は兵家の\n　常だ。過ぎたことを\n　言っても始まらぬ"}],"speakerDefinition":65,"speakerNameJa":null,"textId":"1:21098:0","messageIndex":1,"lineStart":0,"textLayout":"dialogue"},{"id":"outro-020","kind":"dialogue","screen":{"asset":"assets/story-clean/scenes/outro-020.png","cleanScene":true,"staticCheckpoint":true},"bgmId":18,"textJa":"「家に戻り、戦いの\n　疲れをいやすが\n　よかろう","runs":[{"kind":"text","text":"「家に戻り、戦いの\n　疲れをいやすが\n　よかろう"}],"speakerDefinition":65,"speakerNameJa":null,"textId":"1:21098:0","messageIndex":1,"lineStart":3,"textLayout":"dialogue"},{"id":"outro-021","kind":"dialogue","screen":{"asset":"assets/story-clean/scenes/outro-021.png","cleanScene":true,"staticCheckpoint":true},"bgmId":18,"textJa":"「ご苦労であった","runs":[{"kind":"text","text":"「ご苦労であった"}],"speakerDefinition":65,"speakerNameJa":null,"textId":"1:21098:0","messageIndex":1,"lineStart":6,"textLayout":"dialogue"},{"id":"outro-022","kind":"dialogue","screen":{"asset":"assets/story-clean/scenes/outro-022.png","cleanScene":true,"staticCheckpoint":true},"bgmId":18,"textJa":"「ははっ……\n　ありがとう\n　ございます…","runs":[{"kind":"text","text":"「ははっ……\n　ありがとう\n　ございます…"}],"speakerDefinition":66,"speakerNameJa":null,"textId":"1:21292:0","messageIndex":0,"lineStart":0,"textLayout":"dialogue"},{"id":"outro-023","kind":"dialogue","screen":{"asset":"assets/story-clean/scenes/outro-023.png","cleanScene":true,"staticCheckpoint":true,"animationAsset":"assets/story-clean-motion/outro-023.apng","animationDurationMs":1406},"bgmId":18,"textJa":"「しかし、\n　わからぬな……","runs":[{"kind":"text","text":"「しかし、\n　わからぬな……"}],"speakerDefinition":65,"speakerNameJa":null,"textId":"1:21324:0","messageIndex":0,"lineStart":0,"textLayout":"dialogue"},{"id":"outro-024","kind":"dialogue","screen":{"asset":"assets/story-clean/scenes/outro-024.png","cleanScene":true,"staticCheckpoint":true},"bgmId":18,"textJa":"「丞相、どうか\n　なさいましたか？","runs":[{"kind":"text","text":"「丞相、どうか\n　なさいましたか？"}],"speakerDefinition":80,"speakerNameJa":null,"textId":"1:21324:0","messageIndex":1,"lineStart":0,"textLayout":"dialogue"},{"id":"outro-025","kind":"dialogue","screen":{"asset":"assets/story-clean/scenes/outro-025.png","cleanScene":true,"staticCheckpoint":true},"bgmId":18,"textJa":"「確かに、夏侯惇は\n　短気なところもある\n　","runs":[{"kind":"text","text":"「確かに、"},{"kind":"control","value":2},{"kind":"text","text":"夏侯惇"},{"kind":"control","value":1},{"kind":"text","text":"は\n　短気なところもある\n　"}],"speakerDefinition":65,"speakerNameJa":null,"textId":"1:21324:0","messageIndex":2,"lineStart":0,"textLayout":"dialogue"},{"id":"outro-026","kind":"dialogue","screen":{"asset":"assets/story-clean/scenes/outro-026.png","cleanScene":true,"staticCheckpoint":true},"bgmId":18,"textJa":"「それでも黄巾の乱\n　以来の百戦錬磨の将\n　","runs":[{"kind":"control","value":1},{"kind":"text","text":"「それでも黄巾の乱\n　以来の百戦錬磨の将\n　"}],"speakerDefinition":65,"speakerNameJa":null,"textId":"1:21324:0","messageIndex":2,"lineStart":3,"textLayout":"dialogue"},{"id":"outro-027","kind":"dialogue","screen":{"asset":"assets/story-clean/scenes/outro-027.png","cleanScene":true,"staticCheckpoint":true},"bgmId":18,"textJa":"「それを、こうも\n　軽くあしらうとは","runs":[{"kind":"control","value":1},{"kind":"text","text":"「それを、こうも\n　軽くあしらうとは"}],"speakerDefinition":65,"speakerNameJa":null,"textId":"1:21324:0","messageIndex":2,"lineStart":6,"textLayout":"dialogue"},{"id":"outro-028","kind":"dialogue","screen":{"asset":"assets/story-clean/scenes/outro-028.png","cleanScene":true,"staticCheckpoint":true},"bgmId":18,"textJa":"「確かに……\n　恐るべき知謀と言わ\n　ざるを得ませんな","runs":[{"kind":"text","text":"「確かに……\n　恐るべき知謀と言わ\n　ざるを得ませんな"}],"speakerDefinition":73,"speakerNameJa":null,"textId":"1:21324:0","messageIndex":3,"lineStart":0,"textLayout":"dialogue"},{"id":"outro-029","kind":"dialogue","screen":{"asset":"assets/story-clean/scenes/outro-029.png","cleanScene":true,"staticCheckpoint":true},"bgmId":18,"textJa":"「孔明という男、\n　あなどることは\n　できん","runs":[{"kind":"text","text":"「"},{"kind":"control","value":2},{"kind":"text","text":"孔明"},{"kind":"control","value":1},{"kind":"text","text":"という男、\n　あなどることは\n　できん"}],"speakerDefinition":65,"speakerNameJa":null,"textId":"1:21324:0","messageIndex":4,"lineStart":0,"textLayout":"dialogue"},{"id":"outro-030","kind":"dialogue","screen":{"asset":"assets/story-clean/scenes/outro-030.png","cleanScene":true,"staticCheckpoint":true},"bgmId":18,"textJa":"「……よし\n　今度はわしが\n　出陣しよう","runs":[{"kind":"control","value":1},{"kind":"text","text":"「……よし\n　今度はわしが\n　出陣しよう"}],"speakerDefinition":65,"speakerNameJa":null,"textId":"1:21324:0","messageIndex":4,"lineStart":3,"textLayout":"dialogue"},{"id":"outro-031","kind":"dialogue","screen":{"asset":"assets/story-clean/scenes/outro-031.png","cleanScene":true,"staticCheckpoint":true},"bgmId":18,"textJa":"「曹仁！\n　曹洪ｿｳｺｳ！\n　許褚ｷｮﾁｮ！","runs":[{"kind":"text","text":"「"},{"kind":"control","value":2},{"kind":"text","text":"曹仁"},{"kind":"control","value":1},{"kind":"text","text":"！\n　"},{"kind":"control","value":2},{"kind":"text","text":"曹洪ｿｳｺｳ"},{"kind":"control","value":1},{"kind":"text","text":"！\n　"},{"kind":"control","value":2},{"kind":"text","text":"許褚ｷｮﾁｮ"},{"kind":"control","value":1},{"kind":"text","text":"！"}],"speakerDefinition":65,"speakerNameJa":null,"textId":"1:21324:0","messageIndex":5,"lineStart":0,"textLayout":"dialogue"},{"id":"outro-033","kind":"dialogue","screen":{"asse