speakerNameJa":null,"textId":"1:23088:0","messageIndex":0,"lineStart":3,"textLayout":"dialogue"},{"id":"outro-079","kind":"dialogue","screen":{"asset":"assets/story-clean/scenes/outro-079.png","cleanScene":true,"staticCheckpoint":true},"bgmId":18,"textJa":"「我が呉の水軍を\n　もってしても、\n　果たして","runs":[{"kind":"control","value":1},{"kind":"text","text":"「我が呉の水軍を\n　もってしても、\n　果たして"}],"speakerDefinition":150,"speakerNameJa":null,"textId":"1:23088:0","messageIndex":0,"lineStart":6,"textLayout":"dialogue"},{"id":"outro-080","kind":"dialogue","screen":{"asset":"assets/story-clean/scenes/outro-080.png","cleanScene":true,"staticCheckpoint":true},"bgmId":18,"textJa":"「勝てるかどうか…","runs":[{"kind":"control","value":1},{"kind":"text","text":"「勝てるかどうか…"}],"speakerDefinition":150,"speakerNameJa":null,"textId":"1:23088:0","messageIndex":0,"lineStart":9,"textLayout":"dialogue"},{"id":"outro-081","kind":"dialogue","screen":{"asset":"assets/story-clean/scenes/outro-081.png","cleanScene":true,"staticCheckpoint":true},"bgmId":18,"textJa":"「そうか…\n　我々も覚悟を決め\n　ねばならぬか…","runs":[{"kind":"text","text":"「そうか…\n　我々も覚悟を決め\n　ねばならぬか…"}],"speakerDefinition":149,"speakerNameJa":null,"textId":"1:23088:0","messageIndex":1,"lineStart":0,"textLayout":"dialogue"},{"id":"outro-082","kind":"dialogue","screen":{"asset":"assets/story-clean/scenes/outro-082.png","cleanScene":true,"staticCheckpoint":true},"bgmId":18,"textJa":"「しかし、\n　曹操軍は呉に\n　直接攻めてきた","runs":[{"kind":"text","text":"「しかし、\n　"},{"kind":"control","value":2},{"kind":"text","text":"曹操軍"},{"kind":"control","value":1},{"kind":"text","text":"は呉に\n　直接攻めてきた"}],"speakerDefinition":151,"speakerNameJa":null,"textId":"1:23242:0","messageIndex":0,"lineStart":0,"textLayout":"dialogue"},{"id":"outro-083","kind":"dialogue","screen":{"asset":"assets/story-clean/scenes/outro-083.png","cleanScene":true,"staticCheckpoint":true},"bgmId":18,"textJa":"「わけでは\n　ありません\n　","runs":[{"kind":"control","value":1},{"kind":"text","text":"「わけでは\n　ありません\n　"}],"speakerDefinition":151,"speakerNameJa":null,"textId":"1:23242:0","messageIndex":0,"lineStart":3,"textLayout":"dialogue"},{"id":"outro-084","kind":"dialogue","screen":{"asset":"assets/story-clean/scenes/outro-084.png","cleanScene":true,"staticCheckpoint":true},"bgmId":18,"textJa":"「こちらからは手を\n　出さず、情勢を\n　見守るのが","runs":[{"kind":"control","value":1},{"kind":"text","text":"「こちらからは手を\n　出さず、情勢を\n　見守るのが"}],"speakerDefinition":151,"speakerNameJa":null,"textId":"1:23242:0","messageIndex":0,"lineStart":6,"textLayout":"dialogue"},{"id":"outro-085","kind":"dialogue","screen":{"asset":"assets/story-clean/scenes/outro-085.png","cleanScene":true,"staticCheckpoint":true},"bgmId":18,"textJa":"「得策でしょう\n　\n　","runs":[{"kind":"control","value":1},{"kind":"text","text":"「得策でしょう\n　\n　"}],"speakerDefinition":151,"speakerNameJa":null,"textId":"1:23242:0","messageIndex":0,"lineStart":9,"textLayout":"dialogue"},{"id":"outro-086","kind":"dialogue","screen":{"asset":"assets/story-clean/scenes/outro-086.png","cleanScene":true,"staticCheckpoint":true},"bgmId":18,"textJa":"「荊州には劉備もいる\n　ことですし…","runs":[{"kind":"control","value":1},{"kind":"text","text":"「"},{"kind":"control","value":3},{"kind":"text","text":"荊州"},{"kind":"control","value":1},{"kind":"text","text":"には"},{"kind":"control","value":2},{"kind":"text","text":"劉備"},{"kind":"control","value":1},{"kind":"text","text":"もいる\n　ことですし…"}],"speakerDefinition":151,"speakerNameJa":null,"textId":"1:23242:0","messageIndex":0,"lineStart":12,"textLayout":"dialogue"},{"id":"outro-087","kind":"dialogue","screen":{"asset":"assets/story-clean/scenes/outro-087.png","cleanScene":true,"staticCheckpoint":true},"bgmId":18,"textJa":"「そうだな。しかし、\n　何も手を打たぬわけ\n　にもいくまい","runs":[{"kind":"text","text":"「そうだな。しかし、\n　何も手を打たぬわけ\n　にもいくまい"}],"speakerDefinition":149,"speakerNameJa":null,"textId":"1:23242:0","messageIndex":1,"lineStart":0,"textLayout":"dialogue"},{"id":"outro-088","kind":"dialogue","screen":{"asset":"assets/story-clean/scenes/outro-088.png","cleanScene":true,"staticCheckpoint":true},"bgmId":18,"textJa":"「軍備だけは整えて\n　おこう。いつ戦いに\n　巻き込まれるか","runs":[{"kind":"text","text":"「軍備だけは整えて\n　おこう。いつ戦いに\n　巻き込まれるか"}],"speakerDefinition":149,"speakerNameJa":null,"textId":"1:23242:0","messageIndex":1,"lineStart":3,"textLayout":"dialogue"},{"id":"outro-089","kind":"dialogue","screen":{"asset":"assets/story-clean/scenes/outro-089.png","cleanScene":true,"staticCheckpoint":true},"bgmId":18,"textJa":"「わからんからな","runs":[{"kind":"text","text":"「わからんからな"}],"speakerDefinition":149,"speakerNameJa":null,"textId":"1:23242:0","messageIndex":1,"lineStart":6,"textLayout":"dialogue"},{"id":"outro-090","kind":"dialogue","screen":{"asset":"assets/story-clean/scenes/outro-090.png","cleanScene":true,"staticCheckpoint":true},"bgmId":18,"textJa":"「賛成でございます\n　では、私は水軍を\n　鍛え上げましょう","runs":[{"kind":"text","text":"「賛成でございます\n　では、私は水軍を\n　鍛え上げましょう"}],"speakerDefinition":150,"speakerNameJa":null,"textId":"1:23242:0","messageIndex":2,"lineStart":0,"textLayout":"dialogue"},{"id":"outro-091","kind":"dialogue","screen":{"asset":"assets/story-clean/scenes/outro-091.png","cleanScene":true,"staticCheckpoint":true},"bgmId":18,"textJa":"「補給その他に\n　ついては\n　張昭ﾁｮｳｼｮｳ、","runs":[{"kind":"text","text":"「補給その他に\n　ついては\n　"},{"kind":"control","value":2},{"kind":"text","text":"張昭ﾁｮｳｼｮｳ"},{"kind":"control","value":1},{"kind":"text","text":"、"}],"speakerDefinition":149,"speakerNameJa":null,"textId":"1:23242:0","messageIndex":3,"lineStart":0,"textLayout":"dialogue"},{"id":"outro-092","kind":"dialogue","screen":{"asset":"assets/story-clean/scenes/outro-092.png","cleanScene":true,"staticCheckpoint":true},"bgmId":18,"textJa":"「そなたに\n　一任しよう","runs":[{"kind":"control","value":1},{"kind":"text","text":"「そなたに\n　一任しよう"}],"speakerDefinition":149,"speakerNameJa":null,"textId":"1:23242:0","messageIndex":3,"lineStart":3,"textLayout":"dialogue"},{"id":"outro-093","kind":"dialogue","screen":{"asset":"assets/story-clean/scenes/outro-093.png","cleanScene":true,"staticCheckpoint":true,"animationAsset":"assets/story-clean-motion/outro-093.apn