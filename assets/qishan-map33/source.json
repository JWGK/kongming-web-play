"]]],"4:1:0:11803":[[98,["「なんと！\n　",[2],"曹真",[1],"が…、\n　死んだと申すか！"]]],"4:1:0:11842":[[94,["「……はっ\n　",[3],"陳倉",[1],"より使者が\n　参りました\n「",[2],"孔明",[1],"との戦いで、\n　兵を多く失ったこと\n　から心労が重なり…\n「発作を起こして、\n　亡くなったとのこと"]]],"4:1:0:11958":[[98,["「では、",[2],"曹真",[1],"は",[2],"孔明",[1],"に\n　殺されたということ\n　になるではないか！\n「うぬぬ…！　\n　",[2],"孔明",[1],"め、許せぬ！\n　\n「すぐに\n　",[2],"司馬懿",[1],"に伝えよ！\n　\n「一日も早く、\n　",[2],"孔明",[1],"を討てとな！"]]],"4:1:0:12114":[[484,["「",[2],"司馬懿",[1],"殿、\n　陛下よりの勅命で\n　ございます"]]],"4:1:0:12157":[[96,["「ははーっ"]],[484,["「陛下には一日も早く\n　",[2],"孔明",[1],"を討て、との\n　仰せでございます"]],[96,["「勅命、謹んで\n　お受けいたします\n　\n「必ずや",[2],"曹真",[1],"様の仇を\n　討ちます"]],[484,["「お願いいたします\n　陛下も期待して\n　おられますぞ"]]],"4:1:0:12313":[[96,["「誰か、\n　",[2],"孔明",[1],"に使者を送れ\n　\n「わしからの挑戦状を\n　持たせてな"]]],"4:1:0:12371":[[91,["「挑戦状ですか！？\n　すると、蜀軍と\n　正面決戦をすると？"]],[96,["「そうだ\n　わしと",[2],"孔明",[1],"との\n　知恵比べになる\n「全軍、\n　",[3],"祁山",[1],"に出陣する！"]]],"4:1:0:12481":[[96,["「",[2],"孔明",[1],"、\n　",[2],"曹真",[1],"様の仇だ！\n　\n「その首は\n　わしがもらう！"]]],"4:1:0:12556":[[0,["「魏軍から\n　面白いものが\n　届けられた\n「",[2],"司馬懿",[1],"からの\n　挑戦状だ"]]],"4:1:0:12615":[[8,["「ということは、\n　正面からの\n　戦いですね\n「丞相、\n　挑戦をお受けに\n　なるのですか？"]],[0,["「うむ\n　いよいよ、\n　",[2],"司馬懿",[1],"との決戦だ\n「皆の者、\n　出陣の準備をいたせ"]],[7,["「はっ！"]]],"4:1:0:12747":[[4,["「丞相\n　出陣する際には\n　私にお話し下さい"]]],"4:1:0:12803":[[4,["「丞相、\n　出陣いたしますか？"]]],"4:1:0:12829":[[0,["「",[2],"姜維",[1],"よ、\n　そなたの活躍を\n　期待しているぞ"]],[4,["「ははっ！\n　ご期待にそうよう\n　努力いたします"]]],"4:1:8:11145":["敗れた",[2],"曹真",[1],"たち魏軍は、桟道を\r\n通って",[3],"陳倉",[1],"まで退却していった\r\n",[2],"孔明",[1],"は、再び",[3],"祁山",[1],"に進出した\r\n",[3],"祁山",[1],"を制圧することによって、\r\n魏各所への攻撃が容易になるの\r\nである"],"4:1:11:11278":["陳倉"],"4:1:11:11283":["陳倉　会議場"],"4:1:11:11787":["洛陽"],"4:1:11:11792":["洛陽　宮殿"],"4:1:11:12101":["陳倉　会議場"],"4:1:11:12536":["祁山"],"4:1:11:12541":["祁山　蜀軍幕舎"],"4:1:48:12785":["姜維"],"4:1:48:12790":["出陣の準備をする"],"4:1:0:12904":[[96,["「来たか、",[2],"孔明",[1],"\n　貴様はもともと\n　",[3],"南陽",[1],"の一布衣\n「賊軍を率いて\n　境を侵すなど\n　言語道断である\n「いま引き上げれば、\n　命まではとらぬ\n　\n「早々に",[3],"漢中",[1],"まで\n　帰るがよかろう"]],[0,["「私は、先帝の\n　ご遺命を受けて賊を\n　討伐に来たのだ\n「引き上げる理由など\n　どこにもない\n　\n「また、私を",[3],"南陽",[1],"の\n　布衣と言うならば、\n　\n「そもそも",[2],"司馬家",[1],"は\n　漢の名士の家柄\n　ではないか\n「漢朝に背いて\n　賊に与するとは、\n　\n「祖先に対して\n　恥ずかしいと\n　思わぬのか！？"]],[96,["「ええぃ、\n　舌戦では\n　らちがあかぬ\n「こうなれば、\n　実戦で勝負じゃ"]],[96,["「",[2],"戴陵",[1],"、\n　",[2],"楽ｶﾞｸﾁﾝ",[1],"、\n　",[2],"張虎ﾁｮｳｺ",[1],"！\n「そなたらに先鋒を\n　命じるゆえ",[2],"孔明",[1],"の奴\n　を捕らえて参れ！"]],[147,["「ははっ！"]],[0,["「まずは敵の先鋒を\n　捕らえてみせよう\n　\n「",[2],"司馬懿",[1],"の始末は\n　その後じゃ"]]],"4:1:0:13487":[[147,["「うわぁっ！\n　し、しまった！"]]],"4:1:0:13528":[[116,["「ああっ！\n　……逃げられぬか"]]],"4:1:0:13572":[[117,["「おのれぇ！\n　貴様らごときにぃ！"]]],"4:1:0:13617":[[96,["「し、しまった！\n　ええぃ、退けぇっ！"]]],"4:1:0:13644":[[0,["「ふう……\n　苦しい\n　戦いだった……"]]],"4:1:0:13697":[[147,["「うわぁっ！\n　し、しまった！"]]],"4:1:0:13719":[[116,["「ああっ！\n　……逃げられぬか"]]],"4:1:0:13744":[[117,["「おのれぇ！\n　貴様らごときにぃ！"]]],"4:1:0:13770":[[96,["「よし、\n　騎兵隊は出陣！\n　\n「先鋒の手助けを\n　してやれ"]]],"4:1:0:13819":[[91,["「おお、\n　間に合ったようだ\n　\n「目指すは\n　",[2],"孔明",[1],"の首だ！"]],[95,["「後方にいた\n　",[2],"張",[1],"殿の部隊が\n　到着いたしました"]],[96,["「おお、\n　やっと着いたか\n　がんばってくれぃ"]]],"4:1:0:13944":[[96,["「我が先鋒に苦戦する\n　ようでは",[2],"孔明",[1],"もたか\n　がしれておるな\n「よし、\n　全軍進撃せよ！"]]],"4:1:0:14013":[[96,["「な、なにっ！\n　先鋒の三武将が\n　\n「皆、蜀軍に\n　捕らえられただと！"]],[10,["「丞相、こやつらが\n　魏軍の先鋒の将たち\n　です"]],[0,["「貴様らごとき無名の\n　将がこの私にかなう\n　と思ったか？"]],[147,["「…………"]],[0,["「戦いの根幹は、\n　武勇ではなく兵法だ\n　\n「",[2],"司馬懿",[1],"に\n　伝えるがよかろう\n　\n「もっと兵法を\n　学んでから攻めよ、\n　と"]],[117,["「…………！"]],[0,["「命だけは\n　助けてやろう\n　\n「",[2],"姜維",[1],"、こやつらを\n　裸にして追い返せ！"]]],"4:1:0:14321":[[95,["「……総司令\n　先鋒の三将が\n　戻って参りました"]],[96,["「おお、\n　無事だったか…\n　\n「どうした、\n　その姿は！？"]],[116,["「蜀軍に捕らわれ、\n　衣服をはがれ……\n　\n「裸で\n　追い返されました"]],[117,["「くっ……\n　申し訳ございません"]],[96,["「お、おのれ、",[2],"孔明",[1],"！\n　わしを\n　馬鹿にしたな！\n「全軍出陣だ！\n　何としても\n　",[2],"孔明",[1],"を捕らえよ！"]]],"4:1:0:14581":[[91,["「おお、\n　間に合ったようだ\n　\n「目指すは\n　",[2],"孔明",[1],"の首だ！"]],[95,["「後方にいた\n　",[2],"張",[1],"殿の部隊が\n　到着いたしました"]],[96,["「おお、\n　やっと着いたか\n　がんばってくれぃ"]]],"4:1:0:14706":[[96,["「し、しまった！\n　ええぃ、退けぇっ！"]]],"4:1:0:14733":[[91,["「しまった…\n　",[2],"司馬懿",[1],"殿はもう\n　退却したか\n「しかたがない、\n　我らも…"]]],"4:1:0:14793":[[0,["「ふう……\n　苦しい\n　戦いだった……"]]],"4:1:11:13509":[