ind":"control","value":2},{"kind":"text","text":"曹丞相"},{"kind":"control","value":1},{"kind":"text","text":"之命，唯獨你絕不能放走！"}],"「敵の援軍か…\n　早く江夏まで\n　行かねば":[{"kind":"text","text":"「敵軍的援兵嗎……必須盡快趕到"},{"kind":"control","value":3},{"kind":"text","text":"江夏"},{"kind":"control","value":1},{"kind":"text","text":"。"}],"「ちっ！\n　逃げられたか！\n　運のいい奴め……":[{"kind":"text","text":"「嘖！讓他逃了嗎！真是走運的傢伙……"}],"「まあいい\n　\n　":[{"kind":"text","text":"「也罷。"}],"「今頃、劉備の奴は\n　曹丞相に討たれた\n　ことだろう":[{"kind":"text","text":"「"},{"kind":"control","value":2},{"kind":"text","text":"劉備"},{"kind":"control","value":1},{"kind":"text","text":"那傢伙，此刻想必已被"},{"kind":"control","value":2},{"kind":"text","text":"曹丞相"},{"kind":"control","value":1},{"kind":"text","text":"殺了。"}],"「貴様が江夏軍を\n　率いて戻っても\n　主君がおらねば、":[{"kind":"text","text":"「就算你率領"},{"kind":"control","value":3},{"kind":"text","text":"江夏軍"},{"kind":"control","value":1},{"kind":"text","text":"回來，若主公已經不在，"}],"「意味がなかろう\n　ふははは…！":[{"kind":"text","text":"「又有甚麼意義？哈哈哈……！"}],"「ふう……\n　何とか着きましたな":[{"kind":"text","text":"「呼……總算是到了。"}],"「おお、孔明殿は無事\n　に江夏へたどり\n　ついたようだな":[{"kind":"text","text":"「哦，看來"},{"kind":"control","value":2},{"kind":"text","text":"孔明"},{"kind":"control","value":1},{"kind":"text","text":"先生已平安抵達"},{"kind":"control","value":3},{"kind":"text","text":"江夏"},{"kind":"control","value":1},{"kind":"text","text":"。"}],"「では……":[{"kind":"text","text":"「那麼……"}],"「あの魏延という者は\n　どこへ？":[{"kind":"text","text":"「那位名叫"},{"kind":"control","value":2},{"kind":"text","text":"魏延"},{"kind":"control","value":1},{"kind":"text","text":"的人，去哪裡了？"}],"「さあ……？\n　なかなかの使い手の\n　ようでしたが":[{"kind":"text","text":"「這個……？看來是位身手不凡的人。"}],"「…………":[{"kind":"text","text":"「…………"}],"「あれは……\n　おお、孔明殿！":[{"kind":"text","text":"「那是……哦，"},{"kind":"control","value":2},{"kind":"text","text":"孔明"},{"kind":"control","value":1},{"kind":"text","text":"先生！"}],"「あの軍勢は……？\n　蔡瑁の手のものでは\n　なさそうだが":[{"kind":"text","text":"「那支軍隊是……？看來不像"},{"kind":"control","value":2},{"kind":"text","text":"蔡瑁"},{"kind":"control","value":1},{"kind":"text","text":"的手下。"}],"「我が名は魏延！\n　\n　":[{"kind":"text","text":"「我名叫"},{"kind":"control","value":2},{"kind":"text","text":"魏延"},{"kind":"control","value":1},{"kind":"text","text":"！"}],"「蔡瑁の卑劣さに愛想\n　をつかし、荊州軍\n　から逃れてきた者":[{"kind":"text","text":"「我看不慣"},{"kind":"control","value":2},{"kind":"text","text":"蔡瑁"},{"kind":"control","value":1},{"kind":"text","text":"的卑劣行徑，已離開"},{"kind":"control","value":3},{"kind":"text","text":"荊州軍"},{"kind":"control","value":1},{"kind":"text","text":"。"}],"「義によって孔明殿に\n　助太刀いたす！":[{"kind":"text","text":"「出於道義，前來助"},{"kind":"control","value":2},{"kind":"text","text":"孔明"},{"kind":"control","value":1},{"kind":"text","text":"先生一臂之力！"}],"「おのれ、魏延\n　この裏切り者がぁ！":[{"kind":"text","text":"「可惡，"},{"kind":"control","value":2},{"kind":"text","text":"魏延"},{"kind":"control","value":1},{"kind":"text","text":"！你這個叛徒！"}],"「ううっ、\n　さすがは関羽\n　":[{"kind":"text","text":"「唔……不愧是"},{"kind":"control","value":2},{"kind":"text","text":"關羽"},{"kind":"control","value":1},{"kind":"text","text":"。"}],"「まあいい、劉備の\n　奴は曹丞相に討たれ\n　た頃だろう":[{"kind":"text","text":"「也罷，"},{"kind":"control","value":2},{"kind":"text","text":"劉備"},{"kind":"control","value":1},{"kind":"text","text":"那傢伙，此刻想必已被"},{"kind":"control","value":2},{"kind":"text","text":"曹丞相"},{"kind":"control","value":1},{"kind":"text","text":"殺了。"}],"「意味がないわ\n　ふははは…！":[{"kind":"text","text":"「又有甚麼意義？哈哈哈……！"}],"「何とか危機は\n　脱したようだな\n　では……":[{"kind":"text","text":"「看來總算脫離險境了。那麼……"}],"「さて……？\n　なかなかの使い手の\n　ようでしたが":[{"kind":"text","text":"「這個……？看來是位身手不凡的人。"}],"「では、軍師\n　江夏に入城\n　いたしましょう":[{"kind":"text","text":"「那麼，軍師，我們進"},{"kind":"control","value":3},{"kind":"text","text":"江夏"},{"kind":"control","value":1},{"kind":"text","text":"城吧。"}],"「うむ":[{"kind":"text","text":"「嗯。"}],"「よく来て下さい\n　ました\n　襄陽の弟が":[{"kind":"text","text":"「歡迎各位前來。聽說我在"},{"kind":"control","value":3},{"kind":"text","text":"襄陽"},{"kind":"control","value":1},{"kind":"text","text":"的弟弟"}],"「曹操に降伏したと\n　聞いて心配していた\n　のです":[{"kind":"text","text":"「向"},{"kind":"control","value":2},{"kind":"text","text":"曹操"},{"kind":"control","value":1},{"kind":"text","text":"投降，令我十分擔心。"}],"「それで劉備殿は？\n　ご無事なのですか？":[{"kind":"text","text":"「那麼，"},{"kind":"control","value":2},{"kind":"text","text":"劉備"},{"kind":"control","value":1},{"kind":"text","text":"大人呢？他平安無事嗎？"}],"「我が殿は江陵に\n　向かっております\n　":[{"kind":"text","text":"「我家主公正前往"},{"kind":"control","value":3},{"kind":"text","text":"江陵"},{"kind":"control","value":1},{"kind":"text","text":"。"}],"「…ただ、曹操軍は\n　すでに追撃している\n　頃かと…":[{"kind":"text","text":"「……只是，"},{"kind":"control","value":2},{"kind":"text","text":"曹操軍"},{"kind":"control","value":1},{"kind":"text","text":"恐怕已經開始追擊了……"}],"「ええっ！":[{"kind":"text","text":"「甚麼！"}],"「我が軍には、殿を\n　慕って新野から\n　逃げ出した民衆が":[{"kind":"text","text":"「我軍之中，有仰慕主公、從"},{"kind":"control","value":3},{"kind":"text","text":"新野"},{"kind":"control","value":1},{"kind":"text","text":"逃出來的百姓"}],"「ついてきています\n　\n　":[{"kind":"text","text":"「一路跟隨。"}],"「そのため、\n　行軍速度が遅く\n　なっています":[{"kind":"text","text":"「因此，行軍速度變得緩慢。"}],"「曹操が軽装の騎兵を\n　もって進めば、\n　追いつかれるのは":[{"kind":"text","text":"「若"},{"kind":"control","value":2},{"kind":"text","text":"曹操"},{"kind":"control","value":1},{"kind":"text","text":"率輕裝騎兵前進，被追上"}],"「時間の問題です":[{"kind":"text","text":"「只是時間問題。"}],"「なんと……！\n　そんな窮地に追い\n　込まれていたとは！":[{"kind":"text","text":"「怎麼會……！沒想到竟陷入如此困境！"}],"「そこで、援軍の\n　お願いに参った\n　次第です":[{"kind":"text","text":"「因此，我們特來請求援軍。"}],"「なにとぞ軍勢を出し\n　ていただきたい":[{"kind":"text","text":"「懇請您出兵相助。"}],"「無論です\n　さっそく出陣の用意\n　をいたしましょう":[{"kind":"text","text":"「當然。我這就準備出兵。"}],"「軍勢は整えて\n　あります\n　":[{"kind":"text","text":"「軍隊已經整備妥當。"}],"「軍師殿の準備は\n　よろしいのですか？":[{"kind":"text","text":"「軍師大人，您準備好了嗎？"}],"「すぐに出陣\n　いたしましょう":[{"kind":"text","text":"「我們立刻出兵吧。"}],"「孔明様、\n　これをお使い下さい\n　ませ":[{"kind":"text","text":"「"},{"kind":"control","value":2},{"kind":"text","text":"孔明"},{"kind":"control","value":1},{"kind":"text","text":"大人，請您使用這個。"}],"「孔明様、\n　これをお使い\n　下さい":[{"kind":"text","text":"「"},{"kind":"control","value":2},{"kind":"text","text":"孔明"},{"kind":"control","value":1},{"kind":"text","text":"大人，請您使用這個。"}],"「軍師、準備は\n　よろしいですか？":[{"kind":"text","text":"「軍師，準備好了嗎？"}],"「レベル１５以上の\n　軍師が『昇格の印綬』を\n　使うと、名軍師に":[{"kind":"text","text":"「等級15以上的軍師使用「"},{"kind":"control","value":3},{"kind":"text","text":"升格印綬"},{"kind":"control","value":1},{"kind":"text","text":"」後，便能將兵種"}],"「兵種を強化できます":[{"kind":"text","text":"「升為名軍師。"}],"「呉の水軍訓練を\n　見てきたけど……、\n　すごかったな":[{"kind":"text","text":"「我去看過吳軍的水軍訓練……真厲害啊。"}],"「軍楽隊は、\n　味方の攻撃力を上げる策略を\n　使えます":[{"kind":"text","text":"「軍樂隊能使用提高友軍攻擊力的策略。"}],"「鎧は騎馬系が、\n　盾は歩兵系などが\n　装備できますよ":[{"kind":"text","text":"「騎兵系能裝備鎧甲，步兵系等兵種則能裝備盾牌。"}],"「戦場には、宝物庫や兵糧庫が\n　ある。そこへ行けば、何か\n　いいものが手に入るだろう":[{"kind":"text","text":"「戰場上有寶物庫和兵糧庫。到那裡去，應該能拿到些好東西。"}],"「今度は西の益州の方に\n　行こうと思うの。益州は今、\n　劉璋様が治めているわ":[{"kind":"text","text":"「我打算下次往西邊的"},{"kind":"control","value":3},{"kind":"text","text":"益州"},{"kind":"control","value":1},{"kind":"text","text":"去。"},{"kind":"control","value":3},{"kind":"text","text":"益州"},{"kind":"control","value":1},{"kind":"text","text":"如今由"},{"kind":"control","value":2},{"kind":"text","text":"劉璋"},{"kind":"control","value":1},{"kind":"text","text":"大人治理。"}],"「駿馬に乗っていると、\n　移動力が上がるそうですよ":[{"kind":"text","text":"「聽說騎著駿馬，移動力就會提高呢。"}],"一、孔明が北東の砦に到着する\r\n二、敵部隊の全滅":[{"kind":"text","text":"一、"},{"kind":"control","value":2},{"kind":"text","text":"孔明"},{"kind":"control","value":1},{"kind":"text","text":"抵達東北方的堡壘\r\n二、消滅全部敵軍"}],"金５００を手に入れた！":[{"kind":"text","text":"獲得500金！"}],"関羽はレベルが上がった！":[{"kind":"text","text":"關羽升級了！"}],"江夏":[{"kind":"text","text":"江夏"}],"江夏の会議場に行く":[{"kind":"text","text":"前往江夏的議事廳"}],"江夏　会議場":[{"kind":"text","text":"江夏　議事廳"}],"関羽に話しかける":[{"kind":"text","text":"與關羽交談"}],"その頃、襄陽から江陵へと向か\r\nう劉備本隊は、当陽ﾄｳﾖｳ県の\r\n長坂坡ﾁｮｳﾊﾝﾊというところで\r\n曹操軍に追いつかれ襲撃を受け\r\nた\r\n　\r\n趙雲は、劉備の夫人と\r\n子の阿斗ｱﾄ（後の劉禅ﾘｭｳｾﾞﾝ）\r\nを警護していたが、乱戦の最中\r\nで見失ってしまった":[{"kind":"text","text":"此時，從"},{"kind":"control","value":3},{"kind":"text","text":"襄陽"},{"kind":"control","value":1},{"kind":"text","text":"前往"},{"kind":"control","value":3},{"kind":"text","text":"江陵"},{"kind":"control","value":1},{"kind":"text","text":"的\r\n"},{"kind":"control","value":2},{"kind":"text","text":"劉備"},{"kind":"control","value":1},{"kind":"text","text":"本隊，在"},{"kind":"control","value":3},{"kind":"text","text":"當陽縣"},{"kind":"control","value":1},{"kind":"text","text":"一處\r\n名為"},{"kind":"control","value":3},{"kind":"text","text":"長坂坡"},{"kind":"control","value":1},{"kind":"text","text":"的地方，\r\n被"},{"kind":"control","value":2},{"kind":"text","text":"曹操軍"},{"kind":"control","value":1},{"kind":"text","text":"追上，\r\n遭到襲擊。\r\n　\r\n"},{"kind":"control","value":2},{"kind":"text","text":"趙雲"},{"kind":"control","value":1},{"kind":"text","text":"負責保護"},{"kind":"control","value":2},{"kind":"text","text":"劉備"},{"kind":"control","value":1},{"kind":"text","text":"的夫人，\r\n以及兒子"},{"kind":"control","value":2},{"kind":"text","text":"阿斗"},{"kind":"control","value":1},{"kind":"text","text":"（後來的"},{"kind":"control","value":2},{"kind":"text","text":"劉禪"},{"kind":"control","value":1},{"kind":"text","text":"），\r\n卻在混戰之中，\r\n與他們失散了。"}],"大焦熱の書を手に入れた":[{"kind":"text","text":"獲得"},{"kind":"control","value":3},{"kind":"text","text":"大焦熱之書"},{"kind":"control","value":1}],"これ以上倉庫に蓄えておけない！！\n大焦熱の書をあきらめた":[{"kind":"text","text":"倉庫無法再存放物品了！！\n放棄"},{"kind":"control","value":3},{"kind":"text","text":"大焦熱之書"},{"kind":"control","value":1}],"大焦熱の書ﾀﾞｲｼｮｳﾈﾂﾉｼｮ\nを手に入れた":[{"kind":"text","text":"獲得"},{"kind":"control","value":3},{"kind":"text","text":"大焦熱之書"},{"kind":"control","value":1}],"これ以上倉庫に蓄えておけない！！\n大焦熱の書ﾀﾞｲｼｮｳﾈﾂﾉｼｮ\nをあきらめた":[{"kind":"text","text":"倉庫無法再存放物品了！！\n放棄"},{"kind":"control","value":3},{"kind":"text","text":"大焦熱之書"},{"kind":"control","value":1}],"回復の麦を手に入れた":[{"kind":"text","text":"獲得"},{"kind":"control","value":3},{"kind":"text","text":"回復麥"},{"kind":"control","value":1}],"これ以上倉庫に蓄えておけない！！\n回復の麦をあきらめた":[{"kind":"text","text":"倉庫無法再存放物品了！！\n放棄"},{"kind":"control","value":3},{"kind":"text","text":"回復麥"},{"kind":"control","value":1}],"回復の麦ｶｲﾌｸﾉﾑｷﾞ\nを手に入れた":[{"kind":"text","text":"獲得