"「朶思王もやられ\n　ちゃったし…\n　":[{"kind":"text","text":"「連"},{"kind":"control","value":2},{"kind":"text","text":"朵思王"},{"kind":"control","value":1},{"kind":"text","text":"\n　也被打敗了……"}],"「何だか\n　気が滅入るわね":[{"kind":"control","value":1},{"kind":"text","text":"「總覺得\n　心情很低落。"}],"「ああ……。こうも負\n　けが込むと、さすが\n　に落ち込むな":[{"kind":"text","text":"「是啊……\n　接連吃敗仗，\n　實在令人沮喪。"}],"「孟獲様、\n　木鹿王を\n　お連れしました":[{"kind":"text","text":"「"},{"kind":"control","value":2},{"kind":"text","text":"孟獲"},{"kind":"control","value":1},{"kind":"text","text":"大王，\n　我把"},{"kind":"control","value":2},{"kind":"text","text":"木鹿王"},{"kind":"control","value":1},{"kind":"text","text":"\n　帶來了。"}],"「おいおい、　\n　どうした？\n　":[{"kind":"text","text":"「喂喂，\n　怎麼回事？"}],"「ずいぶんとしけた顔\n　をしているな\n　":[{"kind":"text","text":"「怎麼一副\n　愁眉苦臉的樣子？"}],"「南蛮王孟獲とも\n　あろうものが……\n　":[{"kind":"text","text":"「堂堂"},{"kind":"control","value":3},{"kind":"text","text":"南蠻王"},{"kind":"control","value":1},{"kind":"control","value":2},{"kind":"text","text":"孟獲"},{"kind":"control","value":1},{"kind":"text","text":"，\n　竟然這副模樣……"}],"「それほど孔明とは\n　すごい奴なのか？":[{"kind":"control","value":1},{"kind":"text","text":"「那個"},{"kind":"control","value":2},{"kind":"text","text":"孔明"},{"kind":"control","value":1},{"kind":"text","text":"，\n　真有這麼厲害嗎？"}],"「うむ……。朶思王も\n　やられてしまった":[{"kind":"text","text":"「嗯……\n　連"},{"kind":"control","value":2},{"kind":"text","text":"朵思王"},{"kind":"control","value":1},{"kind":"text","text":"\n　也被打敗了。"}],"「孟獲、\n　いつもの威勢はどう\n　した？":[{"kind":"text","text":"「"},{"kind":"control","value":2},{"kind":"text","text":"孟獲"},{"kind":"control","value":1},{"kind":"text","text":"，\n　你平日的威風\n　都到哪裡去了？"}],"「わしが来ればもう安\n　心だ。わしの軍は猛\n　獣だらけだ":[{"kind":"control","value":1},{"kind":"text","text":"「有我在就放心吧！\n　我軍中盡是猛獸。"}],"「いかに\n　蜀軍といえど、\n　":[{"kind":"control","value":1},{"kind":"text","text":"「就算是蜀軍，"}],"「猛獣を相手に戦える\n　わけがなかろう\n　":[{"kind":"control","value":1},{"kind":"text","text":"「也不可能\n　與猛獸交戰吧！"}],"「さあ、\n　元気を出さんか！\n　":[{"kind":"control","value":1},{"kind":"text","text":"「來，\n　振作起來！"}],"「わしの好敵手ともあ\n　ろう者が\n　情けないぞ！":[{"kind":"control","value":1},{"kind":"text","text":"「身為我的勁敵，\n　這樣可太不像話了！"}],"「そ、そうだな\n　\n　":[{"kind":"text","text":"「說、說得也是。"}],"「よし！\n　じゃあ、\n　もう一度戦うぞ！":[{"kind":"text","text":"「好！\n　那就\n　再戰一場！"}],"銀坑洞　会議場":[{"kind":"text","text":"銀坑洞　議事廳"}],"「丞相…\n　\n　":[{"kind":"text","text":"「丞相……"}],"「孟獲は八納洞主の\n　木鹿王に援軍を\n　頼んだようです":[{"kind":"text","text":"「"},{"kind":"control","value":2},{"kind":"text","text":"孟獲"},{"kind":"control","value":1},{"kind":"text","text":"似乎向八納洞主\n　"},{"kind":"control","value":2},{"kind":"text","text":"木鹿王"},{"kind":"control","value":1},{"kind":"text","text":"\n　請求了援軍。"}],"「これはまずいことに\n　なりました":[{"kind":"control","value":1},{"kind":"text","text":"「這下麻煩了。"}],"「まずい？\n　なぜだ、\n　説明してくれぬか":[{"kind":"text","text":"「麻煩？\n　為甚麼？\n　能說明一下嗎？"}],"「はい\n　\n　":[{"kind":"text","text":"「是。"}],"「木鹿王は象に乗り、\n　法術を用いて風雨を\n　呼び起こします":[{"kind":"text","text":"「"},{"kind":"control","value":2},{"kind":"text","text":"木鹿王"},{"kind":"control","value":1},{"kind":"text","text":"騎著大象，\n　能用法術\n　呼風喚雨。"}],"「さらに、彼らの軍は\n　象や虎、毒蛇といっ\n　た猛獣を操り":[{"kind":"control","value":1},{"kind":"text","text":"「而且，聽說他們\n　還能驅使大象、\n　猛虎、毒蛇等猛獸，"}],"「敵を襲わせると聞い\n　ています\n　":[{"kind":"control","value":1},{"kind":"text","text":"「讓牠們\n　襲擊敵人。"}],"「まともな軍隊では\n　とうてい相手には\n　ならぬと":[{"kind":"control","value":1},{"kind":"text","text":"「以尋常軍隊，\n　恐怕根本無法\n　與他們抗衡，"}],"「思いますが……":[{"kind":"control","value":1},{"kind":"text","text":"「在下如此認為……"}],"「なるほどな……":[{"kind":"text","text":"「原來如此……"}],"「では、\n　出陣するのでしたら\n　私にお話し下さい":[{"kind":"text","text":"「那麼，\n　若要出陣，\n　請來找我。"}],"「長らく戦場を\n　往来してきましたが\n　":[{"kind":"text","text":"「我征戰沙場\n　已經多年，"}],"「猛獣を使う軍隊は初\n　耳です":[{"kind":"text","text":"「卻從未聽說過\n　使用猛獸的軍隊。"}],"「何と言うか……\n　\n　":[{"kind":"text","text":"「該怎麼說呢……"}],"「さすがは南蛮、\n　といった\n　ところですか":[{"kind":"text","text":"「也只能說，\n　不愧是"},{"kind":"control","value":3},{"kind":"text","text":"南蠻"},{"kind":"control","value":1},{"kind":"text","text":"吧。"}],"「私は虎も蛇も\n　恐れませんが…\n　":[{"kind":"text","text":"「我並不怕\n　猛虎和毒蛇……"}],"「兵士たちは\n　どうでしょうか？":[{"kind":"text","text":"「可士兵們\n　又會怎樣呢？"}],"「恐るべき\n　敵でございますな":[{"kind":"text","text":"「真是可怕的敵人。"}],"「とんでもない軍隊が\n　あったものです":[{"kind":"text","text":"「竟然還有\n　這樣的軍隊。"}],"「象……\n　でございますか？\n　":[{"kind":"text","text":"「您是說……\n　大象嗎？"}],"「どういう軍隊\n　なのでしょう":[{"kind":"text","text":"「究竟是\n　怎樣的軍隊呢？"}],"「たとえ猛獣が\n　相手でも\n　戦ってみせます":[{"kind":"text","text":"「即使對手是猛獸，\n　我也照樣迎戰！"}],"「とてもかなうような\n　相手ではありません\n　ぞ":[{"kind":"text","text":"「那可不是\n　我們能對付的敵人！"}],"「それがしが\n　魏に仕えていた頃、\n　":[{"kind":"text","text":"「在下昔日\n　效力於魏時，"}],"「呉より象が贈られて\n　来たのを見たことが\n　ありますが……":[{"kind":"text","text":"「倒是曾見過\n　吳國送來的大象……"}],"「実はそれがし、蛇が\n　苦手でございます":[{"kind":"text","text":"「其實在下\n　很怕蛇。"}],"「丞相、\n　出陣しますか？":[{"kind":"text","text":"「丞相，\n　要出陣嗎？"}],"「これより南蛮の本拠\n　を攻める\n　":[{"kind":"text","text":"「現在開始\n　進攻"},{"kind":"control","value":3},{"kind":"text","text":"南蠻"},{"kind":"control","value":1},{"kind":"text","text":"的本營。"}],"「敵には猛獣部隊もい\n　るという\n　気を抜くな！":[{"kind":"control","value":1},{"kind":"text","text":"「聽說敵軍有\n　猛獸部隊，\n　切勿大意！"}],"禿竜洞":[{"kind":"text","text":"禿龍洞"}],"禿竜洞の幕舎に行く":[{"kind":"text","text":"前往禿龍洞的營帳"}],"禿竜洞　蜀軍幕舎":[{"kind":"text","text":"禿龍洞　蜀軍營帳"}],"馬謖に出陣を告げる":[{"kind":"text","text":"告知馬謖準備出陣"}],"「木鹿王、頼んだぞ！":[{"kind":"text","text":"「"},{"kind":"control","value":2},{"kind":"text","text":"木鹿王"},{"kind":"control","value":1},{"kind":"text","text":"，拜託了！"}],"「わははは、\n　任せておけ！\n　":[{"kind":"text","text":"「哇哈哈哈，\n　交給我吧！"}],"「我らが\n　猛獣部隊の力、\n　":[{"kind":"text","text":"「我軍猛獸部隊的\n　威力，"}],"「蜀軍に思い知らせて\n　やる":[{"kind":"text","text":"「就讓蜀軍\n　好好領教吧！"}],"「あれが\n　猛獣の部隊か？":[{"kind":"text","text":"「那就是\n　猛獸部隊嗎？"}],"「ひっ、ひええ！\n　蛇だ！　\n　蛇が出たあ！":[{"kind":"text","text":"「哇、哇啊！\n　蛇啊！\n　有蛇啊！"}],"「なんだ、あの\n　白い動物は？\n　":[{"kind":"text","text":"「那白色的動物\n　是甚麼？"}],"「熊よりも\n　遥かに大きいぞ！":[{"kind":"text","text":"「比熊還要\n　大得多啊！"}],"「ぞう？\n　あの化け物が\n　象なのか！？":[{"kind":"text","text":"「大象？\n　那個怪物\n　就是大象嗎！？"}],"「兵士どもが\n　怯えています\n　":[{"kind":"text","text":"「士兵們\n　都嚇壞了。"}],"「このままでは\n　不利です！":[{"kind":"text","text":"「這樣下去，\n　對我軍不利！"}],"「うむむ……":[{"kind":"text","text":"「唔……"}