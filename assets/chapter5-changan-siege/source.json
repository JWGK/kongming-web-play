れ\n　てしまったか\n「ここが落ちれば\n　兵士や民衆は激しく\n　動揺するだろう\n「ええぃ、奇跡は\n　起きぬものか"]]],"5:0:48:17966":["一、",[2],"曹爽",[1],"の撃破"],"5:0:0:17983":[[133,["「い、いかん！\n　逃げろっ！とにかく\n　逃げるのだッ！"]],[4,["「軟弱な奴め\n　これで",[3],"長安",[1],"は\n　落ちたな"]]],"5:0:11:18057":["姜維はレベルが上がった！"],"5:0:0:18076":[[133,["「か、かなわん！\n　逃げろっ！"]],[7,["「逃げたか\n　これで",[3],"長安",[1],"は\n　いただきだ"]]],"5:0:11:18132":["魏延はレベルが上がった！"],"5:0:0:18151":[[133,["「逃げろっ！\n　逃げるのだッ！"]],[475,["「",[2],"曹爽",[1],"様！\n　ち、",[3],"長安",[1],"を\n　捨てるのですか！？"]],[133,["「つべこべ言うなっ！\n　とにかく\n　逃げるのだッ！"]]],"5:0:0:18253":[[0,["「ふぅ……"]]],"5:0:0:18266":[[4,["「丞相。",[3],"成都",[1],"から\n　勅状が届いて\n　おります\n「何でも一刻を争うと\n　のこと"]],[0,["「一刻を争う？\n　",[3],"成都",[1],"で何か\n　起きたのか？\n「どれ……"]]],"5:0:0:18377":[[0,["「",[2],"孟獲",[1],"が……\n　",[3],"南蛮",[1],"勢を率いて攻め\n　込んできたそうだ"]],[21,["「何とっ！行方知れず\n　になっていた\n　",[2],"孟獲",[1],"がッ！"]]],"5:0:0:18472":[[7,["（だから、斬っておけ\n　ばよかったのだ！　\n　丞相の失策だな"]]],"5:0:0:18516":[[0,["「呉が……\n　同盟を破り、\n　攻め込んできた\n「すでに",[3],"白帝城",[1],"は\n　落ちたそうだ"]],[21,["「おのれっ！\n　またしても\n　呉の裏切りか！"]]],"5:0:0:18612":[[0,["「このままでは",[3],"成都",[1],"も\n　危うい。……しかた\n　あるまい\n「",[3],"武功",[1],"と",[3],"城",[1],"に\n　守備兵を残して撤退\n　することにする"]],[4,["「撤退で\n　ございますか……\n　丞相、無念です"]],[0,["「嘆くことはない\n　",[3],"城",[1],"の辺りは\n　地勢が険しく\n「少数の兵でも\n　守備が可能だ\n　\n「",[3],"武功",[1],"・",[3],"城",[1],"の一帯を\n　確保できていれば、\n　\n「再び",[3],"長安",[1],"を攻める\n　ことは難しくない"]],[4,["「おお……\n　それを聞いて\n　安心いたしました"]]],"5:0:0:18920":[[0,["「しかし、\n　ことは一刻を争う\n　\n「直ちに南西の砦まで\n　撤退だ！"]]],"5:0:48:18973":["一、",[2],"孔明",[1],"が南西の砦に入る\r\n二、敵部隊の全滅"],"5:0:0:19013":[[124,["「おおッ、蜀軍が\n　引き上げていく！\n　これこそ奇跡……\n「追撃！　追撃だッ！"]],[135,["「",[2],"孔明",[1],"が\n　逃げて行くぞ！\n　追えッ！"]]],"5:0:11:19111":["勝利条件変更！"],"5:0:0:19125":[[20,["「わぁぁっ！"]]],"5:0:0:19137":[[124,["「蜀将",[2],"廖化",[1],"を\n　討ち取った！"]],[0,["「",[2],"廖化",[1],"が…\n　死んだか…"]]],"5:0:0:19194":[[134,["「",[2],"孔明",[1],"を\n　生きて帰すな！\n　突撃だッ！"]]],"5:0:0:19233":[[0,["「よし！\n　",[3],"城",[1],"へ退却だ！"]]],"5:0:0:19261":[[0,["「これで当分は\n　追って来れまい\n　よし！　退却だ！"]]],"5:0:11:19302":["金５００を手に入れた！"],"5:0:0:19320":[[0,["「いったん\n　",[3],"城",[1],"に向かう"]]],"5:0:11:19347":["城　会議場"],"5:0:0:19360":[[0,["「",[3],"長安",[1],"を目前にして\n　無念ではあるが…\n　\n「",[3],"成都",[1],"へ\n　一時退却する"]],[4,["「丞相、全軍で",[3],"成都",[1],"に\n　戻るのですか？"]],[0,["「そういうわけにも\n　いくまい\n　\n「",[3],"城",[1],"・",[3],"武功",[1],"の守備も\n　あるからな\n　\n「そうだな……\n　六武将、\n　ここに残そう\n「",[2],"姜維",[1],"、そなたは私と\n　ともに",[3],"成都",[1],"に向かう\n　ことにする"]],[4,["「それでは、\n　守備に残す武将を\n　お決め下さい"]]],"5:0:48:19635":["城に残す武将を六人選択する"],"5:0:0:19659":[[6,["「",[3],"城",[1],"の守りは\n　お任せ下さい\n　\n「まだまだ若者には\n　負けませぬぞ"]]],"5:0:0:19716":[[6,["「私が",[3],"城",[1],"に\n　残るのですか？"]]],"5:0:0:19746":[[6,["「かしこまりました\n　まだまだ若者には\n　負けませぬぞ"]]],"5:0:0:19784":[[7,["「丞相、任せて下さい\n　魏軍を防いでみせま\n　しょう"]]],"5:0:0:19825":[[7,["「それがしが\n　この",[3],"城",[1],"に\n　残るのですか？"]]],"5:0:0:19862":[[7,["「かしこまりました\n　魏軍を防いでみせま\n　しょう"]]],"5:0:0:19898":[[14,["「私は、この一帯の\n　地理をよく知って\n　おります\n「私にお任せ下さい\n　魏軍を震え上がらせ\n　てみせます"]]],"5:0:0:19975":[[14,["「私が守備に\n　残るのですか？"]]],"5:0:0:20001":[[14,["「かしこまりました\n　魏軍を震え上がらせ\n　てみせます"]]],"5:0:0:20040":[[10,["「",[3],"城",[1],"の守りは\n　お任せ下さい\n　どうかご心配なく"]]],"5:0:0:20084":[[10,["「それがしが",[3],"城",[1],"に\n　残るのですか？"]]],"5:0:0:20116":[[10,["「かしこまりました\n　どうかご心配なく"]]],"5:0:0:20144":[[8,["「",[3],"城",[1],"の守りは\n　お任せ下さい\n　死守してみせます"]]],"5:0:0:20188":[[8,["「私が残るのですか？"]]],"5:0:0:20206":[[8,["「かしこまりました\n　",[3],"城",[1],"を死守して\n　みせます"]]],"5:0:0:20246":[[21,["「",[3],"城",[1],"の守りは\n　お任せ下さい\n　丞相、ご安心を"]]],"5:0:0:20291":[[21,["「私がここに\n　残るのですか？"]]],"5:0:0:20315":[[21,["「かしこまりました\n　丞相、ご安心を"]]],"5:0:0:20344":[[9,["「",[3],"城",[1],"の守りは\n　お任せ下さい\n　\n「全力をもって\n　守ります"]]],"5:0:0:20397":[[9,["「それがしが\n　この",[3],"城",[1],"に\n　残るのですか？"]]],"5:0:0:20434":[[9,["「かしこまりました\n　全力をもって\n　守ります"]]],"5:0:0:20468":[[11,["「",[3],"城",[1],"の守りは\n　お任せ下さい\n　\n「敵軍は一歩も\n　通しませぬぞ"]]],"5:0:0:20525":[[11,["「私が守備隊として\n　残るのですか？"]]],"5:0:0:20555":[[11,["「かしこまりました\n　敵軍は一歩も\n　通しませぬぞ"]]],"5:0:0:20593":[[18,["「",[3],"城",[1],"の守りは\n　お任せ下さい\n　精一杯がんばります"]]],"5:0:0:20639":[[18,["「この私が守備に\n　残るのですか？"]]],"5:0:0:20667":[[18,["「かしこまりました\n　精一杯がんばります"]]],"5:0:0:20697":[[15,["「",[3],"城",[1],"の守りは\n　お任せ下さい\n　どうぞご心配なく"]]],"5:0:0:20741":[[15,[