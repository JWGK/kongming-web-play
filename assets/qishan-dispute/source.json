「そうだな……"]]],"4:0:0:10784":[[4,["「…………丞相？\n　お体の具合が悪いの\n　ではありませんか？\n「お顔の色も優れない\n　ご様子。あまり無理\n　をなさっては……"]],[0,["「いや、\n　大丈夫だ……\n　\n「今はそんなことを\n　言っている場合では\n　ない\n「余計な心配はするな"]]],"4:0:0:10949":[[4,["「そ、そうですか\n　失礼いたしました"]]],"4:0:0:10976":[[0,["「それでは……\n　",[3],"長安",[1],"……へ……"]]],"4:0:0:11011":[[4,["「丞相、ここは一気に\n　",[3],"長安",[1],"へ進軍いたしま\n　しょう"]],[0,["「そうだな。そうする\n　としよう……\n　おや？"]]],"4:0:0:11088":[[464,["「申し上げます\n　\n　\n「",[3],"漢中",[1],"にて療養して\n　おられた\n　",[2],"趙子龍将軍",[1],"が……\n「治療の甲斐なく\n　先日、亡くなられ\n　ました……"]],[0,["「な、なにッ！\n　……",[2],"趙雲",[1],"が、",[2],"趙雲",[1],"が\n　死んだと…申すか！"]],[464,["「……はい\n　\n　\n「年齢による衰えも\n　ございましたが、\n　\n「やはり\n　先の北伐での負傷が\n　響いたようで…"]]],"4:0:0:11328":[[0,["「",[2],"趙雲",[1],"が、\n　死んだ……\n　\n「私は、いや漢は、\n　その片腕を失った\n　ようなものだ……\n「何という\n　ことだ……\n　ああっ………！"]]],"4:0:0:11430":[[7,["「あっ！　丞相！"]]],"4:0:0:11447":[[4,["「丞相！\n　お気を確かに！"]]],"4:0:8:11471":[[2],"孔明",[1],"は倒れた。南征・北伐と続\r\nく戦いによる激務のため、体が\r\n著しく疲労していたのである\r\n蜀軍は",[3],"長安",[1],"をめざす直前で北伐\r\nを断念し、",[3],"漢中",[1],"へ引き上げた\r\n　\r\nこれまで",[3],"漢中",[1],"に留まっていた\r\n",[2],"孔明",[1],"は、",[3],"成都",[1],"へ帰還することに\r\nなった"],"4:0:8:11651":[[2],"孔明",[1],"は倒れた。北伐の激務によ\r\nる疲労そして",[2],"趙雲",[1],"の死による心\r\nへの衝撃のためである\r\n蜀軍は",[3],"長安",[1],"をめざす直前で北伐\r\nを断念し、",[3],"漢中",[1],"へ引き上げて\r\nいった\r\nこれまで",[3],"漢中",[1],"に留まっていた\r\n",[2],"孔明",[1],"は、",[3],"成都",[1],"へ帰還することに\r\nなった"],"4:0:11:10652":["祁山"],"4:0:11:10657":["祁山　蜀軍幕舎"],"4:1:0:58":[[99,["「陛下\n　\n　\n「",[2],"孔明",[1],"が病のために\n　",[3],"成都",[1],"に帰還したこと\n　をご存じですか？"]],[98,["「おお、\n　その話は聞いた"]],[99,["「この機会に",[3],"漢中",[1],"を\n　攻略すべきです\n　\n「",[2],"孔明",[1],"さえ\n　いなければ、\n　\n「蜀の軍勢など\n　ものの数では\n　ございません"]],[98,["「うむ……\n　おお、",[2],"司馬懿",[1],"も\n　来たようだな"]]],"4:1:0:275":[[96,["「陛下、\n　ただいま",[3],"荊州",[1],"より\n　戻りました"]],[98,["「ご苦労\n　呉の様子は\n　どうであった？"]]],"4:1:0:344":[[96,["「呉と蜀との同盟は、\n　表面上だけです\n　\n「本腰を入れて\n　蜀を助けよう\n　という動きは\n「見受けられませんで\n　した"]],[98,["「そうか\n　実は",[2],"曹真",[1],"が、\n　",[2],"孔明",[1],"のいない隙に\n「",[3],"漢中",[1],"を攻めよ、\n　と申しておるのだ\n　\n「",[2],"司馬懿",[1],"\n　お前はどう思うか？"]],[96,["「そうですな\n　私もその意見に\n　賛成でございます"]],[98,["「おお、",[2],"司馬懿",[1],"も\n　そう思うか"]],[96,["「",[2],"孔明",[1],"こそが\n　蜀の要です\n　\n「",[2],"孔明",[1],"がいなければ、\n　蜀はただの小国\n　\n「何も恐れることは\n　ありません\n　\n「背後の呉も\n　動く気配はなし…\n　\n「絶好の機会かと\n　存じます"]],[98,["「うむ、それを聞いて\n　安心した"]]],"4:1:0:759":[[98,["「",[2],"曹真",[1],"、そなたを\n　総大将に任ずる\n　\n「",[2],"司馬懿",[1],"よ、\n　",[2],"劉曄ﾘｭｳﾖｳ",[1],"と\n　ともに",[3],"陳倉",[1],"に向かい\n「",[2],"曹真",[1],"を補佐せよ\n　今こそ好機である\n　",[3],"漢中",[1],"を攻略せよ！"]]],"4:1:0:898":[[99,["「ははーっ\n　吉報をお待ち下さい\n　ませ"]]],"4:1:0:931":[[99,["「全軍、",[3],"陳倉",[1],"まで\n　進軍せよ！\n　最終目標は",[3],"漢中",[1],"だ！"]]],"4:1:0:1001":[[23,["「丞相\n　もう、体は\n　大丈夫なのか？"]]],"4:1:0:1034":[[0,["「陛下にまでご心配を\n　おかけいたしまして\n　\n「申し訳ありませんで\n　した。もう、大丈夫\n　でございます"]],[23,["「そうか\n　丞相に何かあったら\n　\n「我らは\n　生きるすべを失って\n　しまうだろう\n「丞相も決して若くは\n　ないのだから\n　\n「体には十分気をつけ\n　てくれ"]],[0,["「はい\n　ありがとう\n　ございます"]]],"4:1:0:1236":[[0,["「陛下\n　\n　\n「また",[3],"漢中",[1],"に戻って\n　北伐を再開しようと\n　思います\n「お許しを\n　いただけますか？"]],[23,["「えっ！\n　まだ、病が治った\n　ばかりであろう\n「無理をすると\n　また再発しないか？"]]],"4:1:0:1370":[[15,["「そうです。",[3],"漢中",[1],"の\n　守備は残してきた\n　武将たちに任せて…\n「丞相は、ゆっくりと\n　養生なさって\n　下さいませ"]]],"4:1:0:1455":[[16,["「",[2],"蒋",[1],"殿の\n　言う通りです\n　\n「丞相こそ、漢の至宝\n　なのですから"]]],"4:1:0:1513":[[0,["「その気持ちは\n　ありがたい\n　しかし、\n「魏は私の本復を\n　待ってはくれぬ\n　\n「すぐにも",[3],"漢中",[1],"に兵を\n　進めるであろう\n　\n「魏には\n　",[2],"司馬懿",[1],"がいる\n　\n「彼の縦横無尽の策謀\n　に対抗できる人物は\n　そう多くはいない"]],[16,["「…………"]]],"4:1:0:1690":[[0,["「",[2],"司馬懿",[1],"に対抗できる\n　のは……\n　\n「今は亡き",[2],"統",[1],"、\n　あるいは",[2],"徐庶",[1],"、\n　呉の",[2],"陸遜",[1],"\n「そして……\n　私ぐらいだろう"]]],"4:1:0:1796":[[0,["「",[2],"司馬懿",[1],"に対抗できる\n　のは……\n　\n「",[2],"統",[1],"、あるいは",[2],"徐庶",[1],"\n　呉の",[2],"陸遜",[1],"……\n　\n「そして……\n　私ぐらいだろう"]]],"4:1:0:1899":[[15,["「確かに……"]],[16,["「それは……\n　その通りとは\n　思いますが……"]],[23,["「どうやら丞相の\n　申す通りらしい\n　\n「……丞相、\n　苦労をかけて\n　すまぬな"]],[0,["「いえ、\n　先帝の遺志を成し\n　遂げるためならば、\n「どんな苦労も\n　いとうものでは\n　ありません\n「それでは、\n　",[3],"漢中",[1],"に出発します"]]],"4:1:0:2101":[[36,["「丞相、\n　お体には十分\n　お気をつけ下さい\n「ご無理を\n　なさらずに"]],[0,["「うむ、ありがとう"]]],"4:1:0:2168":[[23,["「丞相、待ちたまえ\n　家族には、\n　そのことを……\n「出陣のことを\n　話したのか？"]]],"4:1:0:2229":[[0,["「いえ……"]],[23,["「それはいかん\n　また長い間、家を\n　空けるのだし……\n「そなたのことだ、\n　黙っていれば\n　\n「家族にも会わずに、\n　",[3],"漢中",[1],"まで行って\n　しまうことだろう"]],[0,["「いや、その……\n　……一言も\n　ございません"]],[23,["「家族に\n　会う時間ぐらい\n　無理してでも作れ\n「……これは、\n　朕の命令だ\n　\n「家族に会ってから\n　",[3],"漢中",[1],"に向かえ\n　よいな"]]],"4:1:0:2481":[[0,["「はい……\n　では、家族に会って\n　参ります"]]],"4:1:0:2535":[[23,["「家族に会ってから\n　出発せよ\n　これは、朕の命令だ"]]],"4:1:0:2577":[[15,["「陛下のおっしゃる通\n　りです。ご家族とお\n　会いになってから\n「",[3],"漢中",[1],"へ向かって\n　下さいませ"]]],"4:1:0:2648":[[16,["「丞相、\n　お体には十分\n　お気をつけ下さい\n「丞相は\n　漢の至宝なのです"]]],"4:1:0:2707":[[35,["「",[3],"成都",[1],"の\n　武器屋・道具屋には\n　\n「それなりのものが\n　そろっております\n　\n「途中でお寄りになっ\n　てはいかがですか？"]]],"4:1:0:2797":[[36,["「丞相、これを\n　受け取って下さい"]]],"4:1:0:2826":[[36,["「もう少し",[3],"成都",[1],"で養生\n　なさった方がよいの\n　では……？"]]],"4:1:0:2885":[[0,["「すまないな\n　いつも家を空けて\n　ばかりで……"]],[490,["「家のことは\n　気になさらないで\n　ただ……、\n「体にだけは気をつけ\n　て下さいね"]],[0,["「ああ"]]],"4:1:0:2984":[[490,["「ほら、",[2],"瞻",[1],"\n　お父様にご挨拶は？"]],[504,["「うん"]]],"4:1:0:3023":[[504,["「父上、\n　行ってらっしゃいま\n　せ！"]]],"4:1:0:3053":[[0,["「ほう、もうこんな言\n　葉使いができるよう\n　になったか\n「大きくなった\n　ものだな"]]],"4:1:0:3109":[[490,["「あなたの\n　いらっしゃらない間\n　\n「いろんなことを教え\n　ようと思っているん\n　ですよ\n「剣術や馬術、兵法、\n　それから……"]],[0,["「ははは……\n　あまり一度にいろい\n　ろやろうとしても\n「身には付かないだろ\n　う。多くの短所を直\n　そうとするよりも、\n「一つの長所を伸ばし\n　ていった方がよい"]],[490,["「そうですわね\n　\n　\n「それでは、この子に\n　何をさせればよいと\n　思われます？"]],[0,["「そうだな\n　ちょっと考えて\n　みよう"]]],"4:1:0:3410":[[0,["「…………"]],[504,["「父上、\n　どうしたの？"]],[0,["「",[2],"瞻",[1],"…。お前は\n　将来どんなことを\n　やってみたいのだ？"]],[504,["「まだ、よくわかんな\n　いけど…\n　\n「父上のお役に\n　立てるようなこと！"]],[0,["「そうか……"]]],"4:1:0:3549":[[504,["「早く父上の\n　お役に立てるように\n　なりたいなぁ～"]]],"4:1:0:3589":[[490,["「あなた、この子に\n　何をさせればよいと\n　思います？\n「お決まりに\n　なりました？"]]],"4:1:0:3698":[[490,["「兵法…ですか？\n　\n　\n「きっと、あなたのよ\n　うな聡明な子になる\n　でしょうね\n「わかりましたわ"]]],"4:1:0:3766":[[490,["「剣術…ですか？\n　\n　\n「そうですね、まだま\n　だ魏との戦いは続く\n　でしょうから……\n「わかりましたわ"]]],"4:1:0:3839":[[490,["「馬術…ですか？\n　\n　\n「そういえば、先帝は\n　馬術に巧みだったと\n　か\n「あやかりたいですね\n　わかりましたわ"]]],"4:1:0:3917":[[490,["「そうですね…\n　まだ小さいの\n　だから……\n「いろんなことに\n　興味があるで\n　しょうし…"]]],"4:1:0:3981":[[4,["「丞相、\n　失礼いたします\n　\n「魏の",[2],"曹真",[1],"が",[2],"司馬懿",[1],"と\n　ともに、",[3],"陳倉",[1],"に入っ\n　たそうです"]]],"4:1:0:4061":[[0,["「さっそく来たか\n　",[2],"姜維",[1],"、諸将を会議場\n　に集めてくれ\n「私もすぐに行く"]]],"4:1:0:4121":[[4,["「はっ"]]],"4:1:0:4146":[[490,["「行って\n　らっしゃいませ\n　\n「どうかご無事で……"]]],"4:1:0:4186":[[504,["「父上、\n　行ってらっしゃい！"]]],"4:1:0:4224":[[7,["「丞相\n　お体の具合はもう\n　よろしいのですか？"]]],"4:1:0:4261":[[8,["「そうです\n　あまり、ご無理をな\n　さらないで下さい"]],[0,["「そなたたちの気持ち\n　はありがたいが、\n　気遣いは無用だ\n「それよりも、\n　\n　\n「魏軍が",[3],"陳倉",[1],"に\n　向かったことはもう\n　知っているだろう"]]],"4:1:0:4396":[[9,["「はい\n　",[2],"曹真",[1],"が総大将として\n　軍を率いております\n「",[2],"司馬懿",[1],"も\n　来ているそうです"]],[0,["「うむ\n　\n　\n「奴らは私が病に倒れ\n　たと聞いて",[3],"漢中",[1],"を\n　奪いに来たのだ\n「",[3],"漢中",[1],"は蜀の喉元とも\n　いえる地だ。魏に渡\n　すわけにはいかぬ"]]],"4:1:0:4572":[[10,["「その通りです\n　",[3],"漢中",[1],"を奪われては、\n　\n「蜀は滅亡の危機に\n　さらされることに\n　なります"]],[0,["「よし、\n　",[3],"漢中",[1],"へ出陣だ！\n　\n「魏の魔手から",[3],"漢中",[1],"を\n　蜀を守るのだ！"]]],"4:1:0:4704":[[4,["「はっ！"]]],"4:1:0:4732":[[99,["「なにっ！\n　",[2],"孔明",[1],"が",[3],"漢中",[1],"に\n　来ただと！"]],[115,["「はい\n　まれにみる迅速さと\n　言えます"]],[99,["「むむむ……\n　確か",[2],"孔明",[1],"は病に冒さ\n　れていたはずだが\n「これはいったい\n　どういう\n　ことだろう？"]]],"4:1:0:4872":[[96,["「謹厳実直な\n　",[2],"孔明",[1],"のことです\n　\n「我らの動きを\n　予測して、\n　\n「病をおして\n　",[3],"漢中",[1],"に来たものと\n　思われます"]],[99,["「ふむ……。",[2],"孔明",[1],"も病\n　が完治しているわけ\n　ではないだろうな"]],[96,["「",[2],"孔明",[1],"の病が完全に\n　癒えていないのな\n　らば……\n「こちらが\n　付け入る隙は充分に\n　ありますな…"]],[99,["「よし！　\n　",[3],"斜谷",[1],"を通って\n　",[3],"漢中",[1],"に出陣する\n「全軍、直ちに出陣の\n　準備をいたせ！"]]],"4:1:0:5165":[[96,["「はっ"]]],"4:1:0:5174":[[99,["「この桟道さえ通れば\n　すぐに",[3],"漢中",[1],"にたどり\n　着くぞ\n「……おや？\n　雨……か…？"]]],"4:1:0:5433":[[96,["「長期の足止めにより\n　兵士は疲弊\n　\n「衛生状態も悪く、\n　病人が増え続けて\n　います"]],[114,["「兵糧も底をつきそう\n　です\n　\n「桟道の各所が雨のた\n　めに寸断されて、\n　\n「輸送がままならない\n　のです"]],[99,["「むむむ。これでは、\n　いかんとも\n　しがたいな\n「しかたがない…\n　",[3],"陳倉",[1],"まで\n　退却しよう"]]],"4:1:0:5647":[[96,["「はっ"]]],"4:1:0:5656":[[99,["「自然には勝てぬとい\n　うことか\n　",[3],"陳倉",[1],"まで退却せよ"]]],"4:1:0:5719":[[18,["「丞相\n　どうやら魏軍は\n　撤退したようです"]],[0,["「そうか。この長雨で\n　兵士の士気が落ちた\n　のだろう"]]],"4:1:0:5795":[[7,["「では、追撃いたしま\n　しょう！\n　\n「今ならば、\n　確実に勝利を\n　得られますぞ！"]],[0,["「いや、\n　",[2],"司馬懿",[1],"のことだ\n　\n「撤退したとはいえ、\n　防備は完璧だろう\n　\n「ここは",[3],"祁山",[1],"に向かう\n　方がよい。全軍、\n　",[3],"祁山",[1],"へ進軍する"]]],"4:1:0:5967":[[0,["「全軍、",[3],"祁山",[1],"に向け\n　進軍せよ！"]]],"4:1:0:6016":[[99,["「いまだ蜀軍の追撃は\n　ないのか？"]],[114,["「はい、一向に\n　蜀軍の影も形も\n　見えませぬ"]],[99,["「そうか……。蜀軍も\n　同じように苦しんで\n　いるのだろう\n「追撃を受けることは\n　ないか"]]],"4:1:0:6142":[[96,["「いえ、\n　それは違います\n　\n「我々が後退した隙を\n　ついて",[3],"祁山",[1],"に出てく\n　るでしょう"]],[99,["「しかし、",[2],"司馬懿",[1],"\n　敵に進出するつもり\n　があるのなら……\n「我が軍のこの状況を\n　見逃すはずがない\n　\n「必ず追撃してくるは\n　ずだ。それが今まで\n　ないのだから、\n「蜀軍が",[3],"祁山",[1],"に進出す\n　ることはあるまい"]],[96,["「……なるほど\n　\n　\n「では、\n　ここは一つ賭けを\n　いたしましょう"]]],"4:1:0:6408":[[99,["「賭けだと？"]],[96,["「蜀軍の追撃があると\n　仮定して\n　\n「",[3],"箕谷",[1],"と",[3],"斜谷",[1],"に戻って\n　兵を伏せるのです\n　\n「もし、\n　蜀軍が現れれば\n　それがしの勝ち\n「蜀軍が来なければ\n　",[2],"曹真",[1],"様の勝ち\n　\n「ということで\n　いかがでしょう？\n　\n「万一、蜀軍が\n　出て来た場合は\n　\n「その出鼻を叩くこと\n　ができますし…"]],[99,["「それはおもしろい\n　では、わしは",[3],"斜谷",[1],"へ\n　行くとしよう\n「わしが勝ったら\n　そなたは\n　どうするのだ？"]],[96,["「そのときは",[2],"曹真",[1],"様の\n　お言いつけ通りに\n　\n「何でも\n　いたしましょう\n　\n「女装して踊っても\n　よろしいですぞ"]]],"4:1:0:6785":[[99,["「わっはっはっはっ！\n　そうか、そうか\n　\n「では、軍を動かすと\n　しよう\n　\n「",[2],"司馬懿",[1],"、\n　負けたときは\n　覚悟しておけよ"]],[96,["「はい\n　それでは……"]]],"4:1:0:6891":[[99,["「",[2],"司馬懿",[1],"め、\n　大口をたたきおって\n　見ておれよ"]]],"4:1:0:6933":[[96,["「",[2],"孔明",[1],"は、必ず",[3],"祁山",[1],"に\n　出て来る\n　\n「全軍、\n　",[3],"箕谷",[1],"へ向け進軍せよ\n　気を抜くな！"]]],"4:1:0:7031":[[16,["「丞相、\n　魏軍は軍を\n　二手に分けました\n「",[3],"斜谷",[1],"には",[2],"曹真",[1],"が、\n　",[3],"箕谷",[1],"には",[2],"司馬懿",[1],"が\n　向かったようです"]],[0,["「",[2],"司馬懿",[1],"め、\n　打つ手が早い\n　\n「私が",[3],"祁山",[1],"に出ること\n　を読んだか"]]],"4:1:0:7188":[[15,["「丞相、\n　どういたしますか？"]],[0,["「我々も軍を二手に\n　分けるか…\n　\n「あるいは、\n　どちらかに\n　全軍を送るか……"]]],"4:1:0:7275":[[10,["「",[2],"曹真",[1],"と",[2],"司馬懿",[1],"では、\n　",[2],"司馬懿",[1],"の方が手強い\n　と思われます\n「",[2],"司馬懿",[1],"に我が全軍を\n　差し向ければ奴も\n　苦しむことでしょう"]]],"4:1:0:7385":[[14,["「いや\n　だからこそ、\n　",[2],"曹真",[1],"に主力を向け、\n「",[2],"曹真軍",[1],"を壊滅させて\n　しまう方がよい\n　\n「",[2],"司馬懿",[1],"には\n　牽制程度の兵で\n　よかろう"]]],"4:1:0:7496":[[11,["「でしたら、\n　",[2],"曹真",[1],"に主力を\n　差し向け、\n「まずは",[2],"曹真軍",[1],"を\n　壊滅させましょう"]]],"4:1:0:7565":[[4,["「丞相。",[2],"曹真",[1],"と",[2],"司馬懿",[1],"\n　のどちらに軍を向け\n　るかお考え下さい\n「お決まりに\n　なりましたら\n　私にお告げ下さい"]]],"4:1:0:7696":[[6,["「主力を\n　",[2],"曹真",[1],"に送り、\n　\n「",[2],"曹真軍",[1],"を\n　壊滅させることを\n　考えましょう"]]],"4:1:0:7764":[[7,["「戦うのでしたら、\n　\n　\n「強敵の",[2],"司馬懿",[1],"と\n　当たることに\n　しましょう"]]],"4:1:0:7823":[[14,["「",[3],"斜谷道",[1],"の",[2],"曹真",[1],"に\n　主力を送りましょう"]]],"4:1:0:7865":[[10,["「兵は",[2],"曹真",[1],"の方に\n　多くいるようです"]]],"4:1:0:7899":[[8,["「",[2],"曹真",[1],"など恐れる必要\n　はありますまい\n　\n「",[2],"曹真軍",[1],"を\n　叩きましょう"]]],"4:1:0:7961":[[21,["「",[2],"司馬懿",[1],"は危険です\n　",[2],"司馬懿",[1],"に全軍を\n　ぶつけましょう"]]],"4:1:0:8014":[[9,["「",[2],"司馬懿",[1],"は名将です\n　策もなく当たるのは\n　難しいかと"]]],"4:1:0:8061":[[11,["「",[2],"曹真",[1],"を倒せば、\n　魏の部隊は半減する\n　ことでしょう"]]],"4:1:0:8108":[[20,["「それがしは\n　どちらでも\n　かまいません"]]],"4:1:0:8137":[[15,["「丞相、\n　いかが\n　なさいますか？"]]],"4:1:0:8165":[[16,["「部隊を分けるとなる\n　と遊撃部隊は\n　苦戦必至ですな"]]],"4:1:0:8211":[[5,["「全軍で",[2],"曹真",[1],"を倒すの\n　が良策でしょう"]]],"4:1:0:8248":[[4,["「丞相、お決まりに\n　なりましたか？"]]],"4:1:0:8337":[[4,["「わかりました\n　\n　\n「",[3],"斜谷",[1],"の",[2],"曹真",[1],"勢に\n　我が主力を\n　ぶつけるのですね"]],[0,["「うむ\n　",[2],"曹真",[1],"には戦才がない\n　勝利は容易だ\n「遊撃隊の指揮は、\n　",[2],"魏延",[1],"に任せる\n　\n「",[2],"張嶷",[1],"と",[2],"馬忠",[1],"を\n　連れて行け"]]],"4:1:0:8507":[[7,["「ははっ！\n　それがしに\n　お任せ下さい"]],[0,["「",[2],"司馬懿",[1],"は強敵だ\n　十分に注意せよ\n　よし、出撃だ！"]]],"4:1:0:8584":[[4,["「わかりました\n　\n　\n「",[3],"箕谷",[1],"の",[2],"司馬懿",[1],"勢に\n　我が全軍を\n　ぶつけるのですね"]],[0,["「うむ\n　",[2],"司馬懿",[1],"は名将だ\n　\n「全力をもってでも\n　倒さねばならない\n　\n「",[2],"魏延",[1],"には、\n　先鋒を命じる\n　\n「",[2],"張嶷",[1],"と",[2],"馬忠",[1],"の二人を\n　配下として連れて\n　行くがよかろう"]]],"4:1:0:8787":[[7,["「ははっ！\n　お任せ下さい"]],[0,["「よし、出撃だ！"]]],"4:1:8:5241":["魏軍は、",[3],"斜谷道",[1],"から",[3],"漢中",[1],"に向か\r\nおうとしたが、天は",[2],"孔明",[1],"に味方\r\nした。一カ月にわたって大雨が\r\n降り続け、",[3],"斜谷",[1],"の桟道が崩れた\r\nため、魏軍は足止めを食ったの\r\nである\r\n備えのなかった魏軍は著しく\r\n疲弊し、それ以上の進軍を断念\r\nした"],"4:1:11:40":["洛陽"],"4:1:11:45":["洛陽　会議場"],"4:1:11:985":["成都"],"4:1:11:990":["成都　宮殿"],"4:1:11:2874":["成都　邸宅"],"4:1:11:4211":["成都　会議場"],"4:1:11:4714":["陳倉"],"4:1:11:4719":["陳倉　会議場"],"4:1:11:5418":["斜谷　魏軍幕舎"],"4:1:11:5701":["漢中"],"4:1:1