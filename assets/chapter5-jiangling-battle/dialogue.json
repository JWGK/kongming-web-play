{"version":"chapter5-jiangling-dialogue/1","contextIds":["5:1:13"],"texts":{"5:1:0:17934":[[149,["「",[3],"江陵",[1],"は、",[3],"荊州",[1],"を保つ\n　ためにはなくてはな\n　らぬ拠点だ\n「蜀に奪われるわけに\n　はいかぬ！"]],[155,["「はい\n　蜀軍に",[3],"江陵",[1],"を\n　取られれば\n「奴らに長江を制する\n　拠点を与えたことに\n　なります\n「我が水軍の行動は\n　制限され、\n　\n「蜀軍に上流から攻め\n　られれば",[3],"荊州",[1],"を放棄\n　せざるを得ません\n「それを考えれば、\n　やはり\n　\n「",[3],"江陵",[1],"が最終防衛拠点\n　と申せましょう"]],[152,["（",[2],"孔明",[1],"……\n　これも主命だ\n　……許せ"]],[0,["「呉軍も全力をあげて\n　反撃してこよう\n　油断せぬように！"]]],"5:1:0:18339":[[230,["「父上、",[3],"柴桑",[1],"より\n　援軍を連れて参りま\n　したぞ"]],[149,["「おお、",[2],"孫登",[1],"か"]]],"5:1:0:18400":[[155,["「全軍、陛下を\n　お守りするのだ！"]]],"5:1:0:18429":[[230,["「我こそは大呉の\n　皇太子",[2],"孫登",[1],"！\n　\n「そこの蜀将、\n　余と戦え！"]],[4,["「なにっ！\n　皇太子",[2],"孫登",[1],"？\n　\n（討ち取っては、\n　勝っても負けても\n　しこりが残る…\n（心して\n　かからねば……"]]],"5:1:0:18574":[[230,["「ぬぬっ！　不覚！\n　捕らわれる\n　とは……"]]],"5:1:0:18629":[[157,["「さすがは",[2],"魏延",[1],"、\n　見事だ……\n　ぐふっ！"]],[7,["「呉の名将",[2],"徐盛",[1],"を\n　討ち取ったぞ！"]],[149,["「な、なにっ！\n　",[2],"徐盛",[1],"が\n　討死しただと！\n「すまぬ、",[2],"徐盛",[1],"……\n　そなたの死は\n　朕の責任だ"]]],"5:1:0:18795":[[153,["「そなたが\n　",[2],"諸葛瞻",[1],"か！？\n　\n「我が名は",[2],"諸葛恪",[1],"、\n　字は",[2],"元遜ｹﾞﾝｿﾝ",[1],"\n　",[2],"諸葛瑾",[1],"の長子なり！\n「いざ、\n　勝負されたし！"]],[17,["「わかった\n　",[2],"元遜",[1],"殿、いざ！"]]],"5:1:0:18929":[[153,["「見事だ、",[2],"思遠",[1],"\n　私の負けだ\n　さあ、首を取れ！"]],[17,["「…………\n　\n　\n「",[2],"元遜",[1],"殿を斬ることは\n　できません\n　\n「捕虜になって\n　いただきます"]],[153,["「甘いな……\n　……まぁ、\n　よかろう"]]],"5:1:0:19094":[[149,["「これ以上の戦いは\n　無理か……\n　退却！　退却せよ！"]]],"5:1:0:19141":[[149,["「おう、",[2],"孔明",[1],"\n　会うのは",[3],"赤壁",[1],"前夜\n　以来だな"]],[0,["「お久しぶりです、\n　",[2],"孫権",[1],"殿\n　\n「いかがです？\n　このあたりで\n　兵を退かれては"]],[149,["「何を申すかと\n　思えば\n　\n「朕に降伏せよと\n　言うのか？"]],[0,["「いえ、\n　私が求めているのは\n　呉との和睦です\n「和睦した後、再び\n　漢呉同盟を結びたい\n　と考えております"]],[149,["「同盟以上のことは\n　望んでいない\n　というのか？\n「それは本心か？"]],[0,["「……現在は"]],[149,["「ふ……、\n　ふはははは\n　\n「…あいかわらずだな\n　",[2],"孔明",[1],"\n　\n「",[3],"赤壁",[1],"の頃と\n　まったく変わらぬ"]],[0,["「恐れ入ります"]],[149,["「わかった\n　ひとまずは\n　軍をおさめよう"]]],"5:1:0:19551":[[0,["「あれは…兄上…"]],[152,["「",[2],"孔明",[1],"か…\n　\n　\n「この戦いが終わらぬ\n　限りそなたは