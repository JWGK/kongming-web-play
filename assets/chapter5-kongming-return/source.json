5,0,60,55,3],"1914138":[55,85,0,6,3],"1914143":[0,229,26],"1914146":[55,85,0,0,3],"1914151":[1,85,0,96,55,1],"1914157":[24,85,0,0,0,0,0,0,255],"1914166":[0,85,27],"1914169":[0,142,27],"1914172":[10,195,1,96,55,3,0],"1914179":[1,195,1,60,55,3],"1914185":[0,40,28],"1914188":[1,173,0,60,49,3],"1914194":[0,141,28],"1914197":[6],"1914198":[255],"1914199":[46,59,0,0,0,255],"1914205":[9,0,16],"1914208":[0,108,29],"1914211":[53,59,25,2,1],"1914216":[255],"1914217":[46,25,0,0,0,255],"1914223":[9,0,32],"1914226":[10,17,0,72,53,3,0],"1914233":[10,45,0,54,54,1,0],"1914240":[10,232,0,56,41,2,0],"1914247":[10,232,1,56,69,0,0],"1914254":[56,17],"1914256":[5],"1914257":[11,130,29],"1914260":[0,143,29],"1914263":[10,44,0,11,54,1,0],"1914270":[1,45,0,54,50,2],"1914276":[1,44,0,54,54,1],"1914282":[0,29,30],"1914285":[55,45,0,3,2],"1914290":[0,78,30],"1914293":[55,45,0,0,2],"1914298":[1,45,0,54,50,1],"1914304":[0,103,30],"1914307":[10,218,1,11,54,1,0],"1914314":[1,45,0,54,50,2],"1914320":[1,44,0,54,58,0],"1914326":[1,218,1,54,54,1],"1914332":[0,156,30],"1914335":[1,44,0,54,58,1],"1914341":[0,2,31],"1914344":[55,44,0,6,1],"1914349":[55,45,0,6,1],"1914354":[55,232,0,6,1],"1914359":[55,232,1,6,1],"1914364":[55,218,1,6,1],"1914369":[0,81,31],"1914372":[55,44,0,0,1],"1914377":[55,45,0,0,1],"1914382":[55,232,0,0,1],"1914387":[55,232,1,0,1],"1914392":[55,218,1,0,1],"1914397":[6],"1914398":[255],"1914399":[46,7,0,0,0,255],"1914405":[9,0,16],"1914408":[53,25,25,2,1],"1914413":[0,91,31],"1914416":[53,7,25,0,1],"1914421":[255]},"texts":{"5:0:13:21446":["終章二幕　孔明の帰還"],"5:0:14:21466":["第二幕　孔明の帰還"],"5:0:11:21484":["長安"],"5:0:0:21489":[[124,["「",[2],"曹爽",[1],"殿、\n　一大事です\n　\n「蜀軍が",[3],"城",[1],"まで\n　退却を始めました"]],[133,["「なにっ！\n　蜀軍に何か\n　あったのか？\n「まさに奇跡だ！\n　よし、\n　すぐに追撃する！"]]],"5:0:0:21613":[[134,["「兄上、\n　それはいけません\n　\n「我が軍は敗戦続きで\n　兵も疲れています\n　\n「ここは出陣を\n　お控え下さい"]],[124,["「",[2],"孔明",[1],"も\n　",[3],"城",[1],"・",[3],"武功",[1],"には\n　\n「かなりの部隊を\n　残しております\n　\n「追撃はむずかしい\n　かと…"]],[133,["「むぅ……。それでは\n　しかたがないな\n　\n「出陣は\n　控えるとしよう"]]],"5:0:0:21828":[[81,["「失礼いたします！"]],[133,["「おお、\n　",[3],"洛陽",[1],"からの使者か\n　何用だ？"]],[81,["「陛下が\n　重態でございます！\n　\n「すぐに",[3],"洛陽",[1],"へ\n　お戻り下さい！"]],[133,["「なんだとッ！\n　それはいかん！\n　",[2],"夏侯覇",[1],"、",[2],"郭淮",[1],"\n「そなたらに\n　",[3],"長安",[1],"の守備を任せる\n　\n「私は今から\n　",[3],"洛陽",[1],"へ戻る！"]]],"5:0:11:22037":["洛陽"],"5:0:11:22042":["洛陽　曹叡邸"],"5:0:0:22055":[[133,["「陛下、\n　",[2],"曹爽",[1],"でございます\n　\n「ただいま",[3],"長安",[1],"から\n　戻りました"]],[98,["「おお、",[2],"曹爽",[1],"か\n　そなたに会うことが\n　できるとは……\n「まだ少し、寿命が\n　あったようだ"]],[133,["「何を\n　おっしゃいますか\n　お気の弱いことを"]],[98,["「いや、\n　朕はもうだめだ\n　\n「そなたに遺言を\n　伝えたかったのだ"]]],"5:0:0:22256":[[133,["「遺言で\n　ございますか……"]],[98,["「朕の後は……\n　",[2],"曹芳ｿｳﾎｳ",[1],"に継がせる\n　\n「",[2],"曹爽",[1],"、\n　そなたは",[2],"司馬懿",[1],"と\n　力を合わせて\n「",[2],"曹芳",[1],"を補佐して\n　やってくれ"]],[133,["「はっ。ご遺言、\n　しかと承りました"]],[98,["「それを聞いて……\n　安心した\n　\n「",[2],"曹芳",[1],"を……\n　たの…む……"]]],"5:0:0:22469":[[133,["「陛下！　陛下！\n　\n　\n「崩御\n　なさったか……"]]],"5:0:0:22513":[[133,["「陛下の葬儀と、\n　",[2],"曹芳",[1],"殿下の即位式を\n　行うことにする\n「",[2],"鍾",[1],"、\n　すぐに即位式の\n　準備をいたせ"]]],"5:0:0:22601":[[100,["「はっ\n　直ちに準備\n　いたします"]]],"5:0:0:22629":[[133,["「陛下は、\n　",[2],"司馬懿",[1],"とともに\n　\n「",[2],"曹芳",[1],"様を補佐せよと\n　おっしゃられたが\n　\n「",[2],"司馬懿",[1],"か……\n　わしはあの者が\n　どうも気にくわぬ\n「奴には……腹黒い\n　ところがある"]],[134,["「噂では病気が\n　治っていないと\n　聞きましたが"]],[135,["「どうします、兄上？\n　\n　\n「それならば\n　いっそのこと\n　\n「",[2],"司馬懿",[1],"を\n　暗殺した方が\n　よいのでは……"]],[133,["「いや、あまり事を\n　荒立ててもな……\n　\n「そうだ！\n　奴の家に\n　行ってみよう\n「奴の様子を見て\n　判断しよう\n　\n「もし本当に\n　重病ならば\n　慌てる必要もない"]],[136,["「はい"]]],"5:0:11:23004":["洛陽　司馬懿邸"],"5:0:0:23019":[[96,["「",[2],"曹爽",[1],"は、\n　わしのことを\n　邪魔に思うはずだ\n「もうすぐ、\n　ここにやってくる\n　ことだろう"]],[109,["「父上、どうなされる\n　のですか？"]],[96,["「わしは病気が\n　重いことにする\n　\n「そなたらは\n　わしの演技に\n　合わせよ"]],[110,["「はい"]],[96,["「むっ、さっそく\n　",[2],"曹爽",[1],"が来たようだ\n　\n「抜かりの\n　ないようにな"]]],"5:0:0:23221":[[133,["「おお、",[2],"司馬懿",[1],"殿\n　どこかへ出かける\n　ところかな？"]],[96,["「おお、",[2],"曹爽",[1],"様で\n　ございましたか\n　\n「",[2],"曹操",[1],"様がお亡くなり\n　になったと聞いて、\n　\n「宮殿に向かおうと\n　思いまして"]],[133,["「そうか……\n　……ん？\n　\n「",[2],"曹操",[1],"様……だと？\n　",[2],"司馬懿",[1],"殿、\n　何を言っておる？"]]],"5:0:0:23428":[[109,["「じ、実は……\n　父はこの頃、もの忘\n　れがひどくて…\n「いつもあの調子で\n　ございます"]]],"5:0:0:23491":[[110,["「父上\n　お亡くなりになった\n　のは",[2],"曹叡",[1],"様です\n「",[2],"曹操",[1],"様では\n　ありませんよ"]],[96,["「うんうん、\n　その通りだ\n　\n「",[2],"曹操",[1],"様には\n　お世話に\n　なったなぁ"]],[110,["「父上……"]]],"5:0:0:23623":[[136,["「兄上、\n　",[2],"司馬懿",[1],"はどうしたの\n　でしょう"]],[133,["「うむ……\n　",[2],"司馬懿",[1],"も\n　かなりの年だ\n「もうろくした\n　ようだな"]]],"5:0:0:23712":[[96,["「では、お先に\n　宮殿に参ります"]],[133,["「う、うむ\n　気をつけるがいい"]]],"5:0:0:23760":[[96,["「ふう、ずいぶんと\n　歩くのがしんどく\n　なったものだ\n「……よっこらせ！"]]],"5:0:0:23809":[[109,["「あっ！　父上！"]]],"5:0:0:23826":[[109,["「父上、\n　大丈夫ですか？"]],[96,["「なんの、\n　大丈夫じゃ\n　\n「",[2],"師",[1],"よ、そんなに\n　年寄り扱いするな\n　行くぞ"]]],"5:0:0:23910":[[110,["「父上、\n　そのお体では\n　無理です\n「宮殿には\n　我らが伺いますから\n　\n「父上はお休みに\n　なって下さい"]],[96,["「そ、そうか？\n　すまんのう、\n　苦労をかけて"]],[109,["「では、\n　父上はお休みに\n　なって下さい"]]],"5:0:0:24052":[[109,["「お恥ずかしいところ\n　をお見せしました\n　\n「申し訳\n　ございません"]],[133,["「い、いや\n　",[2],"司馬懿",[1],"殿はずっと\n　あの調子なのか？"]],[109,["「ええ\n　最近では耳も\n　遠くなってます"]],[133,["「そうか……\n　邪魔したな\n　これで失礼する\n「お父上を大切にな"]],[109,["「お心遣い、\n　ありがとう\n　ございます"]]],"5:0:11:24249":["洛陽　城内"],"5:0:0:24260":[[133,["「病とは聞いていたが\n　あれほどとはな\n　\n「もう",[2],"司馬懿",[1],"は\n　死んだも同然だな"]],[135,["「兄上、\n　\n　\n「それでは兄上が\n　実権を握れるのでは\n　ないですか？"]]],"5:0:0:24373":[[133,["「うむ。どうやら\n　我らの時代が\n　やってきたぞ\n「さあ、",[2],"曹芳",[1],"様の\n　即位式に向かうぞ！"]],[136,["「ははっ！"]]],"5:0:0:24450":[[134,["（しかし……\n　本当に",[2],"司馬懿",[1],"は\n　病気だったのか？"]]],"5:0:11:24496":["永昌"],"5:0:11:24501":["永昌　会議場"],"5:0:0:24514":[[42,["「そなた、丞相に命を\n　助けられ逃がしてい\n　ただいた恩を忘れて\n「またもや丞相に\n　刃向かうか！"]],[182,["「刃向かうのでは\n　ない！わしにも\n　意地がある\n「負けたままでは\n　\n　\n「",[3],"南蛮王",[1],"として\n　しめしが\n　つかぬのだ！"]],[42,["「ふん、どうせ\n　また負けるだけだ\n　\n「七度捕らわれ、\n　七度放されてもまだ\n　わからぬのか！？\n「この愚か者めがッ！"]],[182,["「なっ、なんだと！\n　このッ！"]]],"5:0:0:24768":[[42,["「ぎゃあっ！"]]],"5:0:0:24780":[[182,["「しまった……\n　殺すつもりは\n　なかったのだが\n「みてろ、\n　今度こそ",[2],"孔明",[1],"に\n　勝ってみせる！\n「全軍、\n　",[3],"成都",[1],"へ進軍だ！"]]],"5:0:0:24877":[[182,["「進め！　進め！"]]],"5:0:8:24894":[[3],"永昌",[1],"を落とした",[2],"孟獲",[1],"は、休む間\r\nもなく軍を北へ進めた\r\n",[3],"建寧",[1],"、",[3],"越"