{"version":"chapter5-jianning-dialogue/1","contextIds":["5:1:3","5:1:4"],"texts":{"5:1:0:3228":[[182,["「",[2],"孔明",[1],"は小知恵の働く\n　奴だ\n　\n「野戦では何があるか\n　わからん。ここは\n　",[3],"建寧",[1],"にて籠城する"]],[187,["「兄者、確かに",[2],"孔明",[1],"は\n　知者だ。だが、",[3],"建寧",[1],"\n　まで来るとなれば\n「蜀軍も疲弊する\n　でしょう\n　\n「戦って勝てぬことは\n　ありますまい"]],[182,["「しかしな……"]],[187,["「",[2],"孔明",[1],"が我らを逃がし\n　たのは\n　\n「軍を率いて戦えと\n　いっている\n　のでしょう！\n「何を\n　迷っているのです"]],[0,["「軍を二手に分ける\n　",[2],"姜維",[1],"よ、西側から\n　回るがよい"]],[4,["「丞相、",[2],"孟獲",[1],"を捕らえ\n　たらいかがいたしま\n　しょう？"]],[0,["「殺してはならぬ\n　\n　\n「",[2],"孟獲",[1],"を心服させ、\n　彼の武勇を魏討伐の\n　力としたいのだ"]]],"5:1:48:3657":["一、",[2],"孟獲",[1],"の捕縛\r\n二、兵糧庫の占領"],"5:1:0:3690":[[4,["「",[2],"祝融",[1],"を捕らえたぞ！"]]],"5:1:11:3713":["姜維はレベルが上がった！"],"5:1:0:3732":[[30,["「",[2],"孟優",[1],"を捕らえた！"]]],"5:1:11:3754":["李厳はレベルが上がった！"],"5:1:0:3773":[[7,["「",[2],"孟獲",[1],"を捕らえたぞ！"]]],"5:1:11:3796":["魏延はレベルが上がった！"],"5:1:0:3815":[[0,["「",[2],"孟獲",[1],"、\n　なかなかの精鋭を\n　集めたようだな"]],[182,["「わしにも\n　王としての\n　意地があるっ！\n「許されたからには\n　精兵を集め\n　\n「",[2],"孔明",[1],"、貴様を\n　討ち破るのが\n　王たる者の務めよ！"]],[0,["「ふふふ、\n　なかなか言うように\n　なったな"]]],"5:1:0:3983":[[0,["「西の兵糧庫を\n　確保したか"]]],"5:1:0:4010":[[0,["「両方の兵糧庫を\n　確保できたな\n　\n「これで籠城はできな\n　くなったわけだ"]]],"5:1:0:4067":[[0,["「東の兵糧庫を\n　確保したか"]]],"5:1:0:4094":[[0,["「両方の兵糧庫を\n　確保できたな\n　\n「これで籠城はできな\n　くなったわけだ"]]],"5:1:0:4151":[[0,["「",[2],"孟獲",[1],"を捕らえたか"]]],"5:1:0:4173":[[182,["「",[2],"孔明",[1],"は\n　小ずるい奴だ\n　\n「野戦で戦っても\n　勝ち目は薄い\n　\n「ここは",[3],"建寧",[1],"にて\n　籠城するぞ"]],[187,["「",[3],"建寧",[1],"は堅城\n　",[2],"孔明",[1],"も攻めあぐねる\n　だろうて"]],[0,["「そろそろ間者が\n　火をつける頃だな"]]],"5:1:0:4328":[[187,["「東西から火の手が\n　上がりました！\n　兵がおびえています"]],[182,["「兵を\n　落ち着かせろっ！\n　\n「",[2],"孔明",[1],"がすぐに\n　攻めてくるぞ！\n　防御を急げッ！"]]],"5:1:48:4435":["一、",[2],"孟獲",[1],"の捕縛"],"5:1:0:4452":[[4,["「",[2],"祝融",[1],"を捕らえたぞ！"]]],"5:1:11:4475":["姜維はレベルが上がった！"],"5:1:0:4494":[[30,["「",[2],"孟優",[1],"を捕らえた！"]]],"5:1:11:4516":["李厳はレベルが上がった！"],"5:1:0:4535":[[7,["「",[2],"孟獲",[1],"を捕らえたぞ！"]]],"5:1:11:4558":["魏延はレベルが上がった！"],"5:1:0:4577":[[0,["「",[2],"孟獲",[1],"、\n　なかなかの精鋭を\n　集めたようだな"]],[182,["「わ