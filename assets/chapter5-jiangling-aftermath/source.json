akerDefinition":null},"5:1:21710:0:1":{"textJa":"手段に過ぎなかった\n　\n　","sourceRuns":[{"kind":"text","text":"手段に過ぎなかった\n　\n　"}],"speakerDefinition":null},"5:1:21710:0:2":{"textJa":"しかし、この度の同盟は、呉も\n蜀漢と同じく漢室再興を目標と\nし、ともに魏を討つことを約し","sourceRuns":[{"kind":"text","text":"しかし、この度の同盟は、呉も\n蜀漢と同じく漢室再興を目標と\nし、ともに魏を討つことを約し"}],"speakerDefinition":null},"5:1:21710:0:3":{"textJa":"た画期的なものだった","sourceRuns":[{"kind":"text","text":"た画期的なものだった"}],"speakerDefinition":null},"5:1:21874:0:0":{"textJa":"「成都に帰還する","sourceRuns":[{"kind":"text","text":"「"},{"kind":"control","value":3},{"kind":"text","text":"成都"},{"kind":"control","value":1},{"kind":"text","text":"に帰還する"}],"speakerDefinition":0}},"sites":[[1922626,0,0],[1922626,1,155],[1922626,2,0],[1922626,3,155],[1922626,4,0],[1922626,5,155],[1922629,0,155],[1922642,0,152],[1922642,1,4],[1922642,2,0],[1922650,0,0],[1922658,0,155],[1922702,0,152],[1922702,1,0],[1922702,2,152],[1922702,3,0],[1922710,0,152],[1922710,1,0],[1922710,2,152],[1922725,0,152],[1922733,0,17],[1922741,0,152],[1922741,1,17],[1922782,0,153],[1922790,0,0],[1922790,1,153],[1922810,0,153],[1922810,1,17],[1922818,0,153],[1922818,1,17],[1922818,2,153],[1922848,0,0],[1922871,0,4],[1922892,0,0]],"blockPins":[{"block":14,"offset":1922494,"endOffset":1922901,"sha256":"e4b05225dbe8717cdfaf4fc96bf134a60bab1034141b1aadb759ee3eff33fa57"}],"entryCursor":[5,1,14,1,17],"heldCursor":[5,1,15,0,0]}
