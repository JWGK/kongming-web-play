":"「兄上……"}],"speakerDefinition":0},"5:1:20808:0:0":{"textJa":"「孔明、孫登様が\n　捕虜になっていると\n　聞いたが……","sourceRuns":[{"kind":"text","text":"「"},{"kind":"control","value":2},{"kind":"text","text":"孔明"},{"kind":"control","value":1},{"kind":"text","text":"、"},{"kind":"control","value":2},{"kind":"text","text":"孫登"},{"kind":"control","value":1},{"kind":"text","text":"様が\n　捕虜になっていると\n　聞いたが……"}],"speakerDefinition":152},"5:1:20808:1:0":{"textJa":"「ええ\n　\n　","sourceRuns":[{"kind":"text","text":"「ええ\n　\n　"}],"speakerDefinition":0},"5:1:20808:1:1":{"textJa":"「同盟が成った以上、\n　捕らえておく必要も\n　ありませんね","sourceRuns":[{"kind":"text","text":"「同盟が成った以上、\n　捕らえておく必要も\n　ありませんね"}],"speakerDefinition":0},"5:1:20808:1:2":{"textJa":"「一緒に\n　お連れ下さい","sourceRuns":[{"kind":"text","text":"「一緒に\n　お連れ下さい"}],"speakerDefinition":0},"5:1:20808:2:0":{"textJa":"「そうさせてもらおう\n　……ありがとう、\n　元気でな","sourceRuns":[{"kind":"text","text":"「そうさせてもらおう\n　……ありがとう、\n　元気でな"}],"speakerDefinition":152},"5:1:20970:0:0":{"textJa":"「そなたが\n　孔明の息子か？","sourceRuns":[{"kind":"text","text":"「そなたが\n　"},{"kind":"control","value":2},{"kind":"text","text":"孔明"},{"kind":"control","value":1},{"kind":"text","text":"の息子か？"}],"speakerDefinition":152},"5:1:20999:0:0":{"textJa":"「はい\n　伯父上にはお初に\n　お目にかかります","sourceRuns":[{"kind":"text","text":"「はい\n　伯父上にはお初に\n　お目にかかります"}],"speakerDefinition":17},"5:1:20999:0:1":{"textJa":"「名は瞻、字を\n　思遠と申します","sourceRuns":[{"kind":"text","text":"「名は"},{"kind":"control","value":2},{"kind":"text","text":"瞻"},{"kind":"control","value":1},{"kind":"text","text":"、字を\n　"},{"kind":"control","value":2},{"kind":"text","text":"思遠"},{"kind":"control","value":1},{"kind":"text","text":"と申します"}],"speakerDefinition":17},"5:1:21068:0:0":{"textJa":"「孔明の若い頃に\n　よく似ておる\n　","sourceRuns":[{"kind":"text","text":"「"},{"kind":"control","value":2},{"kind":"text","text":"孔明"},{"kind":"control","value":1},{"kind":"text","text":"の若い頃に\n　よく似ておる\n　"}],"speakerDefinition":152},"5:1:21068:0:1":{"textJa":"「私は呉の臣、\n　そなたも蜀の臣\n　だが、","sourceRuns":[{"kind":"control",