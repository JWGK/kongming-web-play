",[1],"に向かっても\n　持久戦に持ち込まれ\n　れば、\n「勝利は難しい\n　でしょう\n　\n「お聞きしたい！\n　\n　\n「丞相の策で\n　本当に",[3],"長安",[1],"がとれる\n　のですか？"]],[0,["「…………"]]],"4:3:0:13080":[[7,["「丞相っ！\n　お答え下され！"]]],"4:3:0:13105":[[8,["「……",[2],"魏延",[1],"殿、\n　やめられよ"]]],"4:3:0:13135":[[7,["「",[2],"関興",[1],"か、\n　お前になぞ\n　聞いておらぬ！\n「わしは丞相に\n　聞いておるのだ"]]],"4:3:0:13194":[[8,["「",[2],"魏延",[1],"殿は、\n　今回の敗戦に怒って\n　おられるようだ\n「しかし、\n　戦いは百戦百勝とは\n　参りますまい\n「読みが外れることも\n　ある"]]],"4:3:0:13293":[[8,["「",[2],"魏延",[1],"殿は、\n　この度の戦に不満が\n　おありのようだ\n「しかし、いつも作戦\n　通りにいくとは限ら\n　ないでしょう\n「読みが外れることも\n　ある"]]],"4:3:0:13394":[[8,["「貴殿とて\n　戦場で危機に陥り、\n　\n「",[2],"黄忠",[1],"殿や",[2],"趙雲",[1],"殿に\n　救われたことが\n　あるはず\n「このような時こそ、\n　我らが丞相を\n　\n「お助けせねば\n　ならぬはずだ\n　それを貴殿は……"]]],"4:3:0:13532":[[18,["「その通りだ\n　\n　\n「今回の敗戦を\n　丞相一人の責任にし\n　てはならぬのだ\n「我らの力不足をこそ\n　問うべきであろう\n　\n「",[2],"魏延",[1],"、\n　そなたの考えは\n　規律を乱すもとだ\n「控えよっ！"]],[7,["「貴様に言われずとも\n　わかっておるわ！"]]],"4:3:0:13697":[[18,["「その通りだ\n　\n　\n「今回の苦戦を\n　丞相一人の責任にし\n　てはならぬのだ\n「我らの力不足をこそ\n　問うべきであろう\n　\n「",[2],"魏延",[1],"、\n　そなたの考えは\n　規律を乱すもとだ\n「控えよっ！"]],[7,["「貴様に言われずとも\n　わかっておるわ！"]]],"4:3:0:13862":[[7,["「……丞相、\n　怒りのあまり\n　\n「暴言を吐いてしまっ\n　たこと、\n　お許し下さい"]]],"4:3:0:13924":[[0,["「……何か意見のある\n　者は？"]]],"4:3:0:13952":[[4,["「",[3],"葫蘆谷",[1],"を通るとなる\n　と、魏軍は追撃して\n　くるでしょう\n「ここは、",[3],"葫蘆谷",[1],"に\n　魏軍を誘い込んで、\n　\n「火攻めを行っては\n　いかがでしょう？"]],[0,["「ふむ……"]]],"4:3:0:14074":[[11,["「しかし、火攻めの準\n　備には時間がかかる\n　ことでしょう\n「進軍も遅くなります\n　\n　\n「",[3],"葫蘆谷",[1],"は入り口が\n　狭く一度に大軍は\n　通れません\n「この地形を利用して\n　追撃を阻み……\n　\n「その後頃合いを見て\n　",[3],"五丈原",[1],"へ進軍しては\n　いかがでしょう？"]],[0,["「確かに、それも一理\n　ある。どちらを選ぶ\n　べきか……"]],[4,["「では、\n　作戦がお決まりに\n　なりましたら\n「私に\n　お話し下さいませ"]]],"4:3:48:14355":["姜維"],"4:3:48:14360":["葫蘆谷に罠を仕掛けるか、\r\nそのまま進軍するか選択する"],"4:3:0:14398":[[6,["「",[3],"葫蘆谷",[1],"に誘い込んで\n　火攻めを\n　行いましょう"]]],"4:3:0:14442":[[7,["「",[3],"葫蘆谷",[1],"を\n　通るのならば、\n　\n「そのまま\n　進軍した方が\n　よいでしょう"]]],"4:3:0:14502":[[14,["「",[3],"葫蘆谷",[1],"は\n　入り口をふさげば\n　\n「出ることは不可能に\n　近いでしょう\n　\n「火攻めには\n　絶好の地形です"]]],"4:3:0:14589":[[10,["「大軍では、\n　狭い",[3],"葫蘆谷",[1],"を\n　\n「一度には進軍で\n　きないでしょうな"]]],"4:3:0:14648":[[8,["「",[3],"葫蘆谷",[1],"を抜ければ、\n　",[3],"五丈原",[1],"に到達いたし\n　ます"]]],"4:3:0:14698":[[21,["「",[2],"司馬懿",[1],"が",[3],"葫蘆谷",[1],"まで\n　やってくるかが問題\n　ではありますな"]]],"4:3:0:14752":[[9,["「火攻めを行えば、\n　\n　\n「大軍といえども\n　ひとたまりも\n　ありますまい"]]],"4:3:0:14806":[[11,["「火攻めは、\n　準備に時間が\n　かかりすぎます\n「そのまま進軍いたし\n　ましょう"]]],"4:3:0:14864":[[18,["「しかし、",[3],"子午谷",[1],"から\n　急襲したいとは\n　\n「",[2],"魏延",[1],"も\n　わがままですなぁ"]]],"4:3:0:14925":[[15,["「",[2],"魏延",[1],"殿の",[3],"子午谷",[1],"から\n　の急襲策も一理ある\n　とは思いますが…"]]],"4:3:0:14985":[[16,["「火攻めとなると、\n　天候が心配ですな"]]],"4:3:0:15017":[[5,["「それがしは火攻めを\n　支持いたします"]]],"4:3:0:15047":[[4,["「丞相、お考えは\n　お決まりに\n　なりましたか？"]]],"4:3:37:15083":["①",[3],"葫蘆谷",[1],"に誘い込んで火計…\r\n②",[3],"葫蘆谷",[1],"で迎撃しつつ進軍…"],"4:3:0:15138":[[4,["「",[3],"葫蘆谷",[1],"に誘い込み、\n　火攻めを行うので\n　ございますね"]]],"4:3:0:15186":[[0,["「うむ\n　そなたの案を\n　試してみる\n「",[2],"司馬懿",[1],"を\n　誘い込む役は、\n　\n「",[2],"魏延",[1],"にまかせる\n　……頼むぞ"]],[7,["「……承知\n　いたしました\n　\n「任務は見事にこなし\n　てみせましょう"]],[0,["「それでは、\n　出陣する！"]]],"4:3:0:15342":[[4,["「",[3],"葫蘆谷",[1],"で迎撃しつつ\n　進軍するのですね"]],[0,["「可能な限り早く\n　",[3],"五丈原",[1],"を占拠する\n　必要がある\n「迎撃に時間は\n　かけられぬ\n　では、出陣する！"]]],"4:3:11:15460":["渭水　魏軍幕舎"],"4:3:0:15475":[[115,["「申し上げます\n　蜀軍が",[3],"葫蘆谷",[1],"に\n　向かったようです"]],[96,["「なに、",[3],"葫蘆谷",[1],"！？\n　",[3],"葫蘆谷",[1],"から",[3],"五丈原",[1],"に\n　向かうつもりか\n「こしゃくな真似を…\n　よし、蜀軍を\n　追撃する！\n「",[2],"孔明",[1],"の首を挙げるの\n　は今だ！"]]],"4:3:0:15642":[[0,["「では、\n　",[3],"葫蘆谷",[1],"へ進軍する"]]],"4:3:0:15672":[[96,["「蜀軍を逃がすな！\n　",[2],"孔明",[1],"に\n　とどめをさすのだ！"]]],"4:3:0:15714":[[7,["「",[2],"司馬懿",[1],"め、追って\n　きやがったな\n　\n「罠とも知らずに\n　さて、わしは\n　逃げるとするか"]],[96,["「待てっ！　",[2],"魏延",[1],"、\n　尋常に勝負しろ！"]]],"4:3:0:15817":[[96,["「ちっ、\n　逃げられたか……\n　ん？\n「こ、この地形は…\n　いかん！\n　\n「ここで火をかけられ\n　たら我が軍は全滅す\n　るぞ！\n「逃げよ！　\n　この谷から\n　早く逃げ出すのだ！"]]],"4:3:0:15939":[[109,["「あっ！\n　あんなところから\n　火が！"]]],"4:3:0:15967":[[0,["「",[2],"司馬懿",[1],"は\n　罠にかかった\n　\n「全軍、\n　",[2],"司馬懿",[1],"を捕らえよ！"]]],"4:3:48:16026":["一、",[2],"司馬懿",[1],"の撃破"],"4:3:0:16045":[[96,["「相手が",[2],"趙雲",[1],"では\n　分が悪い…\n　ええいっ！"]]],"4:3:0:16086":[[6,["「あっ！　\n　……しまった\n　逃げられたか"]]],"4:3:11:16119":["趙雲はレベルが上がった！"],"4:3:0:16138":[[96,["「ちぃっ、\n　",[2],"馬岱",[1],"め手強い……\n　よし、今だっ！"]]],"4:3:0:16181":[[10,["「待てっ！　\n　",[2],"司馬懿",[1],"っ！\n　逃げるなっ！"]]],"4:3:11:16220":["馬岱はレベルが上がった！"],"4:3:0:16239":[[96,["「早く逃げるのだ！\n　\n　\n「このままでは\n　蜀軍に襲撃されて\n　しまうぞ！"]],[489,["「駄目です、\n　兵士たちが炎に怯え\n　きっています！"]],[96,["「むむむ……"]]],"4:3:0:16344":[[4,["「",[2],"郭淮",[1],"の軍勢が\n　現れました"]],[0,["「しかたない\n　順次迎撃せよ"]]],"4:3:0:16397":[[96,["「はぁ、はぁ……\n　どうにか\n　逃げ切ったか……"]]],"4:3:0:16435":[[109,["「ううっ、",[2],"孔明",[1],"……\n　恐ろしい男だ"]]],"4:3:0:16469":[[110,["「父上は、\n　こんな恐ろしい男と\n　戦っていたのか…"]]],"4:3:0:16509":[[96,["「おお、\n　雨が降ってきた…\n　\n「谷の火が……\n　消えていく……"]]],"4:3:0:16562":[[96,["「しかし、谷に火薬を\n　仕掛けて軍勢を焼き\n　尽くそうとは……\n「おそるべし、",[2],"孔明",[1],"\n　\n　\n「しょせん、\n　わしが叶う相手では\n　ないか……"]]],"4:3:0:16668":[[96,["「しまった、\n　油断したか…\n　ええぃ、今だっ！"]],[4,["「",[2],"司馬懿",[1],"は\n　逃げ出したようです"]]],"4:3:11:16734":["金１０００を手に入れた！"],"4:3:11:16754":["金１０００を手に入れた！"],"4:3:11:16774":["金６００を手に入れた！"],"4:3:11:16792":["金３００を手に入れた！"],"4:3:0:16810":[[4,["「丞相、やはり魏軍は\n　追ってきました"]],[0,["「",[3],"葫蘆谷",[1],"は道が狭く、\n　大軍が来ても\n　一度には通れぬ\n「各個撃破して\n　追撃を阻め"]],[109,["「父上\n　",[2],"孔明",[1],"は",[3],"葫蘆谷",[1],"に兵を\n　展開しています"]],[96,["「ふふふ、\n　我らは大軍だ\n　\n「",[2],"孔明",[1],"とて防ぎきれる\n　ものではないわ\n　\n「全軍進め、\n　",[2],"孔明",[1],"を捕らえよ！"]]],"4:3:48:17045":["一、",[2],"司馬懿",[1],"の撃破"],"4:3:0:17064":[[114,["「",[2],"孔明",[1],"は\n　",[3],"葫蘆谷",[1],"にいる！\n　",[2],"孔明",[1],"を捕らえよ！"]],[7,["「丞相、",[2],"郭淮",[1],"の軍勢が\n　現れました！　\n　\n「戦車隊を中心とした\n　軍勢のようです"]],[0,["「ふむ……\n　この様子では\n　援軍はまだ来るな\n「そろそろ\n　引き際を考えた方が\n　よいだろう"]]],"4:3:48:17250":["一、",[2],"司馬懿",[1],"の撃破\r\n二、",[2],"孔明",[1],"を北の砦に移動させる"],"4:3:11:17296":["勝利条件変更！"],"4:3:0:17310":[[125,["「おお、やっと\n　追いついたか"]],[124,["「",[2],"孔明",[1],"、\n　逃がしはせぬぞ！"]]],"4:3:0:17359":[[114,["「さすがは",[2],"魏延",[1],"、\n　これはかなわぬ"]]],"4:3:0:17389":[[7,["「ちっ！\n　逃げやがったか"]]],"4:3:11:17410":["魏延はレベルが上がった！"],"4:3:0:17429":[[124,["「ううむ、\n　噂通りの実力だ\n　これはかなわぬ"]]],"4:3:0:17464":[[6,["「さすがは",[2],"夏侯淵",[1],"の\n　長男。なかなかの\n　腕前だったな"]]],"4:3:11:17510":["趙雲はレベルが上がった！"],"4:3:0:17529":[[20,["「待てっ！\n　待たぬか、\n　",[2],"司馬懿",[1],"っ！\n