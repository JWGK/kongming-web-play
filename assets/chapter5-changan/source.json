:11:60":["城　会議場"],"5:0:0:73":[[109,["「父上、\n　ご無事でしたか？"]],[96,["「はあ、はあ…\n　何と恐ろしい男なの\n　だ、",[2],"孔明",[1],"とは\n「むぅ……"]]],"5:0:0:149":[[109,["「父上！"]]],"5:0:0:161":[[110,["「父上、しっかり\n　なさって下さい！"]]],"5:0:0:189":[[96,["「あ、ああ……\n　大丈夫だ\n　\n「……",[3],"城",[1],"は\n　",[2],"郭淮",[1],"に任せる\n　\n「",[3],"武功ﾌﾞｺｳ",[1],"には、\n　",[2],"夏侯覇",[1],"たちを\n　向かわせよ\n「わしは、",[3],"洛陽",[1],"へ\n　帰らせてもらう…"]],[109,["「は、はい！\n　すぐに手配\n　いたします！"]]],"5:0:11:353":["洛陽"],"5:0:11:358":["洛陽　会議場"],"5:0:0:371":[[98,["「……",[2],"司馬懿",[1],"が\n　",[3],"五丈原",[1],"で蜀軍に\n　敗れた\n「",[2],"司馬懿",[1],"は\n　帰陣した後に\n　\n「発作をおこして\n　倒れてしまった\n　そうだ"]],[129,["「なんと！\n　",[2],"司馬懿",[1],"が\n　倒れたのですか！？"]],[98,["「",[2],"司馬懿",[1],"のいない今、\n　魏はどうなる？\n　\n「誰に軍の指揮を\n　任せればよいのだ？"]],[101,["「…………"]],[98,["「誰かこの窮地を\n　救える者は\n　おらぬのか？"]]],"5:0:0:623":[[133,["「陛下、我ら兄弟に\n　蜀軍迎撃の任を\n　お申しつけ下さい"]],[98,["「おお！\n　",[2],"曹爽",[1],"！"]],[133,["「蜀軍に敗れて死んで\n　いった父",[2],"曹真",[1],"の仇を\n　討たせて下さい"]]],"5:0:0:741":[[134,["「兄弟、力を合わせて\n　",[2],"孔明",[1],"に当たります\n　お任せ下さい"]],[98,["「おお、そなたたちが\n　行ってくれるか\n　\n「では",[2],"曹爽",[1],"、\n　そなたを総司令官に\n　任ずるゆえ\n「すぐに",[3],"城",[1],"へ\n　向かってくれ"]],[133,["「ははっ"]]],"5:0:11:890":["建業　会議場"],"5:0:0:903":[[177,["「陛下、ただいま\n　報せが入りました\n　\n「",[2],"孔明",[1],"が、\n　",[3],"五丈原",[1],"で魏軍を\n　破ったそうです"]],[149,["「うむ、\n　それはよい報せだ\n　\n「そうか、\n　蜀が勝ったか\n　\n「我らも行動を起こし\n　た方がよかろう\n　",[2],"陸遜",[1],"！"]]],"5:0:0:1061":[[155,["「はっ"]]],"5:0:0:1070":[[149,["「",[2],"陸遜",[1],"、\n　そなたはこれより\n　",[3],"江陵",[1],"へ向かえ\n「魏に隙ができたら、\n　すぐに攻め込める\n　よう準備せよ"]],[155,["「ははっ"]]],"5:0:0:1159":[[155,["「",[3],"江陵",[1],"へ向かう\n　魏の隙を\n　うかがうのだ"]]],"5:0:11:1197":["五丈原"],"5:0:48:1204":["五丈原の幕舎に行く"],"5:0:11:1220":["五丈原　蜀軍幕舎"],"5:0:0:1237":[[16,["「丞相、間者よりの\n　情報です\n　\n「",[2],"司馬懿",[1],"が発作で倒れ\n　たため、総司令の職\n　を退いたそうです"]],[0,["「そうか！　それは、\n　よい報せだ。して、\n　",[2],"司馬懿",[1],"の後任は？"]],[16,["「",[2],"曹真",[1],"の息子",[2],"曹爽",[1],"\n　だそうです\n　\n「すでに",[3],"城",[1],"に\n　入城しておる\n　そうです"]],[0,["「",[2],"曹真",[1],"の子か……\n　",[2],"司馬懿",[1],"がいないなら\n　ば何も問題ない\n「すぐに\n　",[3],"城",[1],"を攻める"]]],"5:0:0:1511":[[4,["「丞相、",[3],"城",[1],"に\n　向かうには\n　\n「北からと西からの\n　二つの道が\n　ございます\n「北から攻める場合は\n　城までの距離は\n　短くなります\n「しかし、\n　",[3],"長安",[1],"方面から\n　援軍があった場合、\n「挟撃される可能性が\n　あります"]],[0,["「うむ"]],[4,["「西から攻める場合は\n　城にたどり着くまで\n　時間がかかりますが\n「挟撃される心配は\n　ありません\n　\n「また、\n　間者からの情報では\n　\n「城内には武具・兵糧\n　の備蓄がかなりある\n　とのこと"]],[0,["「ふむ……。では、\n　作戦を考えよう"]],[4,["「作戦がお決まりにな\n　りましたら私にお話\n　し下さいませ"]]],"5:0:48:1891":["姜維"],"5:0:48:1896":["北から攻めるか、\r\n西から攻めるか選択する"],"5:0:0:1924":[[6,["「挟撃を受ける\n　というのは危険です\n　\n「西側から攻めるのが\n　安全でよいかと存じ\n　ますが"]]],"5:0:0:1993":[[7,["「",[3],"城",[1],"を落とせば、\n　",[3],"長安",[1],"は目の前です\n　\n「それがしに先鋒を\n　お申しつけ下さい"]]],"5:0:0:2063":[[14,["「ここは電光石火の\n　用兵が肝要かと\n　\n「北から一気に\n　攻撃しましょう"]]],"5:0:0:2123":[[10,["「ぜひ、それがしを\n　出陣させて下さい\n　腕が鳴ります"]]],"5:0:0:2163":[[8,["「敵の援軍が来ないは\n　ずがありませぬ\n　\n「西から攻めるのが\n　よろしいかと"]]],"5:0:0:2218":[[21,["「北側から速攻で\n　",[3],"城",[1],"を落とせば、\n　\n「敵の援軍が来ようと\n　問題ありません"]]],"5:0:0:2285":[[9,["「",[3],"武功",[1],"に",[2],"夏侯覇",[1],"らが\n　駐屯している\n　とのこと\n「おそらく、\n　援軍はそこから\n　来るでしょう"]]],"5:0:0:2361":[[11,["「",[2],"曹爽",[1],"は、\n　",[2],"曹真",[1],"の子ですが\n　\n「",[2],"曹真",[1],"ほどの才はない\n　と聞き及んでおりま\n　す"]]],"5:0:0:2435":[[18,["「挟撃を受けるのは\n　危険です\n　\n「ここは危険を避け、\n　西から攻めるのが\n　上策と存じます"]]],"5:0:0:2506":[[15,["「",[3],"城",[1],"には\n　武具・兵糧の備蓄が\n　多いとか\n「全部奪って\n　いきましょう"]]],"5:0:0:2570":[[16,["「",[2],"曹爽",[1],"は",[2],"曹真",[1],"の\n　息子だそうですが\n　\n「実力はどの程度なの\n　でしょう？"]]],"5:0:0:2635":[[5,["「",[2],"曹爽",[1],"には\n　",[2],"曹羲ｿｳｷﾞ",[1],"、\n　",[2],"曹訓ｿｳｸﾝ",[1],"\n「",[2],"曹彦ｿｳｹﾞﾝ",[1],"の\n　三人の弟が\n　いるとのことです"]]],"5:0:0:2722":[[4,["「丞相、\n　作戦はお決まりに\n　なりましたか？"]]],"5:0:37:2758":["①西から攻める\r\n②北から攻める"],"5:0:0:2781":[[4,["「わかりました\n　西から攻める\n　のですね"]],[0,["「うむ。挟撃されては\n　かなわぬからな\n　では、出陣する！"]]],"5:0:0:2851":[[4,["「わかりました\n　北から攻める\n　のですね"]],[0,["「敵の援軍が\n　来るまでに\n　\n「勝負を決める\n　必要があるな\n　では、出陣する！"]]],"5:0:0:2943":[[0,["「さて、\n　",[2],"曹爽",[1],"の実力はどれほ\n　どのものか……"]]],"5:0:0:2985":[[0,["「",[2],"司馬懿",[1],"が戦線にいな\n　い今こそ兵を進める\n　絶好の機会だ"]],[4,["「",[3],"城",[1],"はさほど\n　大きな城では\n　ありません\n「攻略は容易かと\n　思われます"]],[136,["「兄者、蜀軍がやって\n　きました！",[2],"孔明",[1],"自ら\n　出陣しています！"]],[133,["「なにっ！\n　もう来たか！よし、\n　全軍迎撃の準備だ！\n「我らの父上は\n　",