,[2],"曹爽",[1],"殿、\n　大丈夫ですか？"]],[133,["「",[3],"武功",[1],"だ！\n　",[3],"武功",[1],"まで退くのだ！"]]],"5:0:11:5808":["城"],"5:0:48:5813":["城の会議場に行く"],"5:0:11:5829":["城　会議場"],"5:0:0:5842":[[18,["「丞相。",[2],"曹爽",[1],"は\n　",[3],"武功",[1],"まで軍を退いた\n　ようです"]],[0,["「",[3],"武功",[1],"か…\n　\n　\n「",[2],"姜維",[1],"、",[3],"武功",[1],"は\n　いかなる地勢に\n　なっておるか？"]]],"5:0:0:5955":[[4,["「",[3],"武功",[1],"には比較的\n　大きな河が\n　流れています\n「この河の\n　北岸と南岸に\n　布陣できます"]]],"5:0:0:6030":[[10,["「丞相、\n　",[3],"武功",[1],"の南北両岸に\n　\n「魏軍の食糧が\n　集積してあると\n　聞きました\n「これを狙っては\n　いかがでしょうか？"]]],"5:0:0:6123":[[9,["「丞相、\n　",[2],"曹爽",[1],"は",[3],"武功",[1],"の南岸に\n　布陣しました\n「北岸は警備程度の\n　兵士しかおらず\n　\n「かなり手薄の\n　ようです"]],[0,["「ご苦労\n　南岸の",[2],"曹爽",[1],"を攻める\n　のはよいとして\n「北岸の兵を\n　どうするかだな"]]],"5:0:0:6284":[[18,["「では、軍を二手に\n　分けるのですか？"]],[0,["「うむ。あるいは、\n　全軍で南岸を\n　攻めるか…\n「そのどちらかだ"]],[4,["「作戦がお決まりに\n　なりましたら\n　私にお告げ下さい"]]],"5:0:48:6399":["姜維"],"5:0:48:6404":["軍を南北二手に分けるか、\r\n南岸に集結させるか選択する"],"5:0:0:6444":[[6,["「敵が分散している\n　のは我らにとって\n　好都合\n「全軍で南岸を\n　攻めましょう"]]],"5:0:0:6506":[[7,["「北岸にも兵を分け、\n　魏軍の食料をすべて\n　奪い取りましょう"]]],"5:0:0:6555":[[14,["「全軍で南岸を攻めた\n　方がよろしいかと"]]],"5:0:0:6588":[[10,["「北岸の食糧も\n　惜しいですな\n　\n「軍を北岸と\n　南岸の二手に\n　分けましょう"]]],"5:0:0:6652":[[8,["「",[3],"長安",[1],"まで\n　あと一歩ですな"]]],"5:0:0:6681":[[21,["「この",[3],"武功",[1],"を抜けば\n　まさに",[3],"長安",[1],"は\n　目の前です"]]],"5:0:0:6728":[[9,["「全軍で南岸を攻めた\n　方がよろしいかと"]]],"5:0:0:6761":[[11,["「こちらも軍を二手に\n　分けましょう"]]],"5:0:0:6790":[[18,["「魏軍の指揮は",[2],"曹爽",[1],"が\n　とっています"]]],"5:0:0:6825":[[15,["「一応、\n　我が軍の補給は\n　足りています"]]],"5:0:0:6861":[[16,["「",[3],"城",[1],"の武器屋や道具\n　屋で道具や装備を整\n　えて下さい"]]],"5:0:0:6915":[[5,["「",[3],"長安",[1],"まであとわずか\n　です\n　がんばりましょう"]]],"5:0:0:6953":[[4,["「丞相、\n　作戦はお決まりに\n　なりましたか？"]]],"5:0:37:6989":["①軍を南北二手に分ける\r\n②軍を南岸に集結させる"],"5:0:0:7027":[[4,["「わかりました\n　\n　\n「軍を北岸と南岸の\n　二手に分ける\n　のですね"]],[0,["「うむ\n　食糧の奪取を\n　狙うとしよう\n「それでは",[3],"武功",[1],"に\n　出陣する"]]],"5:0:0:7136":[[4,["「わかりました\n　軍を南岸に集結させ\n　るのですね"]],[0,["「うむ\n　北岸の食糧はこだわ\n　らなくてもよい\n「それでは",[3],"武功",[1],"に\n　出陣する"]]],"5:0:0:7232":[[0,["「旧都",[3],"長安",[1],"まで\n　あとわずか……か"]]],"5:0:0:7266":[[0,["「南北両岸の食糧庫を\n　奪えば、魏軍は補給\n　が続かなくなろう\n「",[3],"長安",[1],"は目前だ、\n　がんばれ！"]],[133,["「ここで敗れたら、\n　もう",[3],"長安",[1],"までさえぎ\n　るものが何もない\n「意地でも守り抜いて\n　みせる！"]],[134,["「どうやら蜀軍は\n　南北に軍を分けた\n　ようです"]]],"5:0:48:7447":["一、南北の兵糧庫を奪い取る\r\n二、",[2],"曹爽",[1],"の撃破"],"5:0:0:7487":[[124,["「蜀軍を蹴散らせ！\n　食糧庫に\n　近づけるな！"]]],"5:0:0:7526":[[4,["「敵の伏兵が\n　現れました！"]],[114,["「ふふふ…\n　食糧につられたか！\n　愚か者めが！"]]],"5:0:0:7586":[[5,["「待て、",[2],"夏侯威",[1],"！\n　逃げるな！"]]],"5:0:11:7617":["馬謖はレベルが上がった！"],"5:0:0:7636":[[21,["「ちっ、\n　逃げられたか！"]]],"5:0:11:7657":["関興はレベルが上がった！"],"5:0:0:7676":[[4,["「おのれ、",[2],"郭淮",[1],"！\n　逃げるな！"]]],"5:0:11:7705":["姜維はレベルが上がった！"],"5:0:0:7724":[[0,["「北の食糧庫はうまく\n　奪えたようだな"]]],"5:0:0:7755":[[0,["「南岸の食糧庫は\n　押さえてある\n　勝ったな"]],[133,["「なにっ。　食糧庫を\n　両方取られた！\n　\n「それでは戦えぬ、\n　退却だ！"]]],"5:0:0:7847":[[0,["「北の食糧庫もうまく\n　いけばよいが"]]],"5:0:0:7876":[[0,["「北岸の食糧庫は\n　押さえてある\n　勝ったな"]],[133,["「なに！　食糧庫を\n　両方取られただと！\n　\n「それでは戦えん、\n　退却だ！"]]],"5:0:0:7969":[[133,["「にっ、逃げろぉ！"]]],"5:0:0:7985":[[0,["「",[2],"曹爽",[1],"は逃げたか\n　まあよい、\n　もう少しだな"]]],"5:0:11:8024":["金１０００を手に入れた！"],"5:0:0:8044":[[0,["「南北両岸の食糧庫を\n　奪えば、\n　\n「魏軍は補給が\n　続かなくなる\n　だろうが……\n「まあ無理をする必要\n　はない。むしろ狙い\n　は",[2],"曹爽",[1],"だ\n「",[3],"長安",[1],"は目前だ、\n　がんばれ！"]],[133,["「ここで敗れたら、\n　もう",[3],"長安",[1],"までさえぎ\n　るものが何もない\n「意地でも守り抜いて\n　みせる！"]],[134,["「どうやら蜀軍は\n　南岸に軍を集中させ\n　たようです"]]],"5:0:48:8286":["一、南北の兵糧庫を奪い取る\r\n二、",[2],"曹爽",[1],"の撃破"],"5:0:0:8326":[[124,["「いかん！\n　食糧庫を守るのだ！"]]],"5:0:0:8353":[[4,["「敵の伏兵が\n　現れました！"]],[114,["「ふふふ…\n　食糧につられてのこ\n　のこやって来たか！\n「この貧乏性の\n　愚か者め！"]]],"5:0:0:8437":[[5,["「待て、",[2],"夏侯威",[1],"！\n　逃げるな！"]]],"5:0:11:8468":["馬謖はレベルが上がった！"],"5:0:0:8487":[[21,["「ちっ、\n　逃げられたか！"]]],"5:0:11:8508":["関興はレベルが上がった！"],"5:0:0:8527":[[4,["「おのれ、",[2],"郭淮",[1],"！\n　逃げるな！"]]],"5:0:11:8556":["姜維はレベルが上がった！"],"5:0:0:8575":[[0,["「北の食糧庫はうまく\n　奪えたようだな"]]],"5:0:0:8606":[[0,["「南岸の食糧庫は\n　押さえてある\n　勝ったな"]],[133,["「なにっ。　食糧庫を\n　両方取られた！\n　\n「それでは戦えぬ、\n　退却だ！"]]],"5:0:0:8698":[[0,["「北の食糧庫もうまく\n　いけばいいが"]]],"5:0:0:8727":[[0,["「北岸の食糧庫は\n　押さえてある\n　勝ったな"]],[133,["「なに！　食糧庫を\n　両方取られた