,0,0,1],"1876861":[55,45,0,6,1],"1876866":[0,66,64],"1876869":[55,45,0,0,1],"1876874":[55,23,0,2,3],"1876879":[0,155,64],"1876882":[55,23,0,0,3],"1876887":[0,221,64],"1876890":[61,1]},"texts":{"5:0:0:8893":[[133,["「こ、",[2],"孔明",[1],"の采配が\n　これほどとは……\n　\n「",[3],"長安",[1],"だ、",[3],"長安",[1],"まで\n　退却せよ！"]]],"5:0:11:8965":["建業　会議場"],"5:0:0:8978":[[149,["「なんとっ！\n　蜀軍がまた魏軍を\n　破ったと申すか！？"]],[173,["「はっ"]],[149,["「むむむ……\n　それはちとまずい\n　\n「蜀が魏を併呑してし\n　まえば\n　\n「その国力は我が呉を\n　はるかにしのぐもの\n　となろう"]],[173,["「陛下のおっしゃる\n　通りです"]],[149,["（蜀と魏の共倒れこそ\n　が、わしの望みだ\n　\n（このままでは蜀に\n　天下を取られる\n　\n（何とかせねば\n　なるまい…"]]],"5:0:11:9215":["洛陽"],"5:0:11:9220":["洛陽　会議場"],"5:0:0:9233":[[128,["「陛下、ご報告\n　申し上げます\n　\n「",[2],"曹爽",[1],"殿、\n　",[3],"武功",[1],"にて蜀軍に\n　敗北しました\n「現在は",[3],"長安",[1],"まで\n　退却いたして\n　おります"]],[98,["「な、なにっ！\n　",[2],"曹爽",[1],"まで敗れて\n　しまったのか！\n「",[3],"長安",[1],"より西は、\n　すべて蜀の手に\n　\n「わたったと\n　申すのか！"]],[128,["「は、はい……"]],[98,["「ああ……\n　",[2],"孔明",[1],"に\n　またして…も…"]]],"5:0:0:9478":[[101,["「陛下！"]]],"5:0:0:9490":[[100,["「陛下っ！\n　お気を確かに！"]]],"5:0:11:9515":["江陵"],"5:0:11:9520":["江陵　呉軍陣地"],"5:0:0:9535":[[155,["（このまま蜀が\n　魏を倒して\n　しまったら\n（呉の命運も\n　尽きてしまう\n　\n（何とかせねば\n　ならぬが……\n　\n（これといった\n　策もなし"]]],"5:0:0:9632":[[155,["「む？　何者だ！？"]]],"5:0:0:9650":[[451,["「どこから\n　入ってきた！？\n　くせ者め！"]]],"5:0:0:9681":[[468,["「ほっほっほ…\n　わしは近郷の者で\n　ございます\n「呉の\n　大都督",[2],"陸遜",[1],"様に\n　\n「この老骨、耳寄りな\n　話を教えて進ぜよう\n　と思うての…"]]],"5:0:0:9788":[[450,["「何を戯言を！\n　とっとと\n　つまみ出せ！"]],[155,["「……待てっ！"]]],"5:0:0:9835":[[451,["「",[2],"陸遜",[1],"様……何か？"]],[155,["「我が軍の厳重な\n　警備をかいくぐって\n　\n「陣中に侵入する\n　老人か……、\n　おもしろい\n「その勇気に免じて\n　話を聞いてやろう\n　\n「では、ご老人\n　こちらへ"]]],"5:0:0:9976":[[468,["「はい\n　それでは、失礼して"]]],"5:0:0:9999":[[155,["「ご老人、\n　どうぞこちらへ"]]],"5:0:0:10022":[[155,["「そなた、近郷の老人\n　などではあるまい\n　\n「魏か蜀の名のある\n　人物であろう"]],[468,["「……さすがは\n　",[2],"陸遜",[1],"様ですな"]],[155,["「ただの老人が\n　陣中に入れるはずが\n　ない……\n「そなたは\n　何者なのだ？\n　\n「名を明かして\n　もらえるだろうな？"]],[468,["「ごもっとも\n　それでは……"]]],"5:0:0:10212":[[96,["「",[2],"司馬懿",[1],"、\n　字を",[2],"仲達ﾁｭｳﾀﾂ",[1],"と\n　申す\n「",[2],"陸遜",[1],"殿にはお初に\n　お目にかかる"]]],"5:0:0:10285":[[155,["「",[2],"司馬懿",[1],"……！\n　そなたは\n　\n「",[3],"洛陽",[1],"で病の床に\n　伏していると聞いて\n　いたが……！？"]],[96,["「それは\n　表向きのこと\n　\n「さて",[2],"陸遜",[1],"殿、\n　わしの話を聞いて\n　いただけるかな？"]]],"5:0:0:10423":[[155,["「う、うむ……"]],[96,["「では…\n　ときに",[2],"陸遜",[1],"殿は\n　\n「最近の蜀軍の\n　快進撃をどう\n　思われますかな？"]],[155,["「何をわかりきった\n　ことを…\n　\n「我が呉と蜀とは\n　同盟を結んで\n　いるのだ\n「同盟国の勝利を\n　喜ばぬわけが\n　なかろう"]],[96,["「それは\n　本心からですかな？\n　\n「魏と蜀が\n　共倒れになるのを\n　狙っていたのに、\n「蜀が一方的に勝って\n　いるのはまずい…\n　\n「そう思っておる\n　のではないのかな？"]]],"5:0:0:10707":[[155,["「…………"]],[96,["「いやいや、\n　これは失礼\n　\n「",[2],"陸遜",[1],"殿を試している\n　わけではない"]]],"5:0:0:10774":[[96,["「しかし……\n　もし仮に魏が蜀に\n　滅ぼされた後、\n「呉はどうなると\n　お思いか？\n　\n「蜀と呉の二国が残り\n　蜀の勢力は絶大\n　呉は……\n「蜀に併呑される\n　でしょうな"]],[155,["「それは……\n　その通り\n　かもしれぬ"]],[96,["「蜀がこれ以上\n　勝つのは、\n　\n「魏にとってだけ\n　でなく呉にとっても\n　大問題\n「そこで、",[2],"陸遜",[1],"殿に\n　それを回避する策を\n　授けたいのです"]],[155,["「回避する策……か\n　それはぜひ\n　ご教授願いたい"]]],"5:0:0:11070":[[96,["「",[2],"孔明",[1],"は、北伐のため\n　蜀軍主力を",[3],"長安",[1],"近く\n　まで出しておるゆえ\n「蜀本国は\n　手薄のはず\n　\n「これを利用して、\n　",[3],"白帝城",[1],"から",[3],"巴西",[1],"、\n　",[3],"成都",[1],"…と\n「攻められては\n　いかがですかな？"]],[155,["「我ら呉に、\n　呉蜀同盟を破れと\n　いうのか……！"]],[96,["「さて、\n　我ら魏にとっては\n　",[2],"孔明",[1],"さえ引き返せば\n「その後の外交は\n　そちらの自由\n　\n「蜀と組もうが\n　魏と組もうが文句は\n　申しますまい\n「呉が\n　蜀本国を攻めれば、\n　\n「",[2],"孔明",[1],"は魏から\n　引き上げざるを\n　えなくなる\n「そして、\n　呉は広大な領土を\n　手中にできますな"]]],"5:0:0:11467":[[155,["「そして、魏は\n　当面の脅威が\n　なくなる…\n「うまく\n　考えたものだな"]],[96,["「その通り。また\n　三国の均衡がとれる\n　というものです\n「まあ、この策を\n　実行するかどうかは\n　\n「",[2],"陸遜",[1],"殿に\n　お任せします"]],[155,["「…………"]],[96,["「それでは\n　これにて失礼……"]]],"5:0:0:11648":[[155,["「",[2],"司馬懿",[1],"殿…\n　一つだけ、聞きたい\n　ことがある"]]],"5:0:0:11691":[[96,["「何ですかな？"]],[155,["「なぜだ……？\n　\n　\n「なぜ、\n　敵陣に単身乗り込む\n　危険を冒してまで\n「ここに来たのだ？"]],[96,["「理由は、ただ一つ\n　\n　\n「",[2],"孔明",[1],"を倒すためだ"]]],"5:0:0:11814":[[155,["「陛下に書状を\n　書かねばならぬな\n　\n「蜀侵攻の許可を\n　お願いせねば……"]]],"5:0:11:11875":["建業　会議場"],"5:0:0:11888":[[149,["「皆の者、\n　",[3],"江陵",[1],"の",[2],"陸遜",[1],"より\n　書状が届いた"]]],"5:0:0:11935":[[163,["「",[2],"陸遜",[1],"殿は何と？"]],[149,["「うむ…\n　\n　\n「",[2],"孔明",[1],"のいない隙に\n　蜀へ侵攻すべきだと\n　申してきた"]],[152,["「な、何ですとっ！"]]],"5:0:0:12028":[[152,["「陛下、\n　我が呉と蜀とは\n　同盟中のはず\n「それを一方的に破棄\n　して蜀を攻めるなど\n　賛成できませぬ！"]],[149,["「う、うむ……"]],[152,["「いかに",[2],"陸遜",[1],"殿の\n　意見といえど\n　納得しかねます"]]],"5:0:0:12164":[[149,["「",[2],"諸葛瑾",[1],"よ、\n　そなたの気持ちは\n　わかる\n「しかし、この同盟は\n　魏が強大なればこそ\n　結ばれたのだ\n「現在の呉の脅威は\n　魏ではない\n　\n「そなたの弟",[2],"諸葛亮",[1],"\n　率いる蜀なのだ"]],[152,["「…………！"]],[149,["「蜀が強大になるのは\n　呉にとって\n　禍いでしかない\n「朕は呉の皇帝として\n　その禍いを取り除か\n　ねばならぬ"]],[152,["「…………"]],[149,["「",[2],"全",[1],"、\n　",[2],"陸遜",[1],"に使者を送れ\n　\n「蜀領内へ侵攻せよ、\n　とな"]]],"5:0:0:12462":[[177,["「はっ！"]]],"5:0:0:12472":[[152,["「…………"]]],"5:0:0:12487":[[155,["「陛下のご命令だ！\n　蜀領内に侵攻せよ！"]]],"5:0:8:12523":["呉軍は蜀領内に侵入し、猛攻に\r\nよって",[3],"白帝城",[1],"を陥落させた\r\n呉との同盟が長きにわたってい\r\nたため、蜀呉国境には警備程度\r\nの兵士しか配備されていなかっ\r\nたのである\r\n",[3],"白帝城",[1],"の蜀軍兵士は、",[3],"巴西",[1],"へと\r\n逃亡していった"],"5:0:11:12685":["成都"],"5:0:11:12690":["成都　宮殿"],"5:0:0:12701":[[474,["「へ、陛下ー！\n　\n　\n「呉が、呉が、\n　我が国に侵攻して\n　参りました！"]],[23,["「なにッ！\n　どういうことだ！？"]],[474,["「はい\n　私は",[3],"白帝城",[1],"の守備兵\n　でございますが、\n「呉軍が急に\n　攻めてきたのです\n　\n「",[3],"白帝城",[1],"には警護程度\n　の兵士しかおらず\n　\n「防ぎようが\n　ありませんでした"]],[23,["「むむむ、\n　このままでは\n　",[3],"巴西",[1],"も危ない！\n「",[3],"巴西",[1],"の警備兵も\n　少数だ\n　\n「",[2],"董允",[1],"、\n　直ちに援軍を\n　手配せよ！"]]],"5:0:0:13006":[[35,["「しかし……\n　我が軍のほとんどは\n　",[3],"長安",[1],"におります\n「援軍と申されても\n　人材がおりません"]],[23,["「な、なんだと……\n　では、どうすれば\n　よいと言うのだ！"]],[35,["「そ、それは……\n　\n　\n「とにかく、至急\n　丞相に使者を\n　送りましょう"]],[23,["「そ、そうじゃな\n　それで、",[3],"巴西",[1],"への\n　援軍はどうする？\n「丞相が戻るまで\n　時間があるだろう"]],[35,["「はぁ……"]]],"5:0:0:13249":[[17,["「陛下。私は",[2],"諸葛亮",[1],"の\n　子にて",[2],"諸葛瞻",[1],"、字を\n　",[2],"思遠ｼｴﾝ",[1],"と申します\n「漢朝の危急を聞き、\n　",[3],"巴西",[1],"への援軍に\n　加えていただきたく\n「参上\n　つかまつりました"]]],"5:0:0:13382":[[44,["「私は",[2],"趙雲",[1],"の長子にて\n　",[2],"趙統ﾁｮｳﾄｳ",[1],"で\n　ございます\n「我ら兄弟も援兵に\n　加えていただきたく\n　存じます"]]],"5:0:0:13469":[[45,["「",[2],"趙雲",[1],"の次男にて\n　",[2],"趙広ﾁｮｳｺｳ",[1],"と\n　申します\n「陛下、ぜひ我らを\n　",[3],"巴西",[1],"にお遣わし\n　下さりませ"]]],"5:0:0:13556":[[23,["「おおっ！\n　丞相と",[2],"趙雲",[1],"の\n　息子たちか！\n「そなたたちであれば\n　安心して送り出せる"]]],"5:0:0:13623":[[17,["「はっ。それで陛下、\n　\n　\n「私はどの部隊を\n　率いればよろしい\n　でしょうか？"]],[23,["「おお、そうじゃな\n　\n　\n「だが、朕は\n　軍隊のことは詳しく\n　ないのでな……\n「",[3],"成都",[1],"に残っている\n　部隊から\n　\n「そなたの好きな部隊\n　を選ぶがよい"]]],"5:0:11:14428":["洛陽"],"5:0:11:14433":["洛陽　会議場"],"5:0:0:14446":[[128,["「陛下、ご報告\n　申し上げます\n　\n「",[2],"曹爽",[1],"殿が\n　",[3],"武功",[1],"にて蜀軍に\n　敗北しました\n「現在は",[3],"長安",[1],"まで\n　退却いたして\n　おります"]],[98,["「な、なにッ！\n　",[2],"曹爽",[1],"まで敗れて\n　しまったのか！\n「",[3],"長安",[1],"より\n　西の地はすべて\n　\n「蜀の手にわたった\n　というのか！"]],[128,["「は、はい……"]]],"5:0:0:14658":[[98,["「どうすれば\n　よいのだ……\n　\n「そうだ、\n　",[2],"司馬懿",[1],"はどうした？"]],[103,["「",[2],"司馬懿",[1],"殿は\n　いまだ重い病の床に\n　伏しております\n「やはり、心労が\n　たたったようで\n　ございます"]],[98,["「それでは、\n　誰が",[2],"孔明",[1],"に\n　あたるのだ？\n「",[2],"孔明",[1],"に対抗できる\n　人物はおらぬのか？"]],[100,["「…………"]]],"5:0:0:14864":[[101,["「陛下、\n　お話がございます\n　\n「ただいま、\n　密使が訪れました"]]],"5:0:0:14913":[[98,["「なに？　密使？\n　いったいどこからの\n　密使だ。呉か？"]],[101,["「いえ……\n　少しお耳を\n　拝借いたします"]]],"5:0:0:14988":[[101,["「…………"]],[98,["「………なにっ！\n　そうかっ！　奴は\n　生きていたのか！？"]],[101,["「左様でございます\n　いかが\n　なさいますか？"]],[98,["「よし、\n　すぐに",[3],"成都",[1],"を\n　攻めるならば\n「褒美も爵位も\n　与えると伝えよ"]],[101,["「はっ"]]],"5:0:0:15140":[[98,["「ふっふっふっ…\n　これで",[2],"孔明",[1],"は、\n　\n「",[3],"成都",[1],"に帰らざるを\n　得んだろう"]]],"5:0:11:15201":["昆明"],"5:0:11:15206":["昆明　会議場"],"5:0:0:15219":[[182,["「おう、",[2],"帯来",[1],"\n　どうだったか？"]],[193,["「魏の皇帝より\n　",[3],"成都",[1],"に攻め入るよう\n　命じられました\n「",[3],"成都",[1],"を落とせば\n　恩賞も爵位も思いの\n　ままだそうです"]]],"5:0:0:15336":[[182,["「そうか！\n　",[2],"孔明",[1],"も詰めが甘い\n　\n「わしの存在を忘れて\n　北伐へ行くとはな\n　\n「よし、\n　今度こそ",[2],"孔明",[1],"の\n　鼻を明かしてやる！\n「",[3],"成都",[1],"へ向け\n　出陣じゃ！"]]],"5:0:0:15464":[[182,["「さあ、復讐戦だ！\n　手始めに",[3],"永昌",[1],"を\n　落とせ！"]]],"5:0:8:15508":[[2],"孟獲",[1],"は",[3],"永昌",[1],"を急襲した。",[3],"永昌",[1],"に\r\nも多少の軍勢は配備されていた\r\nが、それは治安維持が目的の\r\n警備部隊であった\r\n　\r\n　\r\n",[3],"永昌",[1],"の太守",[2],"王伉",[1],"も善戦したが\r\n衆寡敵せず。",[3],"永昌",[1],"は数日で落城\r\nした"],"5:0:11:15672":["成都"],"5:0:11:15677":["成都　宮殿"],"5:0:0:15688":[[474,["「へ、陛下ッ！\n　",[3],"南蛮",[1],"の兵が侵攻して\n　参りました！"]],[23,["「なにッ！\n　どういうことだ！？"]],[474,["「はい\n　私は",[3],"永昌",[1],"の\n　守備兵ですが、\n「",[2],"孟獲",[1],"が急に\n　攻めてきたのです\n　\n「",[3],"永昌",[1],"にはわずかな\n　兵士しかおらず\n　\n「数日で落城してしま\n　いました"]]],"5:0:0:15877":[[23,["「むむむ、いかん！　\n　",[3],"永昌",[1],"を落とされては\n　この",[3],"成都",[1],"も危ない！\n「",[2],"董允",[1],"！　誰か、\n　武将に一軍を\n　率いさせて\n「防衛の指揮を\n　とらせるのだ！"]]],"5:0:0:15995":[[35,["「しかし……\n　我が軍のほとんどは\n　",[3],"長安",[1],"におります\n「名のある将は\n　",[3],"成都",[1],"にはおりません"]],[23,["「な、なんだと……\n　では、どうすれば\n　よいと言うのだ！"]],[35,["「そ、それは……\n　\n　\n「とにかく、至急\n　丞相に使者を\n　送りましょう"]],[23,["「そ、そうじゃな\n　それで、当面の防衛\n　指揮はどうする？\n「丞相が戻るまで\n　時間があるだろう"]],[35,["「はぁ……"]]],"5:0:0:16239":[[17,["「陛下\n　私は",[2],"諸葛亮",[1],"の\n　子にて、",[2],"諸葛瞻",[1],"、\n「字を",[2],"思遠ｼｴﾝ",[1],"と\n　申します\n　\n「この度の漢朝の危急\n　を聞き、\n　\n「出陣を志願いたした\n　く参りました"]]],"5:0:0:16369":[[44,["「私は",[2],"趙雲",[1],"の長子にて\n　",[2],"趙統ﾁｮｳﾄｳ",[1],"で\n　ございます\n「我ら兄弟も\n　出陣いたしたく\n　存じます"]]],"5:0:0:16450":[[45,["「",[2],"趙雲",[1],"の次男にて\n　",[2],"趙広ﾁｮｳｺｳ",[1],"と\n　申します\n「陛下、ぜひ我らに\n　",[3],"成都",[1],"の守備を\n　お命じ下さい"]]],"5:0:0:16539":[[23,["「おおっ！\n　丞相と",[2],"趙雲",[1],"の\n　息子たちか！\n「そなたたちであれば\n　安心して任せられる"]]],"5:0:0:16605":[[17,["「はっ\n　それで陛下、\n　\n「私はどの部隊を\n　率いればよろしいで\n　しょうか？"]],[23,["「おお、そうじゃな\n　\n　\n「だが、朕は\n　軍隊のことは詳しく\n　ないのでな……\n「",[3],"成都",[1],"に残っている\n　部隊から\n　\n「そなたの好きな部隊\n　を選ぶがよい"]]]},"sites":[[1874485,0,133],[1874721,-1,149],[1874728,-1,152],[1874735,-1,163],[1874742,-1,160],[1874749,-1,174],[1874756,-1,232],[1874763,-1,177],[1874770,-1,157],[1874777,-1,165],[1874784,-1,231],[1874791,-1,233],[1874798,-1,173],[1874813,0,149],[1874813,1,173],[1874813,2,149],[1874813,3,173],[1874813,4,149],[1874835,-1,98],[1874842,-1,100],[1874849,-1,103],[1874856,-1,94],[1874863,-1,101],[1874870,-1,129],[1874881,-1,128],[1874899,0,128],[1874899,1,98],[1874899,2,128],[1874899,3,98],[1874918,0,101],[1874966,0,100],[1874988,-1,155],[1874995,-1,451],[1875002,-1,450],[1875009,-1,236],[1875016,-1,237],[1875023,-1,238],[1875030,-1,239],[1875049,0,155],[1875057,0,155],[1875060,-1,468],[1875067,-1,466],[1875074,-1,467],[1875140,0,451],[1875148,0,468],[1875151,0,450],[1875151,1,155],[1875199,0,451],[1875199,1,155],[1875207,0,468],[1875292,-1,155],[1875299,-1,468],[1875313,0