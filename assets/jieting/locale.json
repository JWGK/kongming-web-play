ntrol\",\"value\":2},{\"kind\":\"text\",\"text\":\"曹真\"},{\"kind\":\"control\",\"value\":1},{\"kind\":\"text\",\"text\":\"が、\\n　\"},{\"kind\":\"control\",\"value\":3},{\"kind\":\"text\",\"text\":\"街亭\"},{\"kind\":\"control\",\"value\":1},{\"kind\":\"text\",\"text\":\"からは\"},{\"kind\":\"control\",\"value\":2},{\"kind\":\"text\",\"text\":\"張\"},{\"kind\":\"control\",\"value\":1},{\"kind\":\"text\",\"text\":\"が、\"}]":[{"kind":"text","text":"「丞相！郿城的曹真，以及街亭的張郃，"}],"[{\"kind\":\"control\",\"value\":1},{\"kind\":\"text\",\"text\":\"「この\"},{\"kind\":\"control\",\"value\":3},{\"kind\":\"text\",\"text\":\"祁山\"},{\"kind\":\"control\",\"value\":1},{\"kind\":\"text\",\"text\":\"へ\\n　押し寄せて\\n　参りました！\"}]":[{"kind":"text","text":"「都已向這祁山進逼了！"}],"[{\"kind\":\"text\",\"text\":\"「さすがは\"},{\"kind\":\"control\",\"value\":2},{\"kind\":\"text\",\"text\":\"司馬懿\"},{\"kind\":\"control\",\"value\":1},{\"kind\":\"text\",\"text\":\"…\\n　対応が早い\\n　\"}]":[{"kind":"text","text":"「不愧是司馬懿……反應真快。"}],"[{\"kind\":\"control\",\"value\":1},{\"kind\":\"text\",\"text\":\"「全軍に総退却の準備\\n　をさせよ\\n　\"}]":[{"kind":"text","text":"「命全軍準備總撤退。"}],"[{\"kind\":\"control\",\"value\":1},{\"kind\":\"text\",\"text\":\"「我が軍は…\\n　すでに敗北した\\n　\"}]":[{"kind":"text","text":"「我軍……已經敗了。"}],"[{\"kind\":\"control\",\"value\":1},{\"kind\":\"text\",\"text\":\"「あとは被害を最小限\\n　にとどめて退却する\\n　ほかない…\"}]":[{"kind":"text","text":"「如今只能盡量減少損失，撤退了……"}],"[{\"kind\":\"text\",\"text\":\"「はっ！\\n　至急、全軍に申し\\n　伝えます\"}]":[{"kind":"text","text":"「是！末將這就傳令全軍。"}],"[{\"kind\":\"text\",\"text\":\"「\"},{\"kind\":\"control\",\"value\":2},{\"kind\":\"text\",\"text\":\"趙雲\"},{\"kind\":\"control\",\"value\":1},{\"kind\":\"text\",\"text\":\"、そなたは一軍\\n　を率いて\"},{\"kind\":\"control\",\"value\":3},{\"kind\":\"text\",\"text\":\"斜谷道\"},{\"kind\":\"control\",\"value\":1},{\"kind\":\"text\",\"text\":\"から\\n　撤退してくれ\"}]":[{"kind":"text","text":"「趙雲，你率領一支部隊，經斜谷道撤退。"}],"[{\"kind\":\"control\",\"value\":1},{\"kind\":\"text\",\"text\":\"「\"},{\"kind\":\"control\",\"value\":3},{\"kind\":\"text\",\"text\":\"斜谷道\"},{\"kind\":\"control\",\"value\":1},{\"kind\":\"text\",\"text\":\"から\\n　攻められては\\n　\"},{\"kind\":\"control\",\"value\":3},{\"kind\":\"text\",\"text\":\"漢中\"},{\"kind\":\"control\",\"value\":1},{\"kind\":\"text\",\"text\":\"が危ない\"}]":[{"kind":"text","text":"「若敵軍從斜谷道攻來，漢中便危險了。"}],"[{\"kind\":\"control\",\"value\":1},{\"kind\":\"text\",\"text\":\"「ただ、\"},{\"kind\":\"control\",\"value\":3},{\"kind\":\"text\",\"text\":\"斜谷道\"},{\"kind\":\"control\",\"value\":1},{\"kind\":\"text\",\"text\":\"を通れ\\n　ば\"},{\"kind\":\"control\",\"value\":3},{\"kind\":\"text\",\"text\":\"城\"},{\"kind\":\"control\",\"value\":1},{\"kind\":\"text\",\"text\":\"からの追撃が\\n　必ずあるだろう\"}]":[{"kind":"text","text":"「不過，途經斜谷道，必定會遭到郿城敵軍的追擊。"}],"[{\"kind\":\"control\",\"value\":1},{\"kind\":\"text\",\"text\":\"「……充分、\\n　注意して欲しい\"}]":[{"kind":"text","text":"「……你務必要多加小心。"}],"[{\"kind\":\"text\",\"text\":\"「…ははっ\\n　死しても……\\n　\"}]":[{"kind":"text","text":"「……是！縱然戰死也……"}],"[{\"kind\":\"text\",\"text\":\"「いえ、必ず生きて\\n　撤退を成功させて\\n　みせます\"}]":[{"kind":"text","text":"「不，末將一定會活著，讓撤退成功！"}],"[{\"kind\":\"text\",\"text\":\"「\"},{\"kind\":\"control\",\"value\":2},{\"kind\":\"text\",\"text\":\"趙雲\"},{\"kind\":\"control\",\"value\":1},{\"kind\":\"text\",\"text\":\"……すまぬ\\n　頼んだぞ！\"}]":[{"kind":"text","text":"「趙雲……對不住。拜託你了！"}],"[{\"kind\":\"text\",\"text\":\"「よし、\\n　\"},{\"kind\":\"control\",\"value\":3},{\"kind\":\"text\",\"text\":\"街亭\"},{\"kind\":\"control\",\"value\":1},{\"kind\":\"text\",\"text\":\"へ向かうぞ\"}]":[{"kind":"text","text":"「好，我們前往街亭吧。"}],"[{\"kind\":\"text\",\"text\":\"「\"},{\"kind\":\"control\",\"value\":2},{\"kind\":\"text\",\"text\":\"馬謖\"},{\"kind\":\"control\",\"value\":1},{\"kind\":\"text\",\"text\":\"、\"},{\"kind\":\"control\",\"value\":2},{\"kind\":\"text\",\"text\":\"王平\"},{\"kind\":\"control\",\"value\":1},{\"kind\":\"text\",\"text\":\"\\n　よく\"},{\"kind\":\"control\",\"value\":3},{\"kind\":\"text\",\"text\":\"街亭\"},{\"kind\":\"control\",\"value\":1},{\"kind\":\"text\",\"text\":\"を\\n　守備した\"}]":[{"kind":"text","text":"「馬謖、王平，你們把街亭守得很好。"}],"[{\"kind\":\"text\",\"text\":\"「はっ\\n　ありがとう\\n　ございます\"}]":[{"kind":"text","text":"「是，多謝丞相。"}],"[{\"kind\":\"text\",\"text\":\"「だが……\"},{\"kind\":\"control\",\"value\":2},{\"kind\":\"text\",\"text\":\"馬謖\"},{\"kind\":\"control\",\"value\":1},{\"kind\":\"text\",\"text\":\"、\\n　\\n　\"}]":[{"kind":"text","text":"「不過……馬謖，"}],"[{\"kind\":\"control\",\"value\":1},{\"kind\":\"text\",\"text\":\"「そなたが私の指示に\\n　従わなかったために\\n　苦戦したそうだな\"}]":[{"kind":"text","text":"「聽說你沒有遵從我的指示，因此陷入苦戰。"}],"[{\"kind\":\"text\",\"text\":\"「はっ、\\n　面目ございませぬ\"}]":[{"kind":"text","text":"「是，末將慚愧。"}],"[{\"kind\":\"text\",\"text\":\"「今回は\\n　\"},{\"kind\":\"control\",\"value\":3},{\"kind\":\"text\",\"text\":\"街亭\"},{\"kind\":\"control\",\"value\":1},{\"kind\":\"text\",\"text\":\"守備の功を\\n　もって\"}]":[{"kind":"text","text":"「這一次，就以守住街亭的功勞，"}],"[{\"kind\":\"control\",\"value\":1},{\"kind\":\"text\",\"text\":\"「その罪と相殺する\\n　ことにする\\n　\"}]":[{"kind":"text","text":"「抵銷你的罪過。"}],"[{\"kind\":\"control\",\"value\":1},{\"kind\":\"text\",\"text\":\"「だが、今後は\\n　このようなことの\\n　ないよう\"}]":[{"kind":"text","text":"「但今後不可再犯同樣的錯誤。"}],"[{\"kind\":\"control\",\"value\":1},{\"kind\":\"text\",\"text\":\"「心せよ！　よいな\"}]":[{"kind":"text","text":"「務必牢記！明白嗎？"}],"[{\"kind\":\"text\",\"text\":\"「はっ！\"}]":[{"kind":"text","text":"「是！"}],"[{\"kind\":\"text\",\"text\":\"「\"},{\"kind\":\"control\",\"value\":3},{\"kind\":\"text\",\"text\":\"隴西\"},{\"kind\":\"control\",\"value\":1},{\"kind\":\"text\",\"text\":\"の諸郡も\\n　我が漢朝の\\n　領土となり、\"}]":[{"kind":"text","text":"「隴西諸郡也已成為我漢朝的領土，"}],"[{\"kind\":\"control\",\"value\":1},{\"kind\":\"text\",\"text\":\"「\"},{\"kind\":\"control\",\"value\":3},{\"kind\":\"text\",\"text\":\"街亭\"},{\"kind\":\"control\",\"value\":1},{\"kind\":\"text\",\"text\":\"も確保できた\\n　いよいよ\"},{\"kind\":\"control\",\"value\":3},{\"kind\":\"text\",\"text\":\"長安\"},{\"kind\":\"control\",\"value\":1},{\"kind\":\"text\",\"text\":\"を\\n　目指す時が来たな\"}]":[{"kind":"text","text":"「街亭亦已確保。終於到了進軍長安的時候。"}],"[{\"kind\":\"control\",\"value\":1},{\"kind\":\"text\",\"text\":\"「当面の目標は\\n　\"},{\"kind\":\"control\",\"value\":3},{\"kind\":\"text\",\"text\":\"陳倉\"},{\"kind\":\"control\",\"value\":1},{\"kind\":\"text\",\"text\":\"の攻略だ\"}]":[{"kind":"text","text":"「眼前的目標，是攻下陳倉。"}],"[{\"kind\":\"text\",\"text\":\"「では、丞相\\n　直ちに出陣\\n　なさいますか？\"}]":[{"kind":"text","text":"「那麼，丞相，要立刻出陣嗎？"}],"[{\"kind\":\"text\",\"text\":\"「いや。我が軍の兵糧\\n　も長い滞陣で心許な\\n　くなっているし、\"}]":[{"kind":"text","text":"「不。我軍久駐在外，兵糧也已不太充裕，"}],"[{\"kind\":\"text\",\"text\":\"「\"},{\"kind\":\"control\",\"value\":2},{\"kind\":\"text\",\"text\":\"司馬懿\"},{\"kind\":\"control\",\"value\":1},{\"kind\":\"text\",\"text\":\"の動きも気に\\n　なる…。魏軍の様子\\n　をうかがいながら、\"}]":[{"kind":"text","text":"「司馬懿的動向亦令人在意……我們先觀察魏軍的情況，"}],"[{\"kind\":\"control\",\"value\":1},{\"kind\":\"text\",\"text\":\"「\"},{\"kind\":\"control\",\"value\":3},{\"kind\":\"text\",\"text\":\"漢中\"},{\"kind\":\"control\",\"value\":1},{\"kind\":\"text\",\"text\":\"からの兵糧補充\\n　を待つことにする\\n　\"}]":[{"kind":"text","text":"「同時等候漢中補充兵糧。"}],"[{\"kind\":\"control\",\"value\":1},{\"kind\":\"text\",\"text\":\"「皆も連戦で疲れたこ\\n　とだろう。兵糧を待\\n　つ間、つかの間だが\"}]":[{"kind":"text","text":"「大家連番作戰，想必都累了。等候兵糧期間，雖然時日不長，"}],"[{\"kind\":\"control\",\"value\":1},{\"kind\":\"text\",\"text\":\"「ゆっくり休養を取る\\n　ように\"}]":[{"kind":"text","text":"「還是好好休養吧。"}],"[{\"kind\":\"text\",\"text\":\"街亭　魏軍幕舎\"}]":[{"kind":"text","text":"街亭　魏軍營帳"}],"[{\"kind\":\"text\",\"text\":\"祁山　蜀軍幕舎\"}]":[{"kind":"text","text":"祁山　蜀軍營帳"}],"[{\"kind\":\"text\",\"text\":\"街亭　蜀軍幕舎\"}]":[{"kind":"text","text":"街亭　蜀軍營帳"}],"[{\"kind\":\"text\",\"text\":\"四章一幕　陳倉攻防戦\"}]":[{"kind":"text","text":"第四章・第一幕　陳倉攻防戰"}],"[{\"kind\":\"text\",\"text\":\"第四章　北伐・後編\"}]":[{"kind":"text","text":"第四章　北伐・後篇"}],"[{\"kind\":\"text\",\"text\":\"第一幕　陳倉攻防戦\"}]":[{"kind":"text","text":"第一幕　陳倉攻防戰"}],"[{\"kind\":\"text\",\"text\":\"魏の都　洛陽\"}]":[{"kind":"text","text":"魏都　洛陽"}],"[{\"kind\":\"text\",\"text\":\"三章二幕　街亭の戦い\"}]":[{"kind":"text","text":"第三章・