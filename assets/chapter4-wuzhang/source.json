城",[1],"\r\nに入り軍勢を再編成していた"],"4:3:11:18289":["五丈原"],"4:3:11:18296":["五丈原　蜀軍幕舎"],"4:3:0:18313":[[4,["「",[3],"五丈原",[1],"に\n　進出できたことで\n　\n「",[3],"長安",[1],"までの距離が\n　ぐっと近く\n　なりました"]],[10,["「うむ\n　やっと",[3],"長安",[1],"が手に届\n　く位置まで来たな"]],[11,["「",[3],"長安",[1],"を奪うことがで\n　きれば\n　\n「あとは首都の\n　",[3],"洛陽",[1],"まで\n　すぐでしょう"]],[0,["「うむ"]]],"4:3:0:18494":[[7,["「丞相\n　度重なる激戦で将兵\n　に疲れが見えます\n「一度、\n　酒宴を開いては\n　いかがでしょうか？"]],[0,["「いや、\n　まだ魏軍は……\n　",[2],"司馬懿",[1],"は健在だ\n「彼を倒さぬ限り、\n　まだまだ\n　油断はできぬ\n「酒宴を開ける\n　段階ではない"]],[7,["「そうですか"]],[0,["「とはいえ、将兵が\n　疲れているとは\n　聞き捨てできぬな\n「充分な休息を\n　とらせるように\n　\n「私も、少し疲れた\n　悪いが先に休ませて\n　もらう"]]],"4:3:0:18775":[[0,["「うっ……"]]],"4:3:0:18788":[[4,["「丞相！"]]],"4:3:0:18800":[[10,["「丞相！どうなさいま\n　した！？"]]],"4:3:0:18825":[[11,["「いかん、丞相がまた\n　お倒れになった！\n　\n「医者だ！\n　医者を呼べ！"]]],"4:3:11:18879":["城"],"4:3:11:18884":["城近郊　渭水河岸"],"4:3:0:18903":[[96,["「うむむ……\n　蜀軍を倒す秘策は\n　ないものか……"]]],"4:3:0:18945":[[96,["「",[2],"孔明",[1],"さえいなければ\n　蜀軍など簡単につぶ\n　せるものを……"]]],"4:3:0:18995":[[96,["「む？　\n　あれは……\n　",[2],"孔明",[1],"の将星だ\n「いやに輝きが\n　小さいな\n　もしや……？\n「",[2],"孔明",[1],"の寿命が\n　尽きようとしている\n　のか！？\n「ええぃ、こうしては\n　おられぬ"]]],"4:3:11:19118":["城　陣地"],"4:3:0:19129":[[110,["「おお、父上\n　大変な情報が\n　入りました"]],[96,["「大変な情報？\n　",[2],"孔明",[1],"が倒れたとでも\n　いうのか？"]],[110,["「そ、その通りです！\n　なにゆえ、\n　そのことを？"]],[96,["「今しがた、\n　空を眺めていたら\n　\n「",[2],"孔明",[1],"の将星の輝きが\n　小さくなっていた\n　\n「それで\n　わかったのだ"]],[109,["「それでしたら\n　話は早い\n　\n「父上、さっそく出陣\n　いたしましょう"]],[96,["「いや……\n　待て、待て"]],[110,["「どうしてで\n　ございますか？\n　\n「",[2],"孔明",[1],"が倒れたならば\n　蜀軍など……"]],[96,["「これは……。我が軍\n　を誘い出す、",[2],"孔明",[1],"の\n　計略かもしれぬ"]],[109,["「しかし、\n　いかに",[2],"孔明",[1],"とて\n　\n「将星の輝きまで\n　操ることはできない\n　でしょう"]],[96,["「いやいや、待つのだ\n　\n　\n「",[2],"孔明",[1],"という男、\n　何をしてくるか\n　わからぬ\n「よいな、\n　まだ出陣は\n　見送るのだ"]]],"4:3:0:19636":[[110,["「……ははっ"]]],"4:3:11:19650":["五丈原　蜀軍幕舎"],"4:3:0:19667":[[6,["「丞相が倒れた今、\n　どうすれば\n　よいかのう"]]],"4:3:0:19702":[[7,["「丞相が\n　お倒れになった\n　とはいえ\n「すでに我らは\n　",[3],"五丈原",[1],"まで\n　進んでいるのだ\n「ここは退くべきでは\n　ないだろう\n　\n「",[3],"長安",[1],"を目指して\n　進軍してこそ\n　\n「丞相の意志を継ぐも\n　のではないか"]]],"4:3:0:19850":[[4,["「いや、\n　そうではない\n　\n「丞相がおられたから\n　こそ、\n　\n「",[3],"五丈原",[1],"まで\n　駒を進めることが\n　できたのです\n「丞相がいない\n　今となっては\n　\n「これ以上\n　進軍するのは\n　不可能でしょう"]]],"4:3:0:19989":[[10,["「それに、敵には\n　",[2],"司馬懿",[1],"が健在だ\n　\n「",[2],"司馬懿",[1],"と戦えるのは\n　丞相ただ一人だろう"]],[7,["「ふん\n　",[2],"司馬懿",[1],"ごとき、\n　わし一人で十分だ\n「臆病者はとっとと\n　蜀へ帰るがいい"]]],"4:3:0:20127":[[10,["「なんだと、",[2],"魏延",[1],"！\n　貴様、この私を\n　侮辱する気か！"]]],"4:3:0:20174":[[0,["「両者とも、\n　争いをやめよ\n　私は大丈夫だ"]]],"4:3:0:20211":[[6,["「おお、丞相！"]]],"4:3:0:20226":[[4,["「丞相！\n　そのお体では……"]],[0,["「気遣いは無用だ\n　軍議を続けるぞ"]],[7,["「は、ははっ"]]],"4:3:0:20291":[[4,["「丞相\n　そのお体では、\n　\n「これ以上の進軍は\n　難しいかと\n　思われます\n「ここはいったん、\n　",[3],"漢中",[1],"へ帰還\n　なさっては"]],[0,["「いや、\n　せっかく",[3],"五丈原",[1],"まで\n　進出したのだ\n「",[2],"魏延",[1],"の申す通り、\n　進撃した方がよい\n　\n「今退却しては、魏に\n　再生の機会を与えて\n　しまうことになる"]],[10,["「しかし……"]],[0,["「北伐が成功せぬ限り\n　",[3],"漢中",[1],"へは戻らぬ\n　\n「たとえ、この身が\n　どうなろうとも\n　\n「北伐は、私一人の\n　問題ではないのだ\n　\n「先帝の……\n　ご遺志なのだ"]]],"4:3:0:20633":[[6,["「先帝の……"]]],"4:3:0:20649":[[0,["「さて、\n　進軍するにしても\n　\n「現在",[3],"城",[1],"にいる\n　",[2],"司馬懿",[1],"を倒さねば\n　ならぬ\n「こちらから\n　",[3],"城",[1],"に攻め込んでも\n　利はない\n「そこで、",[2],"司馬懿",[1],"を\n　",[3],"五丈原",[1],"に誘い出す"]],[7,["「しかし、",[2],"司馬懿",[1],"は\n　用心深い奴です\n　\n「どうやって\n　誘い出しましょう？"]],[0,["「簡単なことだ。私が\n　この",[2],"諸葛亮",[1],"が死んだ\n　ことにするのだ"]],[11,["「な、なんと……\n　それはまた、\n　不吉な"]],[0,["「私が死んだと知れば\n　",[2],"司馬懿",[1],"は油断する\n　\n「おそらく、一斉に追\n　撃をかけてくるはず\n　その時が勝負だ\n「",[2],"蒋",[1],"、\n　喪旗を立てよ\n　\n「私が死んだことに\n　して",[3],"漢中",[1],"への退却を\n　装うのだ"]],[15,["「ははっ"]]],"4:3:11:21086":["城近郊　渭水河岸"],"4:3:0:21105":[[96,["「あ、あれはッ！\n　\n　\n「",[2],"孔明",[1],"の将星が……\n　落ちたッ！",[2],"孔明",[1],"は\n　死んだのか！？"]]],"4:3:0:21177":[[96,["「しかし……\n　あの",[2],"孔明",[1],"のことだ\n　死を装って、\n「この",[2],"司馬懿",[1],"を誘き出\n　そうとしているのか\n　もしれぬ\n「よく考えねば\n　ならぬ……\n　\n「本当に死んでいるな\n　らば、絶好の追撃の\n　機会だが……"]]],"4:3:11:21326":["城　魏軍幕舎"],"4:3:0:21341":[[124,["「総大将、蜀軍に\n　異変が起きました\n　\n「何と退却し始めたの\n　です。これはどうい\n　うことでしょう？"]]],"4:3:0:21416":[[96,["「まことかッ！\n　\n　\n「では、",[2],"孔明",[1],"の将星が\n　落ちたのは偽りでは\n　なかったのかッ！"]]],"4:3:0:21482":[[109,["「父上！\n　",[2],"孔明",[1],"の将星が\n　落ちたですって！？"]],[96,["「おおッ！　\n　それこそがすなわち\n　",[2],"孔明",[1],"の命の灯火\n「",[2],"孔明",[1],"の死を、天が\n　教えてくれたのだ"]],[91,["「では、\n　",[2],"孔明",[1],"が死んだので\n　蜀軍は退却している\n「ということ\n　ですか！？"]],[96,["「その通りだ！\n　この機会を逃しては\n　ならぬ"]]],"4:3:0:21689":[[96,["「全軍、直ちに\n　蜀軍を追えッ！\n　\n「",[2],"孔明",[1],"のいない蜀軍\n　など、もはや蟻の\n　群れに等しいわ！"]]],"4:3:0:21766":[[124,["「はっ！"]]],"4:3:0:21776":[[96,["「はっはっはっ、\n　進め進め！\n　\n「",[2],"孔明",[1],"のいない\n　蜀軍など\n　敵ではないわ！"]]],"4:3:11:23451":["五丈原　幕舎"],"4:3:0:23464":[[0,["「",[2],"姜維",[1],"よ、\n　どうやら私は……\n　もう長くない"]],[4,["「そんな、丞相！"]],[0,["「いや、天命には\n　逆らえぬ\n　\n「よいか、今から私が\n　話すことを心して\n　聞いておくのだ"]],[4,["「……は、はい"]],[0,["「私の死後、\n　兵をまとめ\n　",[3],"漢中",[1],"に退却せよ\n「そなたが\n　軍の指揮をとれ\n　\n「我が軍が\n　退却したと知れば、\n　\n「",[2],"司馬懿",[1],"は必ず追撃し\n　てくるだろう\n　\n「そのときは\n　私の木像を\n　押し出すのだ"]],[4,["「木像……\n　でございますか？"]],[0,["「うむ、こういう日が\n　いずれ来るだろうと\n　\n「あらかじめ\n　作らせておいた物が\n　あるのだ"]],[4,["「では……\n　丞相はそこまで\n　ご自身の寿命を…"]],[0,["「自分の体だ\n　自分が一番知って\n　おる"]],[4,["「…………"]],[0,["「その木像を\n　押し出せば、\n　\n「",[2],"司馬懿",[1],"は\n　私が生きていると\n　勘違いするだろう\n「そして、私の計略に\n　かかったと思って\n　\n「肝をつぶして\n　逃げるであろう\n　\n「よいな、\n　必ず実行するのだ\n　\n「そうすれば、\n　全軍無事に",[3],"漢中",[1],"まで\n　戻ることができよう"]],[4,["「は、はい……\n　必ず実行いたします"]],[0,["「では、諸将を\n　陣に集めてくれ"]]],"4:3:0:24160":[[4,["「は、はい……"]]],"4:3:11:24175":["五丈原　陣地"],"4:3:0:24188":[[0,["「皆、\n　集まったようだな"]]],"4:3:0:24210":[[0,["「見よ、\n　あれが私の将星だ"]]],"4:3:0:24235":[[0,["「あれが落ちたとき、\n　私は死ぬ\n　\n「よく見ておくのだ\n　まもなく……\n　落ちる"]]],"4:3:0:24294":[[4,["「あっ！\n　将星が……！"]]],"4:3:0:24317":[[0,["（",[2],"劉備",[1],"様、漢朝再興を\n　成し遂げること\n　かなわず……\n（申し訳ございませぬ\n　\n　\n（今、\n　お側に参ります……"]]],"4:3:0:24409":[[8,["「丞相っ！"]]],"4:3:0:24422":[[4,["「丞相、\n　目をお開き下さい！\n　丞相ッ！"]],[18,["「…………"]]],"4:3:0:24472":[[4,["「なぜ……\n　なぜ天は、\n　\n「丞相にあと少しの\n　命をお与えにならな\n　かったのか！"]]],"4:3:0:24534":[[10,["「丞相……\n　さぞ、お悔しい\n　だろう……"]]],"4:3:0:24570":[[4,["「では、丞相の\n　ご遺言通り……\n　\n「…………\n　\n　\n「全軍を",[3],"漢中",[1],"に\n　退却させましょう"]]],"4:3:0:24650":[[5,["「丞相……"]]],"4:3:11:24665":["城近郊　渭水河岸"],"4:3:0:24684":[[96,["「あ、あれはッ！\n　",[2],"孔明",[1],"の将星が……\n　落ちたッ！\n「",[2],"孔明",[1],"は\n　死んだのか！？"]]],"4:3:0:24753":[[96,["「しかし……\n　あの",[2],"孔明",[1],"のことだ\n　死を装って、\n「この",[2],"司馬懿",[1],"を\n　誘き出そうとして\n　いるのかもしれぬ\n「よく考えねば\n　ならぬ……\n　\n「本当に死んでいる\n　ならば、絶好の\n　追撃の機会だが…"]]],"4:3:11:24900":["城　魏軍幕舎"],"4:3:0:24915":[[124,["「総大将、\n　蜀軍に異変が\n　起きました\n「何と退却し始めたの\n　です。これはどうい\n　うことでしょう？"]]],"4:3:0:24990":[[96,["「まことかッ！？\n　\n　\n「では、",[2],"孔明",[1],"の将星が\n　落ちたのは偽りでは\n　なかったのかッ！"]]],"4:3:0:25057":[[109,["「父上！\n　",[2],"孔明",[1],"の将星が\n　落ちたですって！？"]],[96,["「おおッ！\n　それこそがすなわち\n　",[2],"孔明",[1],"の命の灯火\n「",[2],"孔明",[1],"の死を天が\n　教えてくれたのだ"]],[91,["「では、",[2],"孔明",[1],"が死んだ\n　ので蜀軍は退却して\n　いる\n「ということ\n　ですか！？"]],[96,["「その通りだ！\n　この機会を逃しては\n　ならぬ"]]],"4:3:0:25261":[[96,["「全軍、直ちに\n　蜀軍を追えッ！\n　\n「",[2],"孔明",[1],"のいない\n　蜀軍など、\n　\n「もはや蟻の群れも\n　同然じゃ！"]]],"4:3:0:25345":[[124,["「はっ！"]]],"4:3:0:25355":[[96,["「はっはっはっ、\n　進め進め！\n　\n「",[2],"孔明",[1],"のいない\n　蜀軍など\n　敵ではないわ！"]]],"4:3:0:21838":[[96,["「蜀軍が撤退する理由\n　はただ一つッ！",[2],"孔明",[1],"\n　が死亡したからだ！\n「",[2],"孔明",[1],"亡き蜀軍など\n　恐れるに足らず！\n　\n「直ちに全軍\n　追撃せよッ！"]],[124,["「総司令、\n　\n　\n「いまだ",[2],"孔明",[1],"の死亡が\n　確認されたわけでは\n　ありませぬ\n「少しご自重を……"]],[96,["「何を言うかっ！\n　\n　\n「これが千載一遇の\n　好機だというのが\n　わからぬかッ！"]],[232,["「",[2],"姜将軍",[1],"、",[2],"司馬懿",[1],"が\n　出陣いたしました\n　\n「魏全軍による\n　追撃です"]],[4,["「よし、いったん\n　陣内に戻るぞ\n　\n「さあ、",[2],"司馬懿",[1],"よ\n　追いかけてこい\n　\n「…丞相の秘策、\n　思い知れ！"]]],"4:3:48:22235":["一、",[2],"司馬懿",[1],"の撃破"],"4:3:0:22254":[[96,["「進め、進めー！\n　蜀軍を叩きつぶす\n　のだ！"]],[4,["「どうした、\n　",[2],"司馬懿",[1],"……\n　早く追ってこい"]]],"4:3:0:22330":[[109,["「父上、\n　蜀軍の動きが\n　不自然です\n「いったん追撃を\n　中止されては"]],[96,["「何を寝言を\n　言っておる\n　\n「あと少しで、蜀軍を\n　壊滅できるのが\n　わからぬか！？"]]],"4:3:0:22450":[[110,["「ち、父上ッ！\n　あれはもしや…！？"]],[96,["「うん……？\n　…………\n　！！！\n「な、な、なにッ！\n　そ……そんな\n　馬鹿な……！"]]],"4:3:0:22544":[[109,["「父上、\n　これ以上の追撃は\n　危険です\n「そろそろ\n　お引き上げに\n　なっては"]],[96,["「うむ……\n　ん？　",[2],"昭",[1],"よ、\n　どうかしたのか？"]],[110,["「ち、父上……！\n　あ、あの、\n　あの人影は……！"]]],"4:3:0:22681":[[0,["「はっはっはっ\n　……かかったな、\n　",[2],"司馬懿",[1]]],[96,["「まさか……！？\n　そ、そんな\n　はずは……"]],[0,["「……こうでも\n　しない限り\n　\n「貴様は陣から\n　出てこぬからな"]],[4,["「",[2],"司馬懿",[1],"は丞相の計に\n　かかったぞ！\n　それっ、反撃だ！"]],[96,["「死を装い、我が軍を\n　誘い出すとは……\n　\n「何という男だ……\n　",[2],"孔明",[1],"\n　\n「退けっ！　",[3],"城",[1],"まで\n　引き上げるぞっ！"]]],"4:3:11:22944":["金１５００を手に入れた！"],"4:3:0:22964":[[4,["「どうした、",[2],"司馬懿",[1],"！\n　\n　\n「魏軍の\n　大将ともあろう男が\n　逃げ出すとは！\n「そんなに丞相が\n　恐ろしいのかッ！？"]],[96,["「ええぃ、\n　うるさいっ！"]]],"4:3:0:23072":[[4,["「……逃げたか"]]],"4:3:11:23088":["姜維はレベルが上がった！"],"4:3:0:23107":[[96,["「な、何という\n　ことだ！\n　\n「奴が、奴が……\n　生きて\n　いたなど……"]]],"4:3:0:23163":[[96,["「はぁ、はぁ…\n　私の首は……\n　\n「ついているようだな\n　……逃げ切れたか\n　\n「何ということだ…\n　奴が生きて\n　いたとは……"]]],"4:3:0:23257":[[96,["「全軍、",[3],"城",[1],"まで\n　退却じゃ！\n　\n「",[2],"孔明",[1],"の罠に\n　かかるな！"]]],"4:3:11:23315":["金１５００を手に入れた！"],"4:3:11:23335":["金７５０を手に入れた！"],"4:3:11:23353":["金７５０を手に入れた！"],"4:3:11:23371":["金５００を手に入れた！"],"4:3:0:25417":[[96,["「蜀軍が撤退する理由\n　はただ一つっ！",[2],"孔明",[1],"\n　が死亡したからだ！\n「",[2],"孔明",[1],"のいない\n　蜀軍など烏合の衆に\n　すぎない！\n「直ちに全軍\n　追撃せよッ！"]],[110,["「父上、\n　蜀軍が撤退している\n　とはいえ、\n「追撃の備えが無いは\n　ずがありませぬ\n　\n「少しご自重\n　なさっては"]],[96,["「",[2],"孔明",[1],"亡き今、\n　\n　\n「そんなことにまで\n　気がつく将など\n　蜀にはおらぬわ\n「心配せずに、\n　追撃するのだ！"]],[232,["「",[2],"姜将軍",[1],"、",[2],"司馬懿",[1],"が\n　出陣いたしました"]],[4,["「よし、いったん\n　陣内に戻る\n　\n「さあ",[2],"司馬懿",[1],"よ、\n　追いかけてこい\n　\n「丞相の最後の\n　秘策……。絶対に\n　成功させてみせる！"]]],"4:3:48:25840":["一、",[2],"司馬懿",[1],"の撃破"],"4:3:0:25859":[[96,["「",[2],"孔明",[1],"のおらぬ\n　蜀軍など\n　恐れるにたりん！\n「さあ、進め進めー！\n　蜀軍を徹底的に\n　叩きつぶせッ！"]],[4,["「",[2],"司馬懿",[1],"……\n　…早く追ってこい"]]],"4:3:0:25974":[[124,["「総司令、\n　蜀軍の動きが\n　不自然です\n「追撃を中止して\n　様子を見た方が\n　よろしいのでは…"]],[96,["「兵法を\n　知らぬ奴めッ\n　\n「あと少しで、蜀軍を\n　壊滅できるのがわか\n　らぬか！？"]],[124,["「…………"]]],"4:3:0:26126":[[109,["「父上！\n　あの山上に\n　人影が……\n「あれは\n　もしや……！？"]],[96,["「人影だと……？\n　な、な、なにッ！\n　\n「そ……\n　そんな馬鹿な……！"]]],"4:3:0:26233":[[110,["「父上、兵法に\n　\n　\n「『帰る兵を深追いし\n　て傷を負うなかれ』\n　とあります\n「追撃は充分です\n　どうか\n　お引き上げを"]],[96,["「うむ……\n　ん？　",[2],"昭",[1],"よ、\n　どうかしたのか？"]],[110,["「父上……！　あの、\n　山上の人影は……！"]]],"4:3:0:26401":[[0,["「…………"]],[96,["「まさか……！？\n　そ、そんな\n　はずは……"]],[4,["「",[2],"司馬懿",[1],"よ！\n　丞相の計に\n　かかったな！\n「貴様の動きなど、\n　丞相はすでに\n　お見通しだ\n「それっ、反撃だ！"]],[96,["「死を装い、\n　我が軍を誘い出す\n　とは……\n「何という男だ……\n　",[2],"孔明",[1],"\n　\n「退けっ！　",[3],"城",[1],"まで\n　引き上げるぞっ！"]]],"4:3:0:26631":[[4,["「どうした、",[2],"司馬懿",[1],"